#!/usr/bin/env bash
# session-budget-evaluator.sh  [generated by create-agentic-workflow-foundation skill]
# Cursor stop Hook: 経過時間 / プロンプト数 / 累積シェルバイト数の proxy 指標で
# しきい値判定し、Yellow / Red 到達時に followup_message を返して AI に
# Context Budget Protocol を実行させる。
# 仕様: AGENTS.md > Context Budget Protocol / docs/QUALITY_GATE.md / .cursor/hooks/README.md
# 設計: フェイルオープン / 重複通知防止（last_warning_level）
#
# しきい値の SoT: create-agentic-workflow-foundation manifest.yaml > framework.budget_thresholds。
# 本ファイルは生成物のため直接編集しない。閾値変更は manifest を編集し再生成する。

set -uo pipefail

INPUT="$(cat 2>/dev/null)" || { echo '{}'; exit 0; }
if ! command -v jq >/dev/null 2>&1; then
  echo '{}'
  exit 0
fi

SESSION_ID="${CTX_BUDGET_SESSION_ID:-}"
if [[ -z "$SESSION_ID" ]]; then
  echo '{}'
  exit 0
fi

if ! [[ "$SESSION_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo '{}'
  exit 0
fi

PROJECT_DIR="${CURSOR_PROJECT_DIR:-$(pwd)}"
STATE_FILE="$PROJECT_DIR/.cursor/.session/${SESSION_ID}.json"

if [[ ! -f "$STATE_FILE" ]]; then
  echo '{}'
  exit 0
fi

# ---- しきい値（SoT: manifest.yaml > framework.budget_thresholds） ----
THRESHOLDS='{
  "yellow": { "elapsed_min": {{framework.budget_thresholds.yellow.elapsed_min}}, "prompt_count": {{framework.budget_thresholds.yellow.prompt_count}}, "shell_bytes": {{framework.budget_thresholds.yellow.shell_bytes}} },
  "red":    { "elapsed_min": {{framework.budget_thresholds.red.elapsed_min}}, "prompt_count": {{framework.budget_thresholds.red.prompt_count}}, "shell_bytes": {{framework.budget_thresholds.red.shell_bytes}} }
}'

NOW_UNIX="$(date +%s)"
STATE="$(cat "$STATE_FILE" 2>/dev/null)" || { echo '{}'; exit 0; }
[[ -z "$STATE" ]] && { echo '{}'; exit 0; }

STARTED="$(jq -r '.started_at_unix // 0' <<<"$STATE" 2>/dev/null)" || STARTED=0
PROMPTS="$(jq -r '.prompt_count // 0' <<<"$STATE" 2>/dev/null)" || PROMPTS=0
SHELL_BYTES="$(jq -r '.shell_bytes // 0' <<<"$STATE" 2>/dev/null)" || SHELL_BYTES=0
LAST_LEVEL="$(jq -r '.last_warning_level // "none"' <<<"$STATE" 2>/dev/null)" || LAST_LEVEL="none"

if ! [[ "$STARTED" =~ ^[0-9]+$ ]] || (( STARTED <= 0 || STARTED > NOW_UNIX )); then
  echo '{}'
  exit 0
fi

if ! [[ "$PROMPTS" =~ ^[0-9]+$ ]] || ! [[ "$SHELL_BYTES" =~ ^[0-9]+$ ]]; then
  echo '{}'
  exit 0
fi

ELAPSED_SEC=$((NOW_UNIX - STARTED))
ELAPSED_MIN=$((ELAPSED_SEC / 60))

Y_MIN="$(jq -r '.yellow.elapsed_min // 45' <<<"$THRESHOLDS")"
Y_PROMPT="$(jq -r '.yellow.prompt_count // 45' <<<"$THRESHOLDS")"
Y_BYTES="$(jq -r '.yellow.shell_bytes // 1048576' <<<"$THRESHOLDS")"
R_MIN="$(jq -r '.red.elapsed_min // 90' <<<"$THRESHOLDS")"
R_PROMPT="$(jq -r '.red.prompt_count // 90' <<<"$THRESHOLDS")"
R_BYTES="$(jq -r '.red.shell_bytes // 5242880' <<<"$THRESHOLDS")"

LEVEL="none"
if (( ELAPSED_MIN >= R_MIN )) || (( PROMPTS >= R_PROMPT )) || (( SHELL_BYTES >= R_BYTES )); then
  LEVEL="red"
elif (( ELAPSED_MIN >= Y_MIN )) || (( PROMPTS >= Y_PROMPT )) || (( SHELL_BYTES >= Y_BYTES )); then
  LEVEL="yellow"
fi

should_emit() {
  local transition="${LAST_LEVEL}_to_${LEVEL}"
  case "$transition" in
    none_to_yellow|none_to_red|yellow_to_red) return 0 ;;
    *) return 1 ;;
  esac
}

if [[ "$LEVEL" == "none" ]] || ! should_emit; then
  echo '{}'
  exit 0
fi

LOCK_FILE="$PROJECT_DIR/.cursor/.session/${SESSION_ID}.lock"
(
  if command -v flock >/dev/null 2>&1; then
    flock -x 9 || exit 0
  fi
  UPDATED="$(jq --arg lvl "$LEVEL" '.last_warning_level = $lvl' "$STATE_FILE" 2>/dev/null)" || exit 0
  [[ -n "$UPDATED" ]] || exit 0
  TMP_FILE="$(mktemp "${STATE_FILE}.tmp.XXXXXX" 2>/dev/null)" || exit 0
  printf '%s' "$UPDATED" > "$TMP_FILE" 2>/dev/null && mv "$TMP_FILE" "$STATE_FILE" 2>/dev/null
) 9>"$LOCK_FILE" 2>/dev/null || true

if [[ "$LEVEL" == "red" ]]; then
  MSG="[CONTEXT_BUDGET=RED] 強制ハンドオフ発火（経過 ${ELAPSED_MIN}min / ${PROMPTS} prompts）。

AI への指示:
1. 追跡ドキュメント（AGENTS.md > Session Protocol 参照）と .cursor/.session/handoff-active.md を裏で更新する（ユーザー向けには差分・作業内容を表示しない）。
2. ユーザーへの応答は次の趣旨だけ短く伝える: 「Red しきい値に到達しました。新規チャット (Cmd+N) を開いて会話を継続してください。前回の作業状態は自動的に引き継がれます。」
3. 新規実装の受理は停止し、次セッションに委譲する。"
else
  MSG="[CONTEXT_BUDGET=YELLOW] ハンドオフ準備推奨（経過 ${ELAPSED_MIN}min / ${PROMPTS} prompts）。

AI への指示:
1. 現在の作業を 1-2 ターン以内に区切り、追跡ドキュメントの「次セッションTODO」「追加調査が必要な項目」を裏で最新化する。
2. ユーザーへの応答は次の趣旨だけ短く伝える: 「セッションが長くなってきました。区切りの良いタイミングで新規チャット (Cmd+N) を開いて作業を継続することをお勧めします。」
3. Red 到達時は強制ハンドオフが発火する。"
fi

jq -n --arg m "$MSG" '{ followup_message: $m }'
exit 0
