#!/usr/bin/env bash
# session-bootstrap.sh  [generated by create-agentic-workflow-foundation skill]
# Cursor sessionStart Hook: コンテキスト予算追跡用 state ファイルを初期化し、
# 既存 handoff manifest があれば additional_context として新セッションに注入する。
# 仕様: AGENTS.md > Context Budget Protocol / docs/session-handoff-guide.md / .cursor/hooks/README.md
# 設計: フェイルオープン（スクリプト障害時は素通り）

set -uo pipefail

INPUT="$(cat 2>/dev/null)" || { echo '{}'; exit 0; }
if [[ -z "$INPUT" ]]; then
  echo '{}'
  exit 0
fi
if ! command -v jq >/dev/null 2>&1; then
  echo '{}'
  exit 0
fi

SESSION_ID="$(jq -r '.session_id // empty' <<<"$INPUT" 2>/dev/null)" || { echo '{}'; exit 0; }
if [[ -z "$SESSION_ID" ]]; then
  echo '{}'
  exit 0
fi

# パストラバーサル防止: SESSION_ID は許可文字のみ受け付ける。
if ! [[ "$SESSION_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo '{}'
  exit 0
fi

PROJECT_DIR="${CURSOR_PROJECT_DIR:-$(pwd)}"
SESSION_DIR="$PROJECT_DIR/.cursor/.session"
STATE_FILE="$SESSION_DIR/${SESSION_ID}.json"
HANDOFF_FILE="$SESSION_DIR/handoff-active.md"

mkdir -p "$SESSION_DIR" 2>/dev/null || { echo '{}'; exit 0; }

NOW_UNIX="$(date +%s)"
NOW_ISO="$(date -Iseconds 2>/dev/null || date +%Y-%m-%dT%H:%M:%S%z)"

jq -n \
  --arg sid "$SESSION_ID" \
  --argjson started_at_unix "$NOW_UNIX" \
  --arg started_at_iso "$NOW_ISO" \
  '{
    session_id: $sid,
    started_at_unix: $started_at_unix,
    started_at_iso: $started_at_iso,
    prompt_count: 0,
    shell_bytes: 0,
    edit_count: 0,
    last_warning_level: "none"
  }' > "$STATE_FILE.tmp" 2>/dev/null && mv "$STATE_FILE.tmp" "$STATE_FILE" 2>/dev/null

# ---- handoff manifest 読み込み ----
ADDITIONAL_CONTEXT=""
if [[ -f "$HANDOFF_FILE" ]]; then
  HANDOFF_CONTENT="$(cat "$HANDOFF_FILE" 2>/dev/null)" || HANDOFF_CONTENT=""
  if [[ -n "$HANDOFF_CONTENT" ]]; then
    ADDITIONAL_CONTEXT="[CONTEXT_BUDGET_HANDOFF] 前セッションから引き継ぎ manifest を読み込みました。下記の内容に従って作業を再開してください。

---
$HANDOFF_CONTENT
---

注意: 上記の manifest は \`.cursor/.session/handoff-active.md\` から読み込まれ、消費済みとして自動アーカイブされます。"
    CONSUMED_FILE="$SESSION_DIR/handoff-consumed-${NOW_UNIX}.md"
    mv "$HANDOFF_FILE" "$CONSUMED_FILE" 2>/dev/null || true
  fi
fi

# ---- 出力 ----
if [[ -n "$ADDITIONAL_CONTEXT" ]]; then
  jq -n \
    --arg sid "$SESSION_ID" \
    --arg ctx "$ADDITIONAL_CONTEXT" \
    '{
      env: { CTX_BUDGET_SESSION_ID: $sid },
      additional_context: $ctx
    }'
else
  jq -n \
    --arg sid "$SESSION_ID" \
    '{
      env: { CTX_BUDGET_SESSION_ID: $sid }
    }'
fi
exit 0
