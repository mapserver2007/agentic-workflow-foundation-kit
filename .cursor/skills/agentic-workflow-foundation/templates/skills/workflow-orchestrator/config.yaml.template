# workflow-orchestrator ステップ別モデル設定
#
# このファイルを直接編集してステップごとのモデルを変更できます。
# mode: seed のため、再生成時に既存の編集内容は上書きされません。

models:
  # Step ① 調査・分析（skipped/deferred 時の worker。invoked 時は dual-thinking config が優先）
  step1_investigation: "{{#if agent_workflow.models.step1_investigation}}{{agent_workflow.models.step1_investigation}}{{else}}claude-4.6-opus-high-thinking{{/if}}"
  # Step ② レポート作成
  step2_report: "{{#if agent_workflow.models.step2_report}}{{agent_workflow.models.step2_report}}{{else}}composer-2.5-fast{{/if}}"
  # Step ③ 実装
  step3_implementation: "{{#if agent_workflow.models.step3_implementation}}{{agent_workflow.models.step3_implementation}}{{else}}gpt-5.6-terra-medium{{/if}}"
  # Step ④ テスト
  step4_testing: "{{#if agent_workflow.models.step4_testing}}{{agent_workflow.models.step4_testing}}{{else}}composer-2.5-fast{{/if}}"
  # Step ⑤⑥ は config 対象外（親モデルをそのまま使用）

execution:
  # モデル利用不可時の方針: ABORT（親が起動前に即終了・設定見直しを案内）
  model_unavailable: "{{#if agent_workflow.model_unavailable}}{{agent_workflow.model_unavailable}}{{else}}ABORT{{/if}}"
