#!/usr/bin/env bash
# plan-gate.sh  [generated by agentic-workflow-foundation skill]
# 追跡ドキュメント（{{project.tracking_artifact}}）のライフサイクル境界ゲート。
# 仕様: docs/QUALITY_GATE.md §1.6（計画ライフサイクルゲート）/ §3（フェーズ境界）
# 用法: plan-gate.sh [report|review]
#   report = 計画→実装 境界（必須セクション充足 / 既定）
#   review = レビュー→完了 境界（レビュー完了承認 + 未対応0件 を追加検査）
# 出力: 人間可読の [PASS|WARN|FAIL] 名称 (CODE)
# exit: 0 = PASS / WARN のみ / 1 = FAIL（要対応）/ 2 = 致命的エラー
# 設計: session-start-gate.sh と同クラスの軽量シェルゲート（軽量検査ID / 数値判定なし / Finding Code 体系は非採用）
set -u

PHASE="${1:-report}"
PROJECT_DIR="${CURSOR_PROJECT_DIR:-$(pwd)}"
TRACKING="{{project.tracking_artifact}}"

# 追跡ドキュメントが満たすべき必須セクション（manifest.yaml > framework.plan_required_sections が SoT）。
REQUIRED_SECTIONS=(
{{#each framework.plan_required_sections}}
  "{{this}}"
{{/each}}
)

echo "=== plan gate (phase=$PHASE) ==="

if [[ "$PHASE" != "report" && "$PHASE" != "review" ]]; then
  echo "FATAL: 不正なフェーズ引数 '$PHASE'（report|review のいずれか）。"
  exit 2
fi

if [[ -z "$TRACKING" || "$TRACKING" == \[* ]]; then
  echo "FATAL: tracking artifact が未設定です（manifest.yaml > project.tracking_artifact）。"
  exit 2
fi

find_tracking_documents() {
  local tracking_dir
  tracking_dir="$(dirname "$PROJECT_DIR/$TRACKING")"
  local tracking_base
  tracking_base="$(basename "$TRACKING")"
  local tracking_pattern="${tracking_base//\{session_id\}/*}"
  if [[ -d "$tracking_dir" ]]; then
    find "$tracking_dir" -maxdepth 1 -type f -name "$tracking_pattern" 2>/dev/null
  fi
}

# 追跡ドキュメント列挙
tracked=()
while IFS= read -r f; do
  [[ -n "$f" ]] && tracked+=("$f")
done < <(find_tracking_documents)

if (( ${#tracked[@]} == 0 )); then
  echo "FATAL: 追跡ドキュメント '$TRACKING' が archive 外に見つかりません。"
  exit 2
fi

fail=0

for f in "${tracked[@]}"; do
  echo "--- $f ---"

  # --- G-PLAN-SECTION-001: 必須セクション充足 (FAIL) ---
  missing=()
  for sec in "${REQUIRED_SECTIONS[@]}"; do
    if ! grep -qF "$sec" "$f" 2>/dev/null; then
      missing+=("$sec")
    fi
  done
  if (( ${#missing[@]} > 0 )); then
    echo "[FAIL] 必須セクション欠落 (G-PLAN-SECTION-001): ${missing[*]}"
    fail=1
  else
    echo "[PASS] 必須セクション充足 (G-PLAN-SECTION-001)"
  fi

  # --- G-PLAN-PLACEHOLDER-001: 未充足プレースホルダ残存 (WARN) ---
  if grep -qE '\[要確認\]|TODO' "$f" 2>/dev/null; then
    echo "[WARN] 未充足プレースホルダ残存（要確認 / TODO マーカー） (G-PLAN-PLACEHOLDER-001)"
  fi

  # --- G-PLAN-EXCEPTION-001: ゲートスキップ言及時の例外承認記録 (WARN) ---
  if grep -qE 'ゲートスキップ|ゲート未実行|gate skip' "$f" 2>/dev/null; then
    if ! grep -qE '承認取得済み|PO承認|承認記録' "$f" 2>/dev/null; then
      echo "[WARN] ゲートスキップ言及があるが例外承認記録が見当たらない (G-PLAN-EXCEPTION-001)"
    fi
  fi

  # --- review フェーズ限定検査 ---
  if [[ "$PHASE" == "review" ]]; then
    # --- G-PLAN-REVIEW-001: 「## レビュー完了承認」節のみを対象に判定 (FAIL) ---
    # 節スコープ抽出: 「## レビュー完了承認」から次の「## 」見出しまでを切り出す。
    # これにより例外承認記録や他節の「承認取得済み」「保留」による誤判定を防ぐ。
    review_section=""
    if grep -qF '## レビュー完了承認' "$f" 2>/dev/null; then
      review_section="$(sed -n '/^## レビュー完了承認/,/^## /{ /^## レビュー完了承認/d; /^## /d; p; }' "$f" 2>/dev/null)"
    fi
    approved=0
    if [[ -n "$review_section" ]]; then
      echo "$review_section" | grep -qE '承認取得済み' && approved=1
    fi
    unresolved=0
    if [[ -n "$review_section" ]]; then
      echo "$review_section" | grep -qE '未対応|保留' && unresolved=1
    fi
    if (( approved == 1 )) && (( unresolved == 0 )); then
      echo "[PASS] レビュー完了承認あり / 未対応0件 (G-PLAN-REVIEW-001)"
    else
      reason=""
      (( approved == 0 )) && reason+="承認記録なし "
      (( unresolved == 1 )) && reason+="未対応/保留マーカー残存"
      echo "[FAIL] レビュー完了承認の不足 (G-PLAN-REVIEW-001): ${reason}"
      fail=1
    fi
  fi
done

if (( fail != 0 )); then
  echo "=== plan gate: FAIL ==="
  exit 1
fi
echo "=== plan gate: PASS ==="
exit 0
