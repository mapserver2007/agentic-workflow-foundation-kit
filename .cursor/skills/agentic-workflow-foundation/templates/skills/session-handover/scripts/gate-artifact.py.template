#!/usr/bin/env python3
# gate-artifact.py  [generated by agentic-workflow-foundation skill]
# step envelope (YAML front matter + Markdown body) を機械検査する。
# 全 worker の終端状態（complete/incomplete/blocked/fatal）で書き出される envelope を対象とし、
# 共通必須フィールド・status 値域・step 値域・Step 別必須フィールド（complete 時）・
# blocked/fatal 時の reason 必須を検証する。
# 仕様: docs/QUALITY_GATE.md §1.7 / step docs の Worker Contract / worker-dispatch.md
# 用法: gate-artifact.py <artifact-file> [--expect-step <stepN>] [--expect-status <status>] [--format=json]
# exit: 0 = PASS / 1 = FAIL（envelope 不正）/ 2 = 致命的エラー（依存不在・引数不備）

import json
import os
import re
import sys
from pathlib import Path

VALID_STATUSES = {"complete", "incomplete", "blocked", "fatal"}
VALID_STEPS = {"step1", "step2", "step3", "step4"}

COMMON_REQUIRED = ["status", "step"]

STEP_REQUIRED_FIELDS = {
    "step1": [
        "gate_result",
        "investigation_memo_path",
        "analysis_depth",
        "requirement_gate",
        "spec_consistency_gate",
        "feasibility_gate",
        "blocking_open_issues",
        "non_blocking_issues",
        "acceptance_criteria_status",
        "resolved_issues",
        "normalize_artifact_path",
        "depth_triage_artifact_path",
        "requirements_digest",
        "requirements_ack",
    ],
    "step2": ["report_path"],
    "step3": ["changed_files", "base_commit_sha", "impl_summary", "adr_needed"],
    "step4": ["gate_results", "test_summary", "advisory_loop_count"],
}

NULLABLE_FIELDS = {"doc_maintenance_file"}


def parse_front_matter(text: str):
    """YAML front matter を PyYAML で安全にパースする。"""
    try:
        import yaml
    except ImportError:
        print("FATAL: PyYAML が未導入です。pip install pyyaml を実行してください。")
        sys.exit({{agent_workflow.artifact.envelope.parser_missing_exit}})

    match = re.match(r"^---\s*\n(.*?)\n---\s*\n", text, re.DOTALL)
    if not match:
        return None, "YAML front matter が見つかりません（--- ... --- 形式が必要）"
    try:
        data = yaml.safe_load(match.group(1))
    except yaml.YAMLError as e:
        return None, f"YAML パースエラー: {e}"
    if not isinstance(data, dict):
        return None, "front matter がマッピングではありません"
    return data, None


def _extract_section(text: str, heading: str) -> str:
    """指定した level-2 見出しの本文だけを返す。"""
    pattern = re.compile(
        r"^##\s+" + re.escape(heading) + r"\b.*?\n(.*?)(?=\n##\s|\Z)",
        re.DOTALL | re.MULTILINE,
    )
    match = pattern.search(text)
    return match.group(1) if match else ""


def check_artifact(filepath: str, json_mode: bool = False,
                    expect_step: str | None = None,
                    expect_status: str | None = None):
    """単一 artifact ファイルを検査する。"""
    results = []
    fail = False

    path = Path(filepath)
    if not path.is_file():
        print(f"FATAL: ファイルが存在しません: {filepath}")
        return 2

    text = path.read_text(encoding="utf-8")
    fm, err = parse_front_matter(text)

    if err:
        results.append({"id": "G-ARTIFACT-PARSE-001", "level": "FAIL", "msg": err})
        fail = True
        _print_results(filepath, results, json_mode)
        return 1

    # --- 共通必須フィールド ---
    for field in COMMON_REQUIRED:
        if field not in fm or fm[field] is None or fm[field] == "":
            results.append({
                "id": "G-ARTIFACT-FIELD-001",
                "level": "FAIL",
                "msg": f"必須フィールド '{field}' が欠落または空値です",
            })
            fail = True

    # --- status 値域 ---
    status = fm.get("status")
    if status is not None and (not isinstance(status, str) or status not in VALID_STATUSES):
        results.append({
            "id": "G-ARTIFACT-STATUS-001",
            "level": "FAIL",
            "msg": f"status '{status}' は不正です。許可値: {sorted(VALID_STATUSES)}",
        })
        fail = True

    # --- step 値域 ---
    step = fm.get("step")
    if step is not None and (not isinstance(step, str) or step not in VALID_STEPS):
        results.append({
            "id": "G-ARTIFACT-STEP-001",
            "level": "FAIL",
            "msg": f"step '{step}' は不正です。許可値: {sorted(VALID_STEPS)}",
        })
        fail = True

    # --- ステップ別必須フィールド（complete 時）---
    if step and step in STEP_REQUIRED_FIELDS and status == "complete":
        for field in STEP_REQUIRED_FIELDS[step]:
            if field not in fm:
                results.append({
                    "id": "G-ARTIFACT-STEP-FIELD-001",
                    "level": "FAIL",
                    "msg": f"step={step}/status=complete で必須の '{field}' が欠落しています",
                })
                fail = True
            elif field not in NULLABLE_FIELDS and (fm[field] is None or fm[field] == ""):
                results.append({
                    "id": "G-ARTIFACT-STEP-FIELD-001",
                    "level": "FAIL",
                    "msg": f"step={step}/status=complete で必須の '{field}' が欠落しています",
                })
                fail = True

    # --- blocked/fatal 時は reason 必須 ---
    if status in ("blocked", "fatal") and "reason" not in fm:
        results.append({
            "id": "G-ARTIFACT-REASON-001",
            "level": "FAIL",
            "msg": f"status={status} では 'reason' フィールドが必須です",
        })
        fail = True

    # --- blocked: adr_required 時は base_commit_sha + decision_alternatives 2件以上必須 ---
    if step == "step3" and status == "blocked" and fm.get("reason") == "adr_required":
        if "base_commit_sha" not in fm or not fm["base_commit_sha"]:
            results.append({
                "id": "G-ARTIFACT-ADR-SHA-001",
                "level": "FAIL",
                "msg": "blocked: adr_required では base_commit_sha が必須です",
            })
            fail = True
        alts = fm.get("decision_alternatives")
        if not isinstance(alts, list) or len(alts) < 2:
            alt_count = len(alts) if isinstance(alts, list) else 0
            results.append({
                "id": "G-ARTIFACT-ADR-ALTS-001",
                "level": "FAIL",
                "msg": f"blocked: adr_required では decision_alternatives 2件以上必須（実際: {alt_count}件）",
            })
            fail = True

    # --- base_commit_sha 検証（step3） ---
    if step == "step3" and "base_commit_sha" in fm:
        sha = fm["base_commit_sha"]
        if not isinstance(sha, str) or not re.match(r"^[0-9a-f]{7,40}$", sha):
            results.append({
                "id": "G-ARTIFACT-SHA-001",
                "level": "FAIL",
                "msg": f"base_commit_sha '{sha}' は有効な git SHA ではありません",
            })
            fail = True

    # --- blocking_open_issues 検証（step1 complete 時）---
    if step == "step1" and status == "complete" and "blocking_open_issues" in fm:
        boi = fm["blocking_open_issues"]
        if isinstance(boi, list) and len(boi) > 0:
            results.append({
                "id": "G-ARTIFACT-RA-BLOCKING-001",
                "level": "FAIL",
                "msg": f"blocking_open_issues が非空（{len(boi)} 件）なのに status=complete",
            })
            fail = True

    # --- analysis_depth 検証（step1 complete 時）---
    if step == "step1" and status == "complete" and "analysis_depth" in fm:
        depth = fm["analysis_depth"]
        if depth not in ("standard", "deep"):
            results.append({
                "id": "G-ARTIFACT-RA-DEPTH-001",
                "level": "FAIL",
                "msg": f"analysis_depth '{depth}' は不正です。退出時は standard/deep のみ許容",
            })
            fail = True

    # --- ゲート値 PASS 検証（step1 complete 時）---
    if step == "step1" and status == "complete":
        for gate_field in ("gate_result", "requirement_gate", "spec_consistency_gate", "feasibility_gate"):
            if fm.get(gate_field) not in (None, "PASS"):
                results.append({
                    "id": "G-ARTIFACT-RA-GATE-001",
                    "level": "FAIL",
                    "msg": f"{gate_field} が 'PASS' 以外（{fm.get(gate_field)!r}）なのに status=complete",
                })
                fail = True

    # --- 中間 artifact 検証（step1 complete 時）---
    if step == "step1" and status == "complete":
        norm_ref = fm.get("normalize_artifact_path", "")
        depth_ref = fm.get("depth_triage_artifact_path", "")

        slug_m = re.match(r"^(.+)--step1\.md$", path.name)
        main_slug = slug_m.group(1) if slug_m else None

        for label, ref_val, suffix in [
            ("normalize_artifact_path", norm_ref, "step1-normalize.md"),
            ("depth_triage_artifact_path", depth_ref, "step1-depth-triage.md"),
        ]:
            if not ref_val:
                continue
            if ".cursor/.artifacts/" not in ref_val:
                results.append({"id": "G-ARTIFACT-RA-REF-001", "level": "FAIL",
                    "msg": f"{label} が .cursor/.artifacts/ 配下ではありません: {ref_val}"})
                fail = True
            if not ref_val.endswith(suffix):
                results.append({"id": "G-ARTIFACT-RA-REF-001", "level": "FAIL",
                    "msg": f"{label} のサフィックスが不正です（期待: *{suffix}）: {ref_val}"})
                fail = True
            if main_slug:
                expected_name = f"{main_slug}--{suffix}"
                actual_name = Path(ref_val).name
                if actual_name != expected_name:
                    results.append({"id": "G-ARTIFACT-RA-REF-001", "level": "FAIL",
                        "msg": f"{label} の slug が最終 envelope と不一致（期待: {expected_name}, 実値: {actual_name}）"})
                    fail = True
            ref_file = path.parent / Path(ref_val).name
            if not ref_file.is_file():
                results.append({"id": "G-ARTIFACT-RA-REF-001", "level": "FAIL",
                    "msg": f"{label} の参照先ファイルが存在しません: {ref_val}"})
                fail = True

        norm_fm = None
        depth_fm = None

        if norm_ref:
            nf = path.parent / Path(norm_ref).name
            if nf.is_file():
                nfm, nerr = parse_front_matter(nf.read_text(encoding="utf-8"))
                if nerr:
                    results.append({"id": "G-ARTIFACT-RA-NORM-SCHEMA-001", "level": "FAIL",
                        "msg": f"normalize artifact のパースに失敗: {nerr}"})
                    fail = True
                else:
                    norm_fm = nfm

        if depth_ref:
            df = path.parent / Path(depth_ref).name
            if df.is_file():
                dfm, derr = parse_front_matter(df.read_text(encoding="utf-8"))
                if derr:
                    results.append({"id": "G-ARTIFACT-RA-DEPTH-SCHEMA-001", "level": "FAIL",
                        "msg": f"depth_triage artifact のパースに失敗: {derr}"})
                    fail = True
                else:
                    depth_fm = dfm

        if norm_fm is not None:
            for key, expected in [("step", "step1-normalize"), ("status", "complete"), ("gate_a", "PASS")]:
                if norm_fm.get(key) != expected:
                    results.append({"id": "G-ARTIFACT-RA-NORM-SCHEMA-001", "level": "FAIL",
                        "msg": f"normalize artifact の {key}={norm_fm.get(key)!r}（期待: {expected!r}）"})
                    fail = True

        if depth_fm is not None:
            for key, expected in [("step", "step1-depth-triage"), ("status", "complete"), ("gate_b", "PASS")]:
                if depth_fm.get(key) != expected:
                    results.append({"id": "G-ARTIFACT-RA-DEPTH-SCHEMA-001", "level": "FAIL",
                        "msg": f"depth_triage artifact の {key}={depth_fm.get(key)!r}（期待: {expected!r}）"})
                    fail = True
            depth_ad = depth_fm.get("analysis_depth")
            if depth_ad not in ("standard", "deep", "deferred"):
                results.append({"id": "G-ARTIFACT-RA-DEPTH-SCHEMA-001", "level": "FAIL",
                    "msg": f"depth_triage artifact の analysis_depth={depth_ad!r} は不正。許容値: standard/deep/deferred"})
                fail = True

        if depth_fm is not None and "analysis_depth" in fm:
            final_depth = fm["analysis_depth"]
            triage_depth = depth_fm.get("analysis_depth")
            if triage_depth == "standard" and final_depth != "standard":
                results.append({"id": "G-ARTIFACT-RA-DEPTH-CONSIST-001", "level": "FAIL",
                    "msg": f"depth_triage=standard → 最終 depth は standard 必須（実値: {final_depth}）"})
                fail = True
            elif triage_depth == "deep":
                if final_depth == "deep":
                    pass
                elif final_depth == "standard":
                    if not fm.get("depth_fallback_reason"):
                        results.append({"id": "G-ARTIFACT-RA-DEPTH-CONSIST-001", "level": "FAIL",
                            "msg": "depth_triage=deep → 最終=standard のフォールバックには depth_fallback_reason が必須"})
                        fail = True
                else:
                    results.append({"id": "G-ARTIFACT-RA-DEPTH-CONSIST-001", "level": "FAIL",
                        "msg": f"depth_triage=deep → 最終 depth は deep または standard+fallback_reason 必須（実値: {final_depth}）"})
                    fail = True

        if norm_fm is not None and depth_fm is not None:
            if fm.get("requirement_gate") != norm_fm.get("gate_a"):
                results.append({"id": "G-ARTIFACT-RA-GATE-SOURCE-001", "level": "FAIL",
                    "msg": f"requirement_gate={fm.get('requirement_gate')!r} が normalize.gate_a={norm_fm.get('gate_a')!r} と不一致"})
                fail = True
            if fm.get("spec_consistency_gate") != depth_fm.get("gate_b"):
                results.append({"id": "G-ARTIFACT-RA-GATE-SOURCE-001", "level": "FAIL",
                    "msg": f"spec_consistency_gate={fm.get('spec_consistency_gate')!r} が depth_triage.gate_b={depth_fm.get('gate_b')!r} と不一致"})
                fail = True

    # --- requirements_digest / requirements_ack 検証（step1 complete 時）---
    if step == "step1" and status == "complete":
        rd = fm.get("requirements_digest")
        ra = fm.get("requirements_ack")
        if (
            not isinstance(rd, str)
            or re.fullmatch(r"[0-9a-f]{64}", rd, re.IGNORECASE) is None
        ):
            results.append({"id": "G-ARTIFACT-RA-ACK-001", "level": "FAIL",
                "msg": "requirements_digest が欠落、または64桁のSHA-256 hex形式ではありません"})
            fail = True
        if not isinstance(ra, dict):
            results.append({"id": "G-ARTIFACT-RA-ACK-002", "level": "FAIL",
                "msg": "requirements_ack がマッピングではありません"})
            fail = True
        else:
            ack_status = ra.get("status")
            ack_digest = ra.get("digest")
            if ack_status != "acknowledged":
                results.append({"id": "G-ARTIFACT-RA-ACK-003", "level": "FAIL",
                    "msg": f"requirements_ack.status が 'acknowledged' ではありません: {ack_status!r}"})
                fail = True
            if (
                not isinstance(ack_digest, str)
                or not isinstance(rd, str)
                or ack_digest.casefold() != rd.casefold()
            ):
                results.append({"id": "G-ARTIFACT-RA-ACK-004", "level": "FAIL",
                    "msg": f"requirements_ack.digest と requirements_digest が不一致（ack={ack_digest!r}, digest={rd!r}）"})
                fail = True

    # --- acceptance_criteria_status 値域検証（step1 complete 時）---
    if step == "step1" and status == "complete":
        acs = fm.get("acceptance_criteria_status")
        if acs not in ("complete", "incomplete"):
            results.append({"id": "G-ARTIFACT-RA-ACS-001", "level": "FAIL",
                "msg": f"acceptance_criteria_status '{acs}' は不正です。許容値: complete/incomplete"})
            fail = True
        elif acs != "complete":
            results.append({"id": "G-ARTIFACT-RA-ACS-002", "level": "FAIL",
                "msg": "acceptance_criteria_status が 'complete' ではありません"})
            fail = True

    # --- Issue schema 検証（step1、非空時）---
    if step == "step1" and status == "complete":
        for list_key in ("resolved_issues", "non_blocking_issues"):
            items = fm.get(list_key)
            if isinstance(items, list):
                for idx, item in enumerate(items):
                    if not isinstance(item, dict):
                        results.append({"id": "G-ARTIFACT-RA-ISSUE-001", "level": "FAIL",
                            "msg": f"{list_key}[{idx}] がマッピングではありません"})
                        fail = True
                    elif re.fullmatch(r"RA-\d{3}", str(item.get("id", ""))) is None:
                        results.append({"id": "G-ARTIFACT-RA-ISSUE-001", "level": "FAIL",
                            "msg": f"{list_key}[{idx}].id が RA-NNN 形式ではありません: {item.get('id')!r}"})
                        fail = True

    # --- Memo 検査（step1 complete 時）---
    if step == "step1" and status == "complete":
        memo_path_val = fm.get("investigation_memo_path", "")
        memo_file = None
        if memo_path_val:
            if memo_path_val == str(path) or Path(memo_path_val).name == path.name:
                memo_file = path
            else:
                candidate = path.parent / Path(memo_path_val).name
                if candidate.is_file():
                    memo_file = candidate

        if memo_file and memo_file.is_file():
            memo_text = memo_file.read_text(encoding="utf-8")

            MEMO_REQUIRED_HEADINGS = [
                "正規化済み要求", "確定済み受入条件",
                "根本原因分析 / 実装方針候補", "争点と判断根拠",
                "影響範囲", "変更対象ファイル", "実装手順",
                "テスト観点", "ADR 起票判定結果",
                "docs-first 参照記録", "Issue Ledger",
                "non-blocking issues",
            ]
            for heading in MEMO_REQUIRED_HEADINGS:
                if heading not in memo_text:
                    results.append({"id": "G-ARTIFACT-RA-MEMO-001", "level": "FAIL",
                        "msg": f"Memo に必須見出し '{heading}' がありません"})
                    fail = True

            ac_section = _extract_section(memo_text, "確定済み受入条件")
            ac_def_pattern = re.compile(
                r"^[ \t]*[-*]?[ \t]*AC-(\d{3}):[ \t]*\S", re.MULTILINE
            )
            ac_defs = ac_def_pattern.findall(ac_section)
            if len(ac_defs) == 0:
                results.append({"id": "G-ARTIFACT-RA-MEMO-AC-001", "level": "FAIL",
                    "msg": "Memo 内に AC-NNN 定義が 0 件です（1件以上必須）"})
                fail = True
            elif len(ac_defs) != len(set(ac_defs)):
                results.append({"id": "G-ARTIFACT-RA-MEMO-AC-002", "level": "FAIL",
                    "msg": "Memo 内に重複する AC-NNN 定義があります"})
                fail = True

            if ac_defs:
                test_section = _extract_section(memo_text, "テスト観点")
                impl_section = _extract_section(memo_text, "実装手順")
                files_section = _extract_section(memo_text, "変更対象ファイル")

                for ac_num in set(ac_defs):
                    ac_id = f"AC-{ac_num}"
                    ac_ref = re.compile(
                        rf"(?<![A-Za-z0-9-]){re.escape(ac_id)}(?!\d)"
                    )
                    in_test = bool(ac_ref.search(test_section))
                    in_impl = bool(ac_ref.search(impl_section))
                    in_files = bool(ac_ref.search(files_section))
                    if not in_test:
                        results.append({"id": "G-ARTIFACT-RA-MEMO-AC-003", "level": "FAIL",
                            "msg": f"{ac_id} が「テスト観点」に出現しません"})
                        fail = True
                    if not in_impl and not in_files:
                        results.append({"id": "G-ARTIFACT-RA-MEMO-AC-004", "level": "FAIL",
                            "msg": f"{ac_id} が「実装手順」「変更対象ファイル」のいずれにも出現しません"})
                        fail = True
        elif memo_path_val:
            results.append({"id": "G-ARTIFACT-RA-MEMO-002", "level": "FAIL",
                "msg": f"investigation_memo_path の参照先が解決できません: {memo_path_val!r}"})
            fail = True

    # --- normalize provenance 検証（step1 complete 時）---
    if step == "step1" and status == "complete" and norm_fm is not None:
        n_task_type = norm_fm.get("task_type")
        valid_task_types = {"bug_fix", "new_feature", "refactoring", "performance"}
        if not n_task_type or n_task_type not in valid_task_types:
            results.append({"id": "G-ARTIFACT-RA-NORM-PROV-001", "level": "FAIL",
                "msg": f"normalize artifact の task_type が不正: {n_task_type!r}（許容値: {sorted(valid_task_types)}）"})
            fail = True

        n_fields = norm_fm.get("fields")
        valid_prov = {"user_confirmed", "docs_derived", "undecided", "external"}
        if not isinstance(n_fields, list) or len(n_fields) == 0:
            results.append({"id": "G-ARTIFACT-RA-NORM-PROV-002", "level": "FAIL",
                "msg": "normalize artifact の fields が空です"})
            fail = True
        elif isinstance(n_fields, list):
            for fidx, fld in enumerate(n_fields):
                if not isinstance(fld, dict):
                    results.append({"id": "G-ARTIFACT-RA-NORM-PROV-003", "level": "FAIL",
                        "msg": f"fields[{fidx}] がマッピングではありません"})
                    fail = True
                    continue
                prov = fld.get("provenance")
                if not prov or prov not in valid_prov:
                    results.append({"id": "G-ARTIFACT-RA-NORM-PROV-003", "level": "FAIL",
                        "msg": f"fields[{fidx}].provenance が不正: {prov!r}"})
                    fail = True
                if prov == "undecided":
                    results.append({"id": "G-ARTIFACT-RA-NORM-PROV-004", "level": "FAIL",
                        "msg": f"fields[{fidx}] に provenance=undecided が残っています（complete 不可）"})
                    fail = True
                if prov == "external":
                    results.append({"id": "G-ARTIFACT-RA-NORM-PROV-005", "level": "FAIL",
                        "msg": f"fields[{fidx}] が provenance=external のまま complete（blocked にすべき）"})
                    fail = True
                evidence_ref = fld.get("evidence_ref")
                if prov in ("docs_derived", "external") and (
                    not isinstance(evidence_ref, str) or not evidence_ref.strip()
                ):
                    results.append({"id": "G-ARTIFACT-RA-NORM-PROV-006", "level": "FAIL",
                        "msg": f"fields[{fidx}] は provenance={prov} のため非空 evidence_ref が必須です"})
                    fail = True

    # --- 期待 step/status 検査（--expect-step / --expect-status 指定時のみ）---
    if expect_step is not None and step != expect_step:
        results.append({
            "id": "G-ARTIFACT-EXPECT-STEP-001",
            "level": "FAIL",
            "msg": f"期待 step '{expect_step}' に対して実値は '{step}'",
        })
        fail = True

    if expect_status is not None and status != expect_status:
        results.append({
            "id": "G-ARTIFACT-EXPECT-STATUS-001",
            "level": "FAIL",
            "msg": f"期待 status '{expect_status}' に対して実値は '{status}'",
        })
        fail = True

    if not fail:
        results.append({
            "id": "G-ARTIFACT-ALL",
            "level": "PASS",
            "msg": f"envelope 検査通過 (step={step}, status={status})",
        })

    _print_results(filepath, results, json_mode)
    return 1 if fail else 0


def _print_results(filepath, results, json_mode):
    if json_mode:
        print(json.dumps({"file": filepath, "checks": results}, ensure_ascii=False))
    else:
        print(f"--- {filepath} ---")
        for r in results:
            print(f"  [{r['level']}] {r['msg']} ({r['id']})")


def main():
    raw = sys.argv[1:]
    json_mode = "--format=json" in raw
    expect_step: str | None = None
    expect_status: str | None = None

    positional: list[str] = []
    i = 0
    while i < len(raw):
        if raw[i] == "--expect-step":
            if i + 1 >= len(raw) or raw[i + 1].startswith("--"):
                print(f"FATAL: --expect-step に値が必要です。")
                sys.exit(2)
            expect_step = raw[i + 1]
            i += 2
        elif raw[i] == "--expect-status":
            if i + 1 >= len(raw) or raw[i + 1].startswith("--"):
                print(f"FATAL: --expect-status に値が必要です。")
                sys.exit(2)
            expect_status = raw[i + 1]
            i += 2
        elif raw[i].startswith("--"):
            i += 1
        else:
            positional.append(raw[i])
            i += 1

    if not positional:
        print("FATAL: artifact ファイルパスを指定してください。")
        print("用法: gate-artifact.py <artifact-file> [--expect-step <stepN>] [--expect-status <status>] [--format=json]")
        sys.exit(2)

    worst = 0
    for filepath in positional:
        rc = check_artifact(filepath, json_mode,
                            expect_step=expect_step,
                            expect_status=expect_status)
        worst = max(worst, rc)

    if not json_mode:
        label = {0: "PASS", 1: "FAIL", 2: "FATAL"}.get(worst, "UNKNOWN")
        print(f"=== artifact gate: {label} ===")
    sys.exit(worst)


if __name__ == "__main__":
    main()
