#!/usr/bin/env bash
# session-start-gate.sh  [generated by agentic-workflow-foundation skill]
# Cursor セッション開始時のクロスセッション整合性ゲート。
# 仕様: docs/QUALITY_GATE.md §1.4（検査ID命名規約）/ §1.5（セッション開始ゲート）
# 出力: 人間可読の [PASS|WARN|FAIL] 名称 (CODE)
# exit: 0 = PASS / WARN のみ / 1 = FAIL（要対応）/ 2 = 致命的エラー
# 設計: verification-gate.sh と同クラスのシェルゲート（軽量実装 / 数値判定なし）
set -u

PROJECT_DIR="${CURSOR_PROJECT_DIR:-$(pwd)}"
SESSION_DIR="$PROJECT_DIR/.cursor/.session"
HANDOFF_FILE="$SESSION_DIR/handoff-active.md"
TRACKING="{{project.tracking_artifact}}"
STALE_HOURS=24

echo "=== session-start gate ==="

if [[ -z "$TRACKING" || "$TRACKING" == \[* ]]; then
  echo "FATAL: tracking artifact が未設定です（manifest.yaml > project.tracking_artifact）。"
  exit 2
fi

find_tracking_documents() {
  if [[ "$TRACKING" == */* ]]; then
    local candidate="$PROJECT_DIR/$TRACKING"
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
    fi
    return
  fi
  find "$PROJECT_DIR" -type f -name "$TRACKING" 2>/dev/null
}

fail=0

# --- G-SESSION-HANDOFF-001: handoff manifest 未消費の残存 (WARN) ---
if [[ -f "$HANDOFF_FILE" ]]; then
  echo "[WARN] handoff-active.md 残存。新規チャットの sessionStart Hook が consume すべき (G-SESSION-HANDOFF-001): $HANDOFF_FILE"
else
  echo "[PASS] handoff manifest 残存なし (G-SESSION-HANDOFF-001)"
fi

# --- 追跡ドキュメント列挙 ---
tracked=()
while IFS= read -r f; do
  [[ -n "$f" ]] && tracked+=("$f")
done < <(find_tracking_documents)

now="$(date +%s)"
if (( ${#tracked[@]} > 0 )); then
for f in "${tracked[@]}"; do
  # --- G-SESSION-STALE-001: 追跡ドキュメントの停滞 (WARN) ---
  mtime="$(date -r "$f" +%s 2>/dev/null || echo "")"
  if [[ -n "$mtime" ]]; then
    age_h=$(( (now - mtime) / 3600 ))
    if (( age_h >= STALE_HOURS )); then
      echo "[WARN] 追跡ドキュメントが ${age_h}h 停滞 (G-SESSION-STALE-001): $f"
    fi
  fi

  # --- G-SESSION-DONE-001: 完了済み追跡ドキュメントの残存 (WARN) ---
  if grep -qE '^[[:space:]]*- \[x\]' "$f" 2>/dev/null && ! grep -qE '^[[:space:]]*- \[ \]' "$f" 2>/dev/null; then
    echo "[WARN] 全チェック完了済みだが削除されていない (G-SESSION-DONE-001): $f"
  fi
done
fi

if (( ${#tracked[@]} == 0 )); then
  echo "[PASS] 進行中の追跡ドキュメントなし (G-SESSION-STALE-001 / G-SESSION-DONE-001)"
fi

if (( fail != 0 )); then
  echo "=== session-start gate: FAIL ==="
  exit 1
fi
echo "=== session-start gate: PASS ==="
exit 0
