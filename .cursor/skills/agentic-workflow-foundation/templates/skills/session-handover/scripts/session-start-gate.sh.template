#!/usr/bin/env bash
# session-start-gate.sh  [generated by agentic-workflow-foundation skill]
# Cursor セッション開始時のクロスセッション整合性ゲート。
# 仕様: docs/QUALITY_GATE.md §1.4（検査ID命名規約）/ §1.5（セッション開始ゲート）
# 出力: 人間可読の [PASS|WARN|FAIL] 名称 (CODE)
# exit: 0 = PASS / WARN のみ / 1 = FAIL（要対応）/ 2 = 致命的エラー
# 設計: verification-gate.sh と同クラスのシェルゲート（軽量実装 / 数値判定なし）
set -u

PROJECT_DIR="${CURSOR_PROJECT_DIR:-$(pwd)}"
SESSION_DIR="$PROJECT_DIR/.cursor/.session"
TRACKING="{{project.tracking_artifact}}"
STALE_HOURS=24

echo "=== session-start gate ==="

if [[ -z "$TRACKING" || "$TRACKING" == \[* ]]; then
  echo "FATAL: tracking artifact が未設定です（manifest.yaml > project.tracking_artifact）。"
  exit 2
fi

find_tracking_documents() {
  local tracking_dir
  tracking_dir="$(dirname "$PROJECT_DIR/$TRACKING")"
  local tracking_base
  tracking_base="$(basename "$TRACKING")"
  local tracking_pattern="${tracking_base//\{session_id\}/*}"
  if [[ -d "$tracking_dir" ]]; then
    find "$tracking_dir" -maxdepth 1 -type f -name "$tracking_pattern" 2>/dev/null
  fi
}

fail=0

# --- G-SESSION-HANDOFF-001: handoff manifest 未消費の残存 (WARN) ---
HANDOFF_FOUND=false
if [[ -d "$SESSION_DIR" ]]; then
  for hf in "$SESSION_DIR"/handoff-*.md; do
    [[ -f "$hf" ]] || continue
    case "$(basename "$hf")" in
      handoff-consumed-*) continue ;;
    esac
    HANDOFF_FOUND=true
    echo "[WARN] handoff manifest 残存。新規チャットの sessionStart Hook が consume すべき (G-SESSION-HANDOFF-001): $hf"
  done
fi
if [[ "$HANDOFF_FOUND" == "false" ]]; then
  echo "[PASS] handoff manifest 残存なし (G-SESSION-HANDOFF-001)"
fi

# --- G-SESSION-RED-CONTINUE-001: Red 到達後のセッション継続検出 (WARN) ---
RED_DETECTED=false
if [[ -d "$SESSION_DIR" ]] && command -v jq >/dev/null 2>&1; then
  for state_f in "$SESSION_DIR"/*.json; do
    [[ -f "$state_f" ]] || continue
    last_lvl="$(jq -r '.last_warning_level // "none"' "$state_f" 2>/dev/null)" || last_lvl="none"
    if [[ "$last_lvl" == "red" ]]; then
      RED_DETECTED=true
      echo "[WARN] Red 到達後の同一セッション継続が検出されました。Cmd+N で新規チャットを開くことを推奨します (G-SESSION-RED-CONTINUE-001)"
      break
    fi
  done
fi
if [[ "$RED_DETECTED" == "false" ]]; then
  echo "[PASS] Red 後継続なし (G-SESSION-RED-CONTINUE-001)"
fi

# --- 追跡ドキュメント列挙 ---
tracked=()
while IFS= read -r f; do
  [[ -n "$f" ]] && tracked+=("$f")
done < <(find_tracking_documents)

now="$(date +%s)"
if (( ${#tracked[@]} > 0 )); then
for f in "${tracked[@]}"; do
# --- G-SESSION-STALE-001: 追跡ドキュメントの停滞 (WARN) ---
  mtime="$(date -r "$f" +%s 2>/dev/null || echo "")"
  if [[ -n "$mtime" ]]; then
    age_h=$(( (now - mtime) / 3600 ))
    if (( age_h >= STALE_HOURS )); then
      echo "[WARN] 追跡ドキュメントが ${age_h}h 停滞 (G-SESSION-STALE-001): $f"
    fi
  fi

  # --- G-SESSION-TRACKER-001: CHECKPOINT 後 tracker 未更新 (WARN) ---
  if [[ -d "$SESSION_DIR" ]] && [[ -n "$mtime" ]]; then
    for state_f in "$SESSION_DIR"/*.json; do
      [[ -f "$state_f" ]] || continue
      if command -v jq >/dev/null 2>&1; then
        started="$(jq -r '.started_at_unix // empty' "$state_f" 2>/dev/null)" || started=""
        prompts="$(jq -r '.prompt_count // 0' "$state_f" 2>/dev/null)" || prompts=0
        if [[ -n "$started" ]] && [[ "$prompts" =~ ^[0-9]+$ ]] && (( prompts >= {{framework.budget_thresholds.checkpoint_interval_prompts}} )); then
          if (( mtime < started )); then
            echo "[WARN] CHECKPOINT 発火可能だが tracker が session 開始前から未更新 (G-SESSION-TRACKER-001): $f"
            break
          fi
        fi
      fi
    done
  fi

  # --- G-SESSION-DONE-001: 完了済み追跡ドキュメントの残存 (WARN) ---
  if grep -qE '^[[:space:]]*- \[x\]' "$f" 2>/dev/null && ! grep -qE '^[[:space:]]*- \[ \]' "$f" 2>/dev/null; then
    echo "[WARN] 全チェック完了済みだが削除されていない (G-SESSION-DONE-001): $f"
  fi
done
fi

if (( ${#tracked[@]} == 0 )); then
  echo "[PASS] 進行中の追跡ドキュメントなし (G-SESSION-STALE-001 / G-SESSION-DONE-001)"
fi

{{#if agent_workflow.maintenance_docs.enabled}}
# --- maintenance-docs/ 未処理ファイルの検知 (INFO) ---
MAINT_DOCS_DIR="$ROOT/docs/agent-tasks/maintenance-docs"
if [[ -d "$MAINT_DOCS_DIR" ]]; then
  maint_count=0
  for f in "$MAINT_DOCS_DIR"/*.md; do
    [[ -f "$f" ]] && (( maint_count++ ))
  done
  if (( maint_count > 0 )); then
    echo "[INFO] 未処理の docs 更新タスクが ${maint_count} 件あります (maintenance-docs/)"
  fi
fi
{{/if}}

if (( fail != 0 )); then
  echo "=== session-start gate: FAIL ==="
  exit 1
fi
echo "=== session-start gate: PASS ==="
exit 0
