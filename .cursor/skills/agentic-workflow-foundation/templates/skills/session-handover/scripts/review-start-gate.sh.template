from urllib.parse import urlsplit

G_INPUT = "G-REVIEW-START-INPUT-001"
G_REPORT = "G-REVIEW-START-REPORT-001"
G_URL = "G-REVIEW-START-URL-001"
G_STEP4 = "G-REVIEW-START-STEP4-001"
G_PROMPT = "G-REVIEW-START-PROMPT-001"
G_SESSION = "G-REVIEW-START-SESSION-001"
