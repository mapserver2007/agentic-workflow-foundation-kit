G_READBACK = "G-REVIEW-START-READBACK-001"


def stop(code: int, gate_id: str, message: str) -> "NoReturn":
    label = "FAIL" if code == 1 else "FATAL"
    print(f"{label}: {message} ({gate_id})", file=sys.stderr)
    raise SystemExit(code)


def canonical_pr_url(value: object) -> str:
    if not isinstance(value, str) or not value:
        raise ValueError("PR URL は非空文字列が必要です")
    if "%" in value:
        raise ValueError("percent encoding は許可されません")
    parsed = urlsplit(value)
    if parsed.scheme.lower() != "https" or parsed.hostname is None:
        raise ValueError("https URL が必要です")
    try:
        port = parsed.port
    except ValueError as exc:
        raise ValueError("port が不正です") from exc
    if parsed.username is not None or parsed.password is not None or port is not None:
        raise ValueError("credential / port は許可されません")
    if parsed.hostname.lower() != "github.com":
        raise ValueError("host は github.com 固定です")
    match = re.fullmatch(
        r"/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)/pull/([0-9]+)/?",
        parsed.path,
    )
    if match is None or int(match.group(3)) <= 0:
        raise ValueError("GitHub PR URL の path が不正です")
    owner, repo, number = match.groups()
    return f"https://github.com/{owner.lower()}/{repo.lower()}/pull/{int(number)}"


def parse_args(values: list[str]) -> tuple[str, str]:
    report = None
    pr = None
    index = 0
    while index < len(values):
        arg = values[index]
        if arg in {"--report", "--pr"}:
            if index + 1 >= len(values):
                stop(2, G_INPUT, f"{arg} に値が必要です")
            value = values[index + 1]
            if arg == "--report":
                if report is not None:
                    stop(2, G_INPUT, "--report は1回だけ指定できます")
                report = value
            else:
                if pr is not None:
                    stop(2, G_INPUT, "--pr は1回だけ指定できます")
                pr = value
            index += 2
            continue
        stop(2, G_INPUT, f"未対応の引数です: {arg}")
    if report is None or pr is None:
        stop(2, G_INPUT, "--report と --pr は必須です")
    return report, pr


def validate_report(root: Path, raw_report: str, canonical_pr: str) -> tuple[Path, str]:
    reports_dir = root / "docs" / "agent-tasks" / "reports"
    supplied = Path(raw_report)
    candidate = supplied if supplied.is_absolute() else root / supplied
    if candidate.is_symlink() or not candidate.is_file():
        stop(2, G_REPORT, f"実在する symlink でない active report が必要です: {raw_report}")
    report = candidate.resolve()
    if report.parent != reports_dir.resolve() or report.suffix != ".md":
        stop(2, G_REPORT, "report は docs/agent-tasks/reports/ 直下に限定されます")
    active = [path.resolve() for path in reports_dir.glob("*.md") if path.is_file() and not path.is_symlink()]
    if len(active) != 1 or active[0] != report:
        stop(2, G_REPORT, "指定 report を active report として一意に解決できません")

    text = report.read_text(encoding="utf-8")
    section_match = re.search(
        r"^##(?:\s+\d+\.)?\s+完了チェック\s*$\n(.*?)(?=^##\s|\Z)",
        text,
        re.MULTILINE | re.DOTALL,
    )
    if section_match is None:
        stop(1, G_REPORT, "完了チェック節がありません")
    all_markers = re.findall(r"^\s*(?:-\s*)?review-pr-url:\s*(\S+)\s*$", text, re.MULTILINE)
    section_markers = re.findall(
        r"^\s*(?:-\s*)?review-pr-url:\s*(\S+)\s*$",
        section_match.group(1),
        re.MULTILINE,
    )
    if len(all_markers) != 1 or len(section_markers) != 1:
        stop(1, G_BIND, "完了チェック節の review-pr-url は正確に1件必要です")
    try:
        report_pr = canonical_pr_url(section_markers[0])
    except ValueError as exc:
        stop(1, G_BIND, f"report の review-pr-url が不正です: {exc}")
    if report_pr != canonical_pr:
        stop(1, G_BIND, "--pr と report の review-pr-url が一致しません")
    return report, report.stem


def parse_at(value: object) -> dt.datetime:
    if not isinstance(value, str) or not value:
        raise ValueError("at が非空文字列ではありません")
    normalized = value[:-1] + "+00:00" if value.endswith("Z") else value
    parsed = dt.datetime.fromisoformat(normalized)
    if parsed.tzinfo is None:
        raise ValueError("at に timezone がありません")
    return parsed.astimezone(dt.timezone.utc)


def session_retired(session_dir: Path, session_id: str) -> bool:
    state_path = session_dir / f"{session_id}.json"
    if state_path.exists():
        if state_path.is_symlink() or not state_path.is_file():
            stop(2, G_SESSION, f"session state が不正です: {state_path.name}")
        try:
            state = json.loads(state_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            stop(2, G_SESSION, f"session state を解析できません: {state_path.name}: {exc}")
        if state.get("last_warning_level") == "red":
            return True
    handoff = session_dir / f"handoff-{session_id}.md"
    if handoff.exists():
        if handoff.is_symlink() or not handoff.is_file():
            stop(2, G_SESSION, f"handoff 証跡が不正です: {handoff.name}")
        return True
    for consumed in session_dir.glob(f"handoff-consumed-{session_id}-*.md"):
        if consumed.is_symlink() or not consumed.is_file():
            stop(2, G_SESSION, f"consumed handoff 証跡が不正です: {consumed.name}")
        return True
    return False


def load_last_prompt(log_path: Path, session_id: str) -> tuple[dict, str] | None:
    try:
        raw = log_path.read_bytes()
    except OSError as exc:
        stop(2, G_SESSION, f"progress log を読めません: {log_path.name}: {exc}")
    last = None
    for line_number, raw_line in enumerate(raw.splitlines(keepends=True), 1):
        record_bytes = raw_line[:-1] if raw_line.endswith(b"\n") else raw_line
        if not record_bytes:
            stop(2, G_SESSION, f"空の JSONL record があります: {log_path.name}:{line_number}")
        try:
            record = json.loads(record_bytes)
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            stop(2, G_SESSION, f"JSONL record が破損しています: {log_path.name}:{line_number}: {exc}")
        if not isinstance(record, dict):
            stop(2, G_SESSION, f"JSONL record が object ではありません: {log_path.name}:{line_number}")
        if record.get("session_id") != session_id:
            stop(2, G_SESSION, f"session_id と progress filename が一致しません: {log_path.name}:{line_number}")
        if record.get("kind") == "prompt":
            last = (record, hashlib.sha256(record_bytes).hexdigest())
    return last


def resolve_prompt_session(
    session_dir: Path,
    canonical_pr: str,
    max_age_seconds: int,
) -> tuple[str, str]:
    if not session_dir.is_dir() or session_dir.is_symlink():
        stop(2, G_SESSION, ".cursor/.session が実在する通常ディレクトリではありません")
    now = dt.datetime.now(dt.timezone.utc)
    candidates: list[tuple[str, str]] = []
    expired = 0
    for log_path in sorted(session_dir.glob("*.progress.jsonl")):
        if log_path.is_symlink() or not log_path.is_file():
            stop(2, G_SESSION, f"symlink または不正な progress log です: {log_path.name}")
        session_id = log_path.name[: -len(".progress.jsonl")]
        if re.fullmatch(r"[A-Za-z0-9._-]+", session_id) is None:
            stop(2, G_SESSION, f"progress filename の session ID が不正です: {log_path.name}")
        last_prompt = load_last_prompt(log_path, session_id)
        if last_prompt is None or session_retired(session_dir, session_id):
            continue
        event, event_digest = last_prompt
        extra = event.get("extra")
        if event.get("kind") != "prompt" or not isinstance(extra, dict):
            stop(2, G_PROMPT, f"prompt event schema が不正です: {log_path.name}")
        if extra.get("hook_event_name") != "beforeSubmitPrompt":
            stop(2, G_PROMPT, f"prompt event の hook_event_name が不正です: {log_path.name}")
        pr_urls = extra.get("pr_urls")
        prompt_sha = extra.get("prompt_sha256")
        if not isinstance(pr_urls, list) or not all(isinstance(item, str) for item in pr_urls):
            stop(2, G_PROMPT, f"extra.pr_urls が文字列配列ではありません: {log_path.name}")
        if not isinstance(prompt_sha, str) or re.fullmatch(r"[0-9a-f]{64}", prompt_sha) is None:
            stop(2, G_PROMPT, f"extra.prompt_sha256 が不正です: {log_path.name}")
        try:
            normalized_urls = [canonical_pr_url(item) for item in pr_urls]
        except ValueError as exc:
            stop(2, G_PROMPT, f"extra.pr_urls が canonical ではありません: {log_path.name}: {exc}")
        if normalized_urls != pr_urls or len(set(pr_urls)) != len(pr_urls):
            stop(2, G_PROMPT, f"extra.pr_urls が正規化・重複排除済みではありません: {log_path.name}")
        if pr_urls != [canonical_pr]:
            continue
        try:
            event_at = parse_at(event.get("at"))
        except (TypeError, ValueError) as exc:
            stop(2, G_PROMPT, f"prompt event の at が不正です: {log_path.name}: {exc}")
        age = (now - event_at).total_seconds()
        if age < -5:
            stop(2, G_PROMPT, f"prompt event が未来時刻です: {log_path.name}")
        if age > max_age_seconds:
            expired += 1
            continue
        candidates.append((session_id, event_digest))
    if len(candidates) == 0:
        detail = "（期限切れ候補あり）" if expired else ""
        stop(1, G_SESSION, f"期限内の対象 PR prompt session がありません{detail}。PR URLを再送してください")
    if len(candidates) > 1:
        ids = ", ".join(session_id for session_id, _ in candidates)
        stop(1, G_SESSION, f"対象 PR prompt session が複数あります: {ids}。旧sessionをhandoffして再送してください")
    return candidates[0]


def run_step4(root: Path, script_dir: Path, report: Path) -> None:
    workflow_gate = script_dir / "workflow-gate.sh"
    if workflow_gate.is_symlink() or not workflow_gate.is_file():
        stop(2, G_STEP4, "workflow-gate.sh がありません")
    result = subprocess.run(
        [str(workflow_gate), "step4", str(report)],
        cwd=root,
        env=dict(os.environ, CURSOR_PROJECT_DIR=str(root)),
        check=False,
    )
    if result.returncode not in {0, 1, 2}:
        stop(2, G_STEP4, f"workflow-gate.sh step4 が未知の exit {result.returncode} を返しました")
    if result.returncode != 0:
        stop(result.returncode, G_STEP4, f"workflow-gate.sh step4 が exit {result.returncode} で失敗しました")


def read_review_go_matches(log_path: Path, expected: dict) -> list[dict]:
    matches = []
    for line_number, line in enumerate(log_path.read_text(encoding="utf-8").splitlines(), 1):
        try:
            row = json.loads(line)
        except json.JSONDecodeError as exc:
            stop(2, G_READBACK, f"readback JSONL が破損しています: {line_number}: {exc}")
        extra = row.get("extra") if isinstance(row, dict) else None
        if isinstance(extra, dict) and extra.get("review_go_id") == expected["review_go_id"]:
            matches.append(row)
    return matches


root = Path(sys.argv[1]).resolve()
script_dir = Path(sys.argv[2]).resolve()
try:
    max_age = int(sys.argv[3])
except ValueError:
    stop(2, G_INPUT, "prompt_max_age_seconds が正整数ではありません")
if max_age <= 0:
    stop(2, G_INPUT, "prompt_max_age_seconds は正整数が必要です")
raw_report, raw_pr = parse_args(sys.argv[4:])
try:
    canonical_pr = canonical_pr_url(raw_pr)
except ValueError as exc:
    stop(2, G_URL, str(exc))
report, campaign = validate_report(root, raw_report, canonical_pr)
run_step4(root, script_dir, report)
session_dir = root / ".cursor" / ".session"
session_id, prompt_event_digest = resolve_prompt_session(session_dir, canonical_pr, max_age)

go_material = "\0".join(
    ["review-go-v1", session_id, prompt_event_digest, campaign, canonical_pr]
).encode("utf-8")
review_go_id = hashlib.sha256(go_material).hexdigest()
expected_extra = {
    "gate_id": "review",
    "campaign": campaign,
    "pr": canonical_pr,
    "review_go_id": review_go_id,
    "source": "review-start-gate",
}
expected = {
    "session_id": session_id,
    "kind": "review_start",
    "review_go_id": review_go_id,
    "extra": expected_extra,
}
progress_log = session_dir / f"{session_id}.progress.jsonl"
existing = read_review_go_matches(progress_log, expected)
if existing:
    if len(existing) != 1:
        stop(2, G_IDEMPOTENCY, "同一 review_go_id の証跡が複数あります")
    row = existing[0]
    if (
        row.get("session_id") != session_id
        or row.get("kind") != "review_start"
        or row.get("extra") != expected_extra
    ):
        stop(2, G_IDEMPOTENCY, "同一 review_go_id の既存証跡が矛盾しています")
    print(f"PASS: review_start 既存証跡と完全一致（冪等） ({G_IDEMPOTENCY})")
    raise SystemExit(0)

writer = root / ".cursor" / "hooks" / "session-progress-append.sh"
if writer.is_symlink() or not writer.is_file():
    stop(2, G_WRITE, "session-progress-append.sh がありません")
writer_env = dict(os.environ)
writer_env["CURSOR_PROJECT_DIR"] = str(root)
writer_env["CTX_BUDGET_SESSION_ID"] = session_id
result = subprocess.run(
    [
        str(writer),
        "--kind",
        "review_start",
        "--summary",
        "PRレビュー検証開始",
        "--extra",
        json.dumps(expected_extra, ensure_ascii=False, separators=(",", ":")),
    ],
    cwd=root,
    env=writer_env,
    check=False,
)
if result.returncode not in {0, 1, 2}:
    stop(2, G_WRITE, f"writer が未知の exit {result.returncode} を返しました")
if result.returncode != 0:
    gate = "G-REVIEW-START-LOCK-001" if result.returncode == 1 else G_WRITE
    stop(result.returncode, gate, f"writer が exit {result.returncode} で失敗しました")

matches = read_review_go_matches(progress_log, expected)
if len(matches) != 1:
    stop(2, G_READBACK, f"追記後の完全一致証跡が1件ではありません: {len(matches)}")
row = matches[0]
if row.get("session_id") != session_id or row.get("kind") != "review_start" or row.get("extra") != expected_extra:
    stop(2, G_READBACK, "追記後の readback フィールドが一致しません")
print(f"PASS: review_start を記録し readback を検証しました ({G_READBACK})")
PY
