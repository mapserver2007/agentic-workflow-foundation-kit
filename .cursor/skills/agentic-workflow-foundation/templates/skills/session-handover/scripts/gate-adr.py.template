#!/usr/bin/env python3
from __future__ import annotations

# gate-adr.py  [generated by agentic-workflow-foundation skill]
# docs/DECISIONS.md 内の ADR エントリ、または草案 artifact の構造を機械検査する。
# 仕様: docs/QUALITY_GATE.md §1.7（ワークフローゲートディスパッチャー adr）
# 用法: gate-adr.py [ADR-NNNN | decisions-file | --draft <path> [ADR-NNNN]] [--format=json]
#   ADR-NNNN を指定した場合は該当 ADR のみ検査
#   decisions-file を指定した場合はそのファイル内の全 ADR を検査
#   --draft <path> を指定した場合は草案 artifact ファイルを検査（ADR-NNNN で期待 ID 照合）
#   引数なしの場合は docs/DECISIONS.md 内の最新（最後の）ADR を検査
# 出力: 人間可読の [PASS|WARN|FAIL] 名称 (CODE)、--format=json 時は JSON
# exit: 0 = PASS / 1 = FAIL（要対応）/ 2 = 致命的エラー
# 設計: gate-report.py と同クラスの軽量ゲート（Python 3 標準ライブラリのみ）
#
# G-ADR-SIGNIFICANCE-001  G-ADR-ALTERNATIVES-001  G-ADR-STATUS-001
# G-ADR-DRAFT-SINGLE-001  G-ADR-DRAFT-ID-001  G-ADR-DRAFT-STATUS-001  G-ADR-DRAFT-EMPTY-001

import json
import os
import re
import sys

DESIGN_DIMENSIONS = [
{{#each framework.design_dimensions}}    "{{this.id}}",
{{/each}}]

VALID_STATUSES = ["Proposed", "Accepted", "Superseded", "Deprecated"]


def parse_adrs(content: str) -> list:
    """DECISIONS.md の内容から ADR エントリを抽出する。"""
    adr_pattern = re.compile(r"^## (ADR-\d{4}):?\s*(.*)$", re.MULTILINE)
    matches = list(adr_pattern.finditer(content))

    adrs = []
    for i, m in enumerate(matches):
        start = m.start()
        end = matches[i + 1].start() if i + 1 < len(matches) else len(content)
        adrs.append({
            "id": m.group(1),
            "title": m.group(2).strip(),
            "body": content[start:end],
        })
    return adrs


def _check_significance(body: str) -> dict | None:
    """Significance セクションを検査する。FAIL or PASS の check dict を返す。"""
    sig_match = re.search(r"###\s*Significance.*?\n(.*?)(?=\n###|\Z)", body, re.DOTALL)
    if not sig_match:
        return {"id": "G-ADR-SIGNIFICANCE-001", "status": "FAIL",
                "message": "Significance セクションが存在しない"}
    sig_body = sig_match.group(1)
    issues = []
    found_dims = [d for d in DESIGN_DIMENSIONS if d in sig_body]
    if len(found_dims) < 1:
        issues.append("設計次元 D-* が 0 件（1 件以上必須）")
    scope_lines = [l.strip() for l in sig_body.splitlines()
                   if l.strip().startswith("- ") and "/" in l]
    if len(scope_lines) < 2:
        issues.append(f"波及範囲が {len(scope_lines)} 件（2 件以上必須）")
    if issues:
        return {"id": "G-ADR-SIGNIFICANCE-001", "status": "FAIL",
                "message": "; ".join(issues),
                "found_dimensions": found_dims, "scope_count": len(scope_lines)}
    return {"id": "G-ADR-SIGNIFICANCE-001", "status": "PASS",
            "message": f"D-* {len(found_dims)} 件、波及範囲 {len(scope_lines)} 件"}


def _check_alternatives(body: str) -> dict | None:
    """Alternatives Considered セクションを検査する。"""
    alt_match = re.search(
        r"###\s*Alternatives Considered.*?\n(.*?)(?=\n###|\n## |\Z)", body, re.DOTALL)
    if not alt_match:
        return {"id": "G-ADR-ALTERNATIVES-001", "status": "FAIL",
                "message": "Alternatives Considered セクションが存在しない"}
    alt_body = alt_match.group(1)
    alt_lines = [l.strip() for l in alt_body.splitlines()
                 if l.strip().startswith("- ") and l.strip() != "-"]
    issues = []
    if len(alt_lines) < 2:
        issues.append(f"却下選択肢が {len(alt_lines)} 件（2 件以上必須）")
    empty_reason = []
    for line in alt_lines:
        parts = re.split(r"\s*[—–-]{1,3}\s*", line.lstrip("- ").strip(), maxsplit=1)
        if len(parts) < 2 or not parts[1].strip():
            empty_reason.append(line.strip())
    if empty_reason:
        issues.append(f"却下理由が空の選択肢 {len(empty_reason)} 件")
    if issues:
        return {"id": "G-ADR-ALTERNATIVES-001", "status": "FAIL",
                "message": "; ".join(issues),
                "alternatives_count": len(alt_lines), "empty_reason": empty_reason[:5]}
    return {"id": "G-ADR-ALTERNATIVES-001", "status": "PASS",
            "message": f"却下選択肢 {len(alt_lines)} 件、全件に理由あり"}


def check_draft(draft_path: str, expected_id: str = None) -> dict:
    """草案 artifact を検査し結果 dict を返す。"""
    with open(draft_path, encoding="utf-8") as f:
        content = f.read()

    results = {"adr_id": "?", "title": "?", "checks": [], "fail": False}

    # Parse YAML front matter
    fm = {}
    body = content
    if content.startswith("---"):
        parts = content.split("---", 2)
        if len(parts) >= 3:
            for line in parts[1].strip().splitlines():
                if ":" in line:
                    k, v = line.split(":", 1)
                    fm[k.strip()] = v.strip().strip('"').strip("'")
            body = parts[2].strip()

    results["adr_id"] = fm.get("provisional_id", "?")
    results["title"] = fm.get("title", "?")

    # G-ADR-DRAFT-EMPTY-001: 空草案チェック
    if not body or len(body.strip()) < 50:
        results["fail"] = True
        results["checks"].append({"id": "G-ADR-DRAFT-EMPTY-001", "status": "FAIL",
                                   "message": "草案本文が空または極端に短い（50 文字未満）"})
        return results

    # G-ADR-DRAFT-SINGLE-001: ADR 見出しがちょうど 1 件
    adr_headers = re.findall(r"^## ADR-\d{4}", body, re.MULTILINE)
    if len(adr_headers) == 0:
        results["fail"] = True
        results["checks"].append({"id": "G-ADR-DRAFT-SINGLE-001", "status": "FAIL",
                                   "message": "ADR 見出し（## ADR-NNNN）が 0 件"})
    elif len(adr_headers) > 1:
        results["fail"] = True
        results["checks"].append({"id": "G-ADR-DRAFT-SINGLE-001", "status": "FAIL",
                                   "message": f"ADR 見出しが {len(adr_headers)} 件（1 件のみ許容）"})
    else:
        results["checks"].append({"id": "G-ADR-DRAFT-SINGLE-001", "status": "PASS",
                                   "message": "ADR 見出し 1 件"})

    # G-ADR-DRAFT-ID-001: 期待 ID 一致（front matter + 本文見出し）
    if expected_id:
        prov_id = fm.get("provisional_id", "")
        header_match = re.search(r"^## (ADR-\d{4})", body, re.MULTILINE)
        header_id = header_match.group(1) if header_match else None
        if prov_id != expected_id:
            results["fail"] = True
            results["checks"].append({"id": "G-ADR-DRAFT-ID-001", "status": "FAIL",
                                       "message": f"provisional_id '{prov_id}' != 期待 '{expected_id}'"})
        elif header_id and header_id != expected_id:
            results["fail"] = True
            results["checks"].append({"id": "G-ADR-DRAFT-ID-001", "status": "FAIL",
                                       "message": f"本文見出し '{header_id}' != 期待 '{expected_id}'"})
        else:
            results["checks"].append({"id": "G-ADR-DRAFT-ID-001", "status": "PASS",
                                       "message": f"provisional_id: {prov_id}"})

    # G-ADR-DRAFT-STATUS-001: Status は厳密に Proposed
    draft_status = fm.get("status", "")
    if draft_status != "Proposed":
        results["fail"] = True
        results["checks"].append({"id": "G-ADR-DRAFT-STATUS-001", "status": "FAIL",
                                   "message": f"草案 status は 'Proposed' 必須（実際: '{draft_status}'）"})
    else:
        results["checks"].append({"id": "G-ADR-DRAFT-STATUS-001", "status": "PASS",
                                   "message": "status: Proposed"})

    # G-ADR-SIGNIFICANCE-001
    c = _check_significance(body)
    if c:
        if c["status"] == "FAIL":
            results["fail"] = True
        results["checks"].append(c)

    # G-ADR-ALTERNATIVES-001
    c = _check_alternatives(body)
    if c:
        if c["status"] == "FAIL":
            results["fail"] = True
        results["checks"].append(c)

    return results


def check_adr(adr: dict) -> dict:
    """単一 ADR を検査し結果 dict を返す。"""
    results = {"adr_id": adr["id"], "title": adr["title"], "checks": [], "fail": False}
    body = adr["body"]

    # G-ADR-SIGNIFICANCE-001
    c = _check_significance(body)
    if c:
        if c["status"] == "FAIL":
            results["fail"] = True
        results["checks"].append(c)

    # G-ADR-ALTERNATIVES-001
    c = _check_alternatives(body)
    if c:
        if c["status"] == "FAIL":
            results["fail"] = True
        results["checks"].append(c)

    # G-ADR-STATUS-001: Status 行検査 (WARN)
    status_match = re.search(r"\*\*Status\*\*:\s*(.+)", body)
    if not status_match:
        results["checks"].append({"id": "G-ADR-STATUS-001", "status": "WARN",
                                   "message": "Status 行が存在しない"})
    else:
        status_val = status_match.group(1).strip()
        valid = any(s in status_val for s in VALID_STATUSES)
        if not valid:
            results["checks"].append({"id": "G-ADR-STATUS-001", "status": "WARN",
                                       "message": f"Status '{status_val}' が有効値でない"})
        else:
            results["checks"].append({"id": "G-ADR-STATUS-001", "status": "PASS",
                                       "message": f"Status: {status_val}"})

    return results


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    json_mode = "--format=json" in sys.argv
    draft_mode = "--draft" in sys.argv

    project_dir = os.environ.get("CURSOR_PROJECT_DIR", os.getcwd())
    decisions_file = os.path.join(project_dir, "docs", "DECISIONS.md")

    if not json_mode:
        print("=== adr gate ===")

    # --- Draft mode ---
    if draft_mode:
        draft_idx = sys.argv.index("--draft")
        if draft_idx + 1 >= len(sys.argv) or sys.argv[draft_idx + 1].startswith("--"):
            msg = "FATAL: --draft にはファイルパスが必要です"
            if json_mode:
                print(json.dumps({"fatal": True, "message": msg}))
            else:
                print(msg)
            sys.exit(2)
        draft_path = sys.argv[draft_idx + 1]
        if not os.path.isabs(draft_path):
            draft_path = os.path.join(project_dir, draft_path)
        if not os.path.isfile(draft_path):
            msg = f"FATAL: 草案ファイルが存在しません: {draft_path}"
            if json_mode:
                print(json.dumps({"fatal": True, "message": msg}))
            else:
                print(msg)
            sys.exit(2)
        expected_id = None
        for a in args:
            if a != draft_path and re.match(r"^ADR-\d{4}$", a):
                expected_id = a
                break
        result = check_draft(draft_path, expected_id)
        if json_mode:
            status = "FAIL" if result["fail"] else "PASS"
            print(json.dumps({"status": status, "results": [result]}, ensure_ascii=False))
        else:
            print(f"--- draft: {result['adr_id']}: {result['title']} ---")
            for c in result["checks"]:
                print(f"[{c['status']}] {c['message']} ({c['id']})")
            print(f"=== adr gate: {'FAIL' if result['fail'] else 'PASS'} ===")
        sys.exit(1 if result["fail"] else 0)

    # --- Standard mode ---
    target_adr_id = None
    if args:
        arg = args[0]
        if re.match(r"^ADR-\d{4}$", arg):
            target_adr_id = arg
        elif os.path.isfile(arg):
            decisions_file = arg
        elif os.path.isfile(os.path.join(project_dir, arg)):
            decisions_file = os.path.join(project_dir, arg)
        else:
            target_adr_id = arg

    if not os.path.isfile(decisions_file):
        msg = f"FATAL: DECISIONS.md が存在しません: {decisions_file}"
        if json_mode:
            print(json.dumps({"fatal": True, "message": msg}))
        else:
            print(msg)
        sys.exit(2)

    with open(decisions_file, encoding="utf-8") as f:
        content = f.read()

    adrs = parse_adrs(content)

    if not adrs:
        msg = "ADR エントリなし（検査対象なし）"
        if json_mode:
            print(json.dumps({"status": "PASS", "message": msg, "results": []}))
        else:
            print(f"[PASS] {msg}")
        sys.exit(0)

    if target_adr_id:
        adrs = [a for a in adrs if a["id"] == target_adr_id]
        if not adrs:
            msg = f"FATAL: {target_adr_id} が見つかりません"
            if json_mode:
                print(json.dumps({"fatal": True, "message": msg}))
            else:
                print(msg)
            sys.exit(2)
    else:
        adrs = [adrs[-1]]

    all_results = []
    overall_fail = False

    for adr in adrs:
        result = check_adr(adr)
        all_results.append(result)
        if result["fail"]:
            overall_fail = True
        if not json_mode:
            print(f"--- {result['adr_id']}: {result['title']} ---")
            for c in result["checks"]:
                print(f"[{c['status']}] {c['message']} ({c['id']})")
                if c.get("empty_reason"):
                    for r in c["empty_reason"]:
                        print(f"  - 理由なし: {r}")

    if json_mode:
        status = "FAIL" if overall_fail else "PASS"
        print(json.dumps({"status": status, "results": all_results}, ensure_ascii=False))
    else:
        print(f"=== adr gate: {'FAIL' if overall_fail else 'PASS'} ===")

    sys.exit(1 if overall_fail else 0)


if __name__ == "__main__":
    main()
