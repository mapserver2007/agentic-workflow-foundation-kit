#!/usr/bin/env python3
# gate-redispatch.py  [generated by agentic-workflow-foundation skill]
# re-dispatch 前に partial artifact の base_commit_sha / changed_files / untracked_files を
# 現在の working tree と照合し、復元差分の一致を検証する。
# 仕様: docs/agent-tasks/agent-workflow/03-implementation.md Worker Contract > re-dispatch 時の復元検証
# 用法: gate-redispatch.py <artifact-file> [--format=json]
# exit: 0 = PASS / 1 = FAIL（差分不一致）/ 2 = 致命的エラー（依存不在・引数不備）

import json
import os
import re
import subprocess
import sys
from pathlib import Path


def parse_front_matter(text: str):
    """YAML front matter を PyYAML で安全にパースする。"""
    try:
        import yaml
    except ImportError:
        print("FATAL: PyYAML が未導入です。pip install pyyaml を実行してください。")
        sys.exit({{agent_workflow.artifact.envelope.parser_missing_exit}})

    match = re.match(r"^---\s*\n(.*?)\n---\s*\n", text, re.DOTALL)
    if not match:
        return None, "YAML front matter が見つかりません"
    try:
        data = yaml.safe_load(match.group(1))
    except Exception as e:
        return None, f"YAML パースエラー: {e}"
    if not isinstance(data, dict):
        return None, "front matter がマッピングではありません"
    return data, None


def run_git(args: list[str], cwd: str | None = None) -> tuple[int, str]:
    """git コマンドを実行し (exit_code, stdout) を返す。"""
    try:
        result = subprocess.run(
            ["git"] + args,
            capture_output=True, text=True,
            cwd=cwd or os.environ.get("CURSOR_PROJECT_DIR", os.getcwd()),
        )
        return result.returncode, result.stdout.strip()
    except FileNotFoundError:
        return 2, "git が見つかりません"


def check_redispatch(filepath: str, json_mode: bool = False):
    results = []
    fail = False

    path = Path(filepath)
    if not path.is_file():
        print(f"FATAL: ファイルが存在しません: {filepath}")
        return 2

    text = path.read_text(encoding="utf-8")
    fm, err = parse_front_matter(text)
    if err:
        results.append({"id": "G-REDISPATCH-PARSE-001", "level": "FAIL", "msg": err})
        _print_results(filepath, results, json_mode)
        return 1

    base_sha = fm.get("base_commit_sha")
    if not base_sha:
        results.append({
            "id": "G-REDISPATCH-SHA-001",
            "level": "FAIL",
            "msg": "base_commit_sha が artifact に存在しません",
        })
        _print_results(filepath, results, json_mode)
        return 1

    # --- base_commit_sha が有効な commit か検証 ---
    rc, object_type = run_git(["cat-file", "-t", base_sha])
    if rc != 0 or object_type != "commit":
        results.append({
            "id": "G-REDISPATCH-SHA-002",
            "level": "FAIL",
            "msg": f"base_commit_sha '{base_sha}' はリポジトリ内に存在しません",
        })
        _print_results(filepath, results, json_mode)
        return 1

    # --- changed_files の照合 ---
    artifact_changed = set(fm.get("changed_files", []) or [])
    rc, diff_output = run_git(["diff", "--name-only", base_sha])
    if rc != 0:
        results.append({
            "id": "G-REDISPATCH-DIFF-001",
            "level": "FAIL",
            "msg": f"git diff --name-only {base_sha} が失敗しました",
        })
        fail = True
    else:
        actual_changed = set(diff_output.splitlines()) if diff_output else set()
        only_in_artifact = artifact_changed - actual_changed
        only_in_tree = actual_changed - artifact_changed
        if only_in_artifact or only_in_tree:
            msg_parts = []
            if only_in_artifact:
                msg_parts.append(f"artifact にあるが tree にない: {sorted(only_in_artifact)}")
            if only_in_tree:
                msg_parts.append(f"tree にあるが artifact にない: {sorted(only_in_tree)}")
            results.append({
                "id": "G-REDISPATCH-CHANGED-001",
                "level": "FAIL",
                "msg": f"changed_files 不一致: {'; '.join(msg_parts)}",
            })
            fail = True
        else:
            results.append({
                "id": "G-REDISPATCH-CHANGED-001",
                "level": "PASS",
                "msg": f"changed_files 一致 ({len(artifact_changed)} files)",
            })

    # --- untracked_files の照合 ---
    artifact_untracked = set(fm.get("untracked_files", []) or [])
    rc, ls_output = run_git(["ls-files", "--others", "--exclude-standard"])
    if rc != 0:
        results.append({
            "id": "G-REDISPATCH-UNTRACKED-001",
            "level": "FAIL",
            "msg": "git ls-files --others --exclude-standard が失敗しました",
        })
        fail = True
    else:
        actual_untracked = set(ls_output.splitlines()) if ls_output else set()
        only_in_artifact_u = artifact_untracked - actual_untracked
        only_in_tree_u = actual_untracked - artifact_untracked
        if only_in_artifact_u or only_in_tree_u:
            msg_parts = []
            if only_in_artifact_u:
                msg_parts.append(f"artifact にあるが tree にない: {sorted(only_in_artifact_u)}")
            if only_in_tree_u:
                msg_parts.append(f"tree にあるが artifact にない: {sorted(only_in_tree_u)}")
            results.append({
                "id": "G-REDISPATCH-UNTRACKED-002",
                "level": "FAIL",
                "msg": f"untracked_files 不一致: {'; '.join(msg_parts)}",
            })
            fail = True
        else:
            results.append({
                "id": "G-REDISPATCH-UNTRACKED-001",
                "level": "PASS",
                "msg": f"untracked_files 一致 ({len(artifact_untracked)} files)",
            })

    if not fail:
        results.append({
            "id": "G-REDISPATCH-ALL",
            "level": "PASS",
            "msg": f"復元差分照合通過 (base={base_sha[:8]})",
        })

    _print_results(filepath, results, json_mode)
    return 1 if fail else 0


def _print_results(filepath, results, json_mode):
    if json_mode:
        print(json.dumps({"file": filepath, "checks": results}, ensure_ascii=False))
    else:
        print(f"--- {filepath} ---")
        for r in results:
            print(f"  [{r['level']}] {r['msg']} ({r['id']})")


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    json_mode = "--format=json" in sys.argv

    if not args:
        print("FATAL: artifact ファイルパスを指定してください。")
        print("用法: gate-redispatch.py <artifact-file> [--format=json]")
        sys.exit(2)

    worst = 0
    for filepath in args:
        rc = check_redispatch(filepath, json_mode)
        worst = max(worst, rc)

    if not json_mode:
        label = {0: "PASS", 1: "FAIL", 2: "FATAL"}.get(worst, "UNKNOWN")
        print(f"=== redispatch gate: {label} ===")
    sys.exit(worst)


if __name__ == "__main__":
    main()
