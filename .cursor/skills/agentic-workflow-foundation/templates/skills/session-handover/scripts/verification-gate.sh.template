#!/usr/bin/env bash
set -u

echo "=== verification gate ==="
PROFILE="{{project.quality_gate.profile}}"
echo "quality gate profile: $PROFILE"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../../../.." && pwd)"

case "$PROFILE" in
  foundation) exec "$ROOT_DIR/bin/foundation-gate" self ;;
  application) exec "$ROOT_DIR/bin/quality-gate" verify ;;
  *) echo "ERROR: unknown project.quality_gate.profile: $PROFILE" >&2; exit 2 ;;
esac
