#!/usr/bin/env bash
set -u

echo "=== verification gate ==="
echo "session.verification.gate_command: {{session.verification.gate_command}}"

cmd="{{session.verification.gate_command}}"
if [[ -z "$cmd" || "$cmd" == \[* ]]; then
  echo "WARN: verification gate command is not configured; update parent manifest.yaml > session.verification.gate_command."
  exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../../../.." && pwd)"

if [[ -x "$ROOT_DIR/$cmd" || "$cmd" == bin/quality-gate* ]]; then
  "$ROOT_DIR/$cmd"
else
  bash -lc "$cmd"
fi
