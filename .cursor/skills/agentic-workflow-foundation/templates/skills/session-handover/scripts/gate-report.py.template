#!/usr/bin/env python3
# gate-report.py  [generated by agentic-workflow-foundation skill]
# タスクレポート（docs/agent-tasks/reports/*.md）の構造を機械検査する。
# 仕様: docs/QUALITY_GATE.md §1.7（ワークフローゲートディスパッチャー step2-report）
# 用法: gate-report.py [report-file ...] [--format=json]
#   report-file を指定しない場合は docs/agent-tasks/reports/ 直下の全 .md を検査
# 出力: 人間可読の [PASS|WARN|FAIL] 名称 (CODE)、--format=json 時は JSON
# exit: 0 = PASS / 1 = FAIL（要対応）/ 2 = 致命的エラー
# 設計: archive-gate.sh / plan-gate.sh と同クラスの軽量ゲート（Python 3 標準ライブラリのみ）
#
# === report gate ===

import json
import os
import re
import sys
from pathlib import Path

REQUIRED_SECTIONS = [
    "タスクの概要",
    "問題・要件の詳細",
    "原因・背景",
    "影響範囲",
    "実装方針",
    "コード変更の詳細",
    "テスト計画",
    "関連する既存コード",
    "追加調査が必要な項目",
    "完了チェック",
]

COMPLETION_ITEMS = [
    "実装完了",
    "テスト完了",
    "コードゲート通過",
    "PRレビュー検証完了",
    "maintenance-docs/ 起票判定",
    "ADR 起票判定",
]

TICKET_SERVICE = "{{agent_workflow.ticket.service}}"
TICKET_FORMAT = r"{{agent_workflow.ticket.format}}"


def check_report(filepath: str) -> dict:
    """単一レポートを検査し結果 dict を返す。"""
    results = {"file": filepath, "checks": [], "fail": False, "fatal": False}

    if not os.path.isfile(filepath):
        results["fatal"] = True
        results["checks"].append({
            "id": "FATAL",
            "status": "FATAL",
            "message": f"ファイルが存在しません: {filepath}",
        })
        return results

    with open(filepath, encoding="utf-8") as f:
        content = f.read()

    lines = content.splitlines()

    # --- G-REPORT-SECTION-001: 必須 10 セクション見出しの存在チェック (FAIL) ---
    missing = []
    for sec in REQUIRED_SECTIONS:
        if sec not in content:
            missing.append(sec)

    if missing:
        results["fail"] = True
        results["checks"].append({
            "id": "G-REPORT-SECTION-001",
            "status": "FAIL",
            "message": f"必須セクション欠落: {', '.join(missing)}",
            "missing": missing,
        })
    else:
        results["checks"].append({
            "id": "G-REPORT-SECTION-001",
            "status": "PASS",
            "message": f"必須セクション全{len(REQUIRED_SECTIONS)}件充足",
        })

    # --- G-REPORT-PLACEHOLDER-001: {XXX} プレースホルダ残存チェック (WARN) ---
    placeholder_pattern = re.compile(r"\{[A-Z][A-Za-z_]+\}")
    placeholders_found = []
    for i, line in enumerate(lines, 1):
        for m in placeholder_pattern.finditer(line):
            placeholders_found.append(f"L{i}: {m.group()}")

    if placeholders_found:
        results["checks"].append({
            "id": "G-REPORT-PLACEHOLDER-001",
            "status": "WARN",
            "message": f"プレースホルダ残存 {len(placeholders_found)} 件",
            "details": placeholders_found[:20],
        })
    else:
        results["checks"].append({
            "id": "G-REPORT-PLACEHOLDER-001",
            "status": "PASS",
            "message": "プレースホルダなし",
        })

    # --- G-REPORT-COMPLETION-001: 完了チェック 6 項目が [ ] で存在するか (WARN) ---
    missing_items = []
    for item in COMPLETION_ITEMS:
        pattern = re.compile(r"^\s*-\s*\[[ x]\].*" + re.escape(item), re.MULTILINE)
        if not pattern.search(content):
            missing_items.append(item)

    if missing_items:
        results["checks"].append({
            "id": "G-REPORT-COMPLETION-001",
            "status": "WARN",
            "message": f"完了チェック項目欠落: {', '.join(missing_items)}",
            "missing": missing_items,
        })
    else:
        results["checks"].append({
            "id": "G-REPORT-COMPLETION-001",
            "status": "PASS",
            "message": f"完了チェック全{len(COMPLETION_ITEMS)}項目存在",
        })

{{#if requirement_analysis.enabled}}
    # --- G-REPORT-RA-AC-001: 受入条件サブ構造（AC-NNN:）の存在チェック (FAIL) ---
    ac_heading_found = "受入条件" in content
    ac_pattern = re.compile(r"^AC-(\d{3}):\s*\S", re.MULTILINE)
    ac_matches = ac_pattern.findall(content)

    if not ac_heading_found:
        results["fail"] = True
        results["checks"].append({
            "id": "G-REPORT-RA-AC-001",
            "status": "FAIL",
            "message": "「受入条件」見出しがレポートに存在しません",
        })
    elif len(ac_matches) == 0:
        results["fail"] = True
        results["checks"].append({
            "id": "G-REPORT-RA-AC-001",
            "status": "FAIL",
            "message": "受入条件セクションに AC-NNN: 定義が 0 件です（1件以上必須）",
        })
    elif len(ac_matches) != len(set(ac_matches)):
        results["fail"] = True
        results["checks"].append({
            "id": "G-REPORT-RA-AC-001",
            "status": "FAIL",
            "message": "受入条件セクションに重複する AC-NNN 定義があります",
        })
    else:
        results["checks"].append({
            "id": "G-REPORT-RA-AC-001",
            "status": "PASS",
            "message": f"受入条件 AC-ID {len(ac_matches)} 件充足",
        })

    # --- G-REPORT-RA-DIGEST-001: requirements_digest 転記チェック (FAIL) ---
    digest_pattern = re.compile(r"requirements_digest.*:\s*[0-9a-f]{16,}", re.IGNORECASE)
    if not digest_pattern.search(content):
        results["fail"] = True
        results["checks"].append({
            "id": "G-REPORT-RA-DIGEST-001",
            "status": "FAIL",
            "message": "requirements_digest（SHA-256）がレポートに転記されていません",
        })
    else:
        results["checks"].append({
            "id": "G-REPORT-RA-DIGEST-001",
            "status": "PASS",
            "message": "requirements_digest 転記あり",
        })

{{/if}}
    # --- G-REPORT-TICKET-001: チケットリンクの形式チェック (WARN) ---
    if TICKET_SERVICE and TICKET_FORMAT:
        ticket_section = ""
        for i, line in enumerate(lines):
            if "関連チケット" in line or "関連 ticket" in line.lower():
                ticket_section = line
                break
        if ticket_section:
            if "なし" not in ticket_section:
                ticket_re = re.compile(TICKET_FORMAT)
                if not ticket_re.search(ticket_section):
                    results["checks"].append({
                        "id": "G-REPORT-TICKET-001",
                        "status": "WARN",
                        "message": f"チケットリンクが {TICKET_SERVICE} の形式({TICKET_FORMAT})に合致しない",
                    })

    return results


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    json_mode = "--format=json" in sys.argv

    project_dir = os.environ.get("CURSOR_PROJECT_DIR", os.getcwd())
    reports_dir = os.path.join(project_dir, "docs", "agent-tasks", "reports")

    if not json_mode:
        print("=== report gate ===")

    targets = []
    if args:
        for a in args:
            p = a if os.path.isabs(a) else os.path.join(project_dir, a)
            targets.append(p)
    else:
        if not os.path.isdir(reports_dir):
            msg = f"FATAL: reports ディレクトリが存在しません: {reports_dir}"
            if json_mode:
                print(json.dumps({"fatal": True, "message": msg}))
            else:
                print(msg)
            sys.exit(2)
        for f in sorted(Path(reports_dir).glob("*.md")):
            if f.is_file() and not f.name.endswith("-review.md"):
                targets.append(str(f))

    if not targets:
        msg = "reports/ 直下にレポートなし"
        if json_mode:
            print(json.dumps({"status": "PASS", "message": msg, "results": []}))
        else:
            print(f"[PASS] {msg}")
        sys.exit(0)

    all_results = []
    overall_fail = False
    overall_fatal = False

    for t in targets:
        result = check_report(t)
        all_results.append(result)
        if result["fatal"]:
            overall_fatal = True
        if result["fail"]:
            overall_fail = True

        if not json_mode:
            print(f"--- {result['file']} ---")
            for c in result["checks"]:
                print(f"[{c['status']}] {c['message']} ({c['id']})")
                if c.get("missing"):
                    for m in c["missing"]:
                        print(f"  - 欠落: {m}")
                if c.get("details"):
                    for d in c["details"]:
                        print(f"  - {d}")

    if json_mode:
        status = "FATAL" if overall_fatal else ("FAIL" if overall_fail else "PASS")
        print(json.dumps({"status": status, "results": all_results}, ensure_ascii=False))
    else:
        if overall_fatal:
            print("=== report gate: FATAL ===")
        elif overall_fail:
            print("=== report gate: FAIL ===")
        else:
            print("=== report gate: PASS ===")

    if overall_fatal:
        sys.exit(2)
    if overall_fail:
        sys.exit(1)
    sys.exit(0)


if __name__ == "__main__":
    main()
