#!/usr/bin/env python3
from __future__ import annotations

# gate-report.py  [generated by agentic-workflow-foundation skill]
# タスクレポート（docs/agent-tasks/reports/*.md）の構造を機械検査する。
# 仕様: docs/QUALITY_GATE.md §1.7（ワークフローゲートディスパッチャー step2-report）
# 用法: gate-report.py [report-file ...] [--format=json]
#   report-file を指定しない場合は docs/agent-tasks/reports/ 直下の全 .md を検査
# 出力: 人間可読の [PASS|WARN|FAIL] 名称 (CODE)、--format=json 時は JSON
# exit: 0 = PASS / 1 = FAIL（要対応）/ 2 = 致命的エラー
# 設計: archive-gate.sh / plan-gate.sh と同クラスの軽量ゲート（Python 3 標準ライブラリのみ）
#
# === report gate ===

import json
import os
import re
import sys
from pathlib import Path

from domain_doc_scope import POLICY_ENABLED, classify_path

REQUIRED_SECTIONS = [
    "タスクの概要",
    "問題・要件の詳細",
    "原因・背景",
    "影響範囲",
    "実装方針",
    "コード変更の詳細",
    "テスト計画",
    "関連する既存コード",
    "追加調査が必要な項目",
    "完了チェック",
]

COMPLETION_ITEMS = [
    "実装完了",
    "テスト完了",
    "コードゲート通過",
    "PRレビュー検証完了",
    "maintenance-docs/ 起票判定",
    "ADR 起票判定",
]

TICKET_SERVICE = "{{agent_workflow.ticket.service}}"
TICKET_FORMAT = r"{{agent_workflow.ticket.format}}"
WRITE_VERBS = re.compile(
    r"変更|更新|編集|追加|削除|書き込|修正|反映|置換"
    r"|\b(?:write|update|edit|modify|add|delete|replace)\b",
    re.IGNORECASE,
)
NEGATED_QUEUE = re.compile(r"起票(?:しない|不要)|queue(?:しない|不要)|作成(?:しない|不要)")
NEGATED_WORKFLOW = re.compile(
    r"maintenance-docs-workflow.{0,32}(?:(?:実施|反映|更新)しない|行わない|不要)"
)
QUEUE_HANDOFF = re.compile(r"maintenance-docs/.{0,32}(?:queue.{0,16})?(?:起票|作成|登録)")
WORKFLOW_HANDOFF = re.compile(
    r"maintenance-docs-workflow.{0,32}(?:実施|反映|更新)"
)


def _section(content: str, title: str) -> str:
    match = re.search(
        rf"^##\s+(?:\d+\.\s+)?{re.escape(title)}\s*$\n(.*?)(?=^##\s|\Z)",
        content,
        re.MULTILINE | re.DOTALL,
    )
    return match.group(1) if match else ""


def _doc_scope_checks(content: str) -> list[str]:
    """Step②の書込み意図だけを検査し、§8の docs-first 読取りは対象外にする。"""
    if not POLICY_ENABLED:
        return []
    failures: list[str] = []
    changes = _section(content, "コード変更の詳細")
    for line in changes.splitlines():
        if not line.lstrip().startswith("|") or re.match(r"^[\s|:-]+$", line):
            continue
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) < 3 or cells[0] == "変更対象ファイル":
            continue
        matched, normalized, error = classify_path(cells[0])
        if error:
            failures.append(f"§6 の変更対象セルが曖昧: {cells[0]} ({error})")
        elif matched:
            failures.append(f"§6 に Domain docs の直接変更対象: {normalized}")

    plan = _section(content, "実装方針")
    for line in plan.splitlines():
        if "参照ドキュメント" in line:
            continue
        for raw in re.findall(r"`[^`]+`|\[[^\]]+\]\([^)]+\)|(?:\./)?docs/[A-Za-z0-9_./-]+", line):
            matched, normalized, error = classify_path(raw)
            if error:
                continue
            if matched and WRITE_VERBS.search(line):
                failures.append(f"§5 が Domain docs を直接書込み対象にしている: {normalized}")

    requirements = _section(content, "問題・要件の詳細")
    ac = re.search(r"^###\s+受入条件\s*$\n(.*?)(?=^#{1,3}\s|\Z)", requirements, re.MULTILINE | re.DOTALL)
    if ac:
        for item in re.findall(r"^[ \t]*[-*][ \t]*(AC-\d{3}:.*)$", ac.group(1), re.MULTILINE):
            paths = re.findall(r"`[^`]+`|\[[^\]]+\]\([^)]+\)|(?:\./)?docs/[A-Za-z0-9_./-]+", item)
            if not paths:
                continue
            has_domain = any(classify_path(raw)[0] for raw in paths)
            if not has_domain:
                continue
            if NEGATED_QUEUE.search(item) or NEGATED_WORKFLOW.search(item):
                failures.append(f"AC の queue/後続workflow が否定されています: {item}")
                continue
            has_handoff = bool(QUEUE_HANDOFF.search(item) or WORKFLOW_HANDOFF.search(item))
            if not has_handoff:
                failures.append(f"AC の Domain docs 成果に queue/後続workflow の明記なし: {item}")
    return failures


def _load_step1_requirements_digest(filepath: str | None) -> str | None:
    """Step1 envelope front matter から requirements_digest を取得する。"""
    if not filepath or not os.path.isfile(filepath):
        return None
    text = Path(filepath).read_text(encoding="utf-8")
    fm_match = re.match(r"^---\s*\n(.*?)\n---\s*\n", text, re.DOTALL)
    if not fm_match:
        return None
    digest_match = re.search(
        r"""^requirements_digest:[ \t]*["']?([0-9a-f]{64})["']?[ \t]*$""",
        fm_match.group(1),
        re.IGNORECASE | re.MULTILINE,
    )
    return digest_match.group(1) if digest_match else None


def _load_step1_campaign_slug(filepath: str | None) -> str | None:
    """Step1 envelope の campaign_slug と filename prefix を standalone でも照合する。"""
    if not filepath or not os.path.isfile(filepath):
        return None
    path = Path(filepath)
    match = re.match(r"^(.+?)--step1(?:-[^.]+)?\.md$", path.name)
    if not match:
        return None
    text = path.read_text(encoding="utf-8")
    fm_match = re.match(r"^---\s*\n(.*?)\n---\s*\n", text, re.DOTALL)
    if not fm_match:
        return None
    slug_match = re.search(
        r"""^campaign_slug:[ \t]*["']?(.+?)["']?[ \t]*$""",
        fm_match.group(1),
        re.MULTILINE,
    )
    slug = slug_match.group(1).strip() if slug_match else ""
    return slug if slug == match.group(1) else None


def check_report(
    filepath: str,
    step1_envelope_path: str | None = None,
) -> dict:
    """単一レポートを検査し結果 dict を返す。"""
    results = {"file": filepath, "checks": [], "fail": False, "fatal": False}

    if not os.path.isfile(filepath):
        results["fatal"] = True
        results["checks"].append({
            "id": "FATAL",
            "status": "FATAL",
            "message": f"ファイルが存在しません: {filepath}",
        })
        return results

    with open(filepath, encoding="utf-8") as f:
        content = f.read()

    lines = content.splitlines()

    # --- G-REPORT-CAMPAIGN-SLUG-001: report stem と Step1 campaign_slug binding ---
    campaign_slug = _load_step1_campaign_slug(step1_envelope_path)
    if campaign_slug is None:
        results["fail"] = True
        results["checks"].append({
            "id": "G-REPORT-CAMPAIGN-SLUG-001",
            "status": "FAIL",
            "message": "Step1 envelope の campaign_slug または filename prefix を検証できません",
        })
    elif Path(filepath).stem != campaign_slug:
        results["fail"] = True
        results["checks"].append({
            "id": "G-REPORT-CAMPAIGN-SLUG-001",
            "status": "FAIL",
            "message": "report basename が Step1 campaign_slug と一致しません",
        })
    else:
        results["checks"].append({
            "id": "G-REPORT-CAMPAIGN-SLUG-001",
            "status": "PASS",
            "message": "report basename と Step1 campaign_slug が一致",
        })

    # --- G-REPORT-SECTION-001: 必須 10 セクション見出しの存在チェック (FAIL) ---
    missing = []
    for sec in REQUIRED_SECTIONS:
        if sec not in content:
            missing.append(sec)

    if missing:
        results["fail"] = True
        results["checks"].append({
            "id": "G-REPORT-SECTION-001",
            "status": "FAIL",
            "message": f"必須セクション欠落: {', '.join(missing)}",
            "missing": missing,
        })
    else:
        results["checks"].append({
            "id": "G-REPORT-SECTION-001",
            "status": "PASS",
            "message": f"必須セクション全{len(REQUIRED_SECTIONS)}件充足",
        })

    # --- G-REPORT-PLACEHOLDER-001: {XXX} プレースホルダ残存チェック (WARN) ---
    placeholder_pattern = re.compile(r"\{[A-Z][A-Za-z_]+\}")
    placeholders_found = []
    for i, line in enumerate(lines, 1):
        for m in placeholder_pattern.finditer(line):
            placeholders_found.append(f"L{i}: {m.group()}")

    if placeholders_found:
        results["checks"].append({
            "id": "G-REPORT-PLACEHOLDER-001",
            "status": "WARN",
            "message": f"プレースホルダ残存 {len(placeholders_found)} 件",
            "details": placeholders_found[:20],
        })
    else:
        results["checks"].append({
            "id": "G-REPORT-PLACEHOLDER-001",
            "status": "PASS",
            "message": "プレースホルダなし",
        })

    # --- G-REPORT-COMPLETION-001: 完了チェック 6 項目が [ ] で存在するか (WARN) ---
    missing_items = []
    for item in COMPLETION_ITEMS:
        pattern = re.compile(r"^\s*-\s*\[[ x]\].*" + re.escape(item), re.MULTILINE)
        if not pattern.search(content):
            missing_items.append(item)

    if missing_items:
        results["checks"].append({
            "id": "G-REPORT-COMPLETION-001",
            "status": "WARN",
            "message": f"完了チェック項目欠落: {', '.join(missing_items)}",
            "missing": missing_items,
        })
    else:
        results["checks"].append({
            "id": "G-REPORT-COMPLETION-001",
            "status": "PASS",
            "message": f"完了チェック全{len(COMPLETION_ITEMS)}項目存在",
        })

    # --- G-REPORT-DOC-SCOPE-001: Domain docs の直接書込み意図を拒否 ---
    scope_failures = _doc_scope_checks(content)
    if scope_failures:
        results["fail"] = True
        results["checks"].append({
            "id": "G-REPORT-DOC-SCOPE-001",
            "status": "FAIL",
            "message": "; ".join(scope_failures),
        })
    elif POLICY_ENABLED:
        results["checks"].append({
            "id": "G-REPORT-DOC-SCOPE-001",
            "status": "PASS",
            "message": "Domain docs の直接書込み意図なし",
        })

{{#if requirement_analysis.enabled}}
    # --- G-REPORT-RA-AC-001: 受入条件サブ構造（AC-NNN:）の存在チェック (FAIL) ---
    ac_section_match = re.search(
        r"^###[ \t]+受入条件[ \t]*$\n(.*?)(?=^#{1,3}[ \t]+|\Z)",
        content,
        re.DOTALL | re.MULTILINE,
    )
    ac_section = ac_section_match.group(1) if ac_section_match else ""
    ac_pattern = re.compile(
        r"^[ \t]*[-*]?[ \t]*AC-(\d{3}):[ \t]*\S",
        re.MULTILINE,
    )
    ac_matches = ac_pattern.findall(ac_section)

    if ac_section_match is None:
        results["fail"] = True
        results["checks"].append({
            "id": "G-REPORT-RA-AC-001",
            "status": "FAIL",
            "message": "「受入条件」見出しがレポートに存在しません",
        })
    elif len(ac_matches) == 0:
        results["fail"] = True
        results["checks"].append({
            "id": "G-REPORT-RA-AC-001",
            "status": "FAIL",
            "message": "受入条件セクションに AC-NNN: 定義が 0 件です（1件以上必須）",
        })
    elif len(ac_matches) != len(set(ac_matches)):
        results["fail"] = True
        results["checks"].append({
            "id": "G-REPORT-RA-AC-001",
            "status": "FAIL",
            "message": "受入条件セクションに重複する AC-NNN 定義があります",
        })
    else:
        results["checks"].append({
            "id": "G-REPORT-RA-AC-001",
            "status": "PASS",
            "message": f"受入条件 AC-ID {len(ac_matches)} 件充足",
        })

    # --- G-REPORT-RA-DIGEST-001: requirements_digest 転記チェック (FAIL) ---
    digest_pattern = re.compile(
        r"""^[^\n]*requirements_digest[^\n:]*:[ \t]*["']?([0-9a-f]{64})["']?[ \t]*$""",
        re.IGNORECASE | re.MULTILINE,
    )
    digest_match = digest_pattern.search(content)
    expected_digest = _load_step1_requirements_digest(step1_envelope_path)
    if digest_match is None:
        results["fail"] = True
        results["checks"].append({
            "id": "G-REPORT-RA-DIGEST-001",
            "status": "FAIL",
            "message": "レポートの requirements_digest が欠落、または64桁のSHA-256 hex形式ではありません",
        })
    elif expected_digest is None:
        results["fail"] = True
        results["checks"].append({
            "id": "G-REPORT-RA-DIGEST-001",
            "status": "FAIL",
            "message": f"Step1 envelope から requirements_digest を取得できません: {step1_envelope_path!r}",
        })
    elif (
        not isinstance(digest_match.group(1), str)
        or not isinstance(expected_digest, str)
        or digest_match.group(1).casefold() != expected_digest.casefold()
    ):
        results["fail"] = True
        results["checks"].append({
            "id": "G-REPORT-RA-DIGEST-001",
            "status": "FAIL",
            "message": "レポートの requirements_digest が Step1 envelope と一致しません",
        })
    else:
        results["checks"].append({
            "id": "G-REPORT-RA-DIGEST-001",
            "status": "PASS",
            "message": "requirements_digest が Step1 envelope と完全一致",
        })

{{/if}}
    # --- G-REPORT-TICKET-001: チケットリンクの形式チェック (WARN) ---
    if TICKET_SERVICE and TICKET_FORMAT:
        ticket_section = ""
        for i, line in enumerate(lines):
            if "関連チケット" in line or "関連 ticket" in line.lower():
                ticket_section = line
                break
        if ticket_section:
            if "なし" not in ticket_section:
                ticket_re = re.compile(TICKET_FORMAT)
                if not ticket_re.search(ticket_section):
                    results["checks"].append({
                        "id": "G-REPORT-TICKET-001",
                        "status": "WARN",
                        "message": f"チケットリンクが {TICKET_SERVICE} の形式({TICKET_FORMAT})に合致しない",
                    })

    return results


def main():
    project_dir = os.environ.get("CURSOR_PROJECT_DIR", os.getcwd())
    raw_args = sys.argv[1:]
    args = []
    json_mode = False
    artifact_dir = os.path.join(
        project_dir, "{{agent_workflow.artifact.dir}}"
    )
    i = 0
    while i < len(raw_args):
        arg = raw_args[i]
        if arg == "--format=json":
            json_mode = True
            i += 1
        elif arg == "--artifact-dir":
            if i + 1 >= len(raw_args) or raw_args[i + 1].startswith("--"):
                print("FATAL: --artifact-dir に値が必要です")
                sys.exit(2)
            artifact_dir = raw_args[i + 1]
            i += 2
        elif arg.startswith("--"):
            i += 1
        else:
            args.append(arg)
            i += 1

    reports_dir = os.path.join(project_dir, "docs", "agent-tasks", "reports")

    if not json_mode:
        print("=== report gate ===")

    targets = []
    if args:
        for a in args:
            p = a if os.path.isabs(a) else os.path.join(project_dir, a)
            targets.append(p)
    else:
        if not os.path.isdir(reports_dir):
            msg = f"FATAL: reports ディレクトリが存在しません: {reports_dir}"
            if json_mode:
                print(json.dumps({"fatal": True, "message": msg}))
            else:
                print(msg)
            sys.exit(2)
        for f in sorted(Path(reports_dir).glob("*.md")):
            if f.is_file() and not f.name.endswith("-review.md"):
                targets.append(str(f))

    if not targets:
        msg = "reports/ 直下にレポートなし"
        if json_mode:
            print(json.dumps({"status": "PASS", "message": msg, "results": []}))
        else:
            print(f"[PASS] {msg}")
        sys.exit(0)

    all_results = []
    overall_fail = False
    overall_fatal = False

    for t in targets:
        slug = Path(t).stem
        step1_envelope_path = os.path.join(
            artifact_dir, f"{slug}--step1.md"
        )
        result = check_report(t, step1_envelope_path)
        all_results.append(result)
        if result["fatal"]:
            overall_fatal = True
        if result["fail"]:
            overall_fail = True

        if not json_mode:
            print(f"--- {result['file']} ---")
            for c in result["checks"]:
                print(f"[{c['status']}] {c['message']} ({c['id']})")
                if c.get("missing"):
                    for m in c["missing"]:
                        print(f"  - 欠落: {m}")
                if c.get("details"):
                    for d in c["details"]:
                        print(f"  - {d}")

    if json_mode:
        status = "FATAL" if overall_fatal else ("FAIL" if overall_fail else "PASS")
        print(json.dumps({"status": status, "results": all_results}, ensure_ascii=False))
    else:
        if overall_fatal:
            print("=== report gate: FATAL ===")
        elif overall_fail:
            print("=== report gate: FAIL ===")
        else:
            print("=== report gate: PASS ===")

    if overall_fatal:
        sys.exit(2)
    if overall_fail:
        sys.exit(1)
    sys.exit(0)


if __name__ == "__main__":
    main()
