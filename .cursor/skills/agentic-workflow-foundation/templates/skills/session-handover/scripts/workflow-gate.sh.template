#!/usr/bin/env bash
# workflow-gate.sh  [generated by agentic-workflow-foundation skill]
# workflow-orchestrator フェーズ境界ゲートの統一ディスパッチャー。
# 仕様: docs/QUALITY_GATE.md §1.7（ワークフローゲートディスパッチャー）/ §3（フェーズ境界）
# 用法: workflow-gate.sh <step2|step2-report|step4|step5|step6|adr|archive> [args...]
#   step2        = ②→③ 計画→実装境界（plan-gate.sh report）
#   step2-report = ② レポート構造検査（必須10セクション充足）
#   step4        = ④ 実装→検証（コードゲート: gen/build/lint/test）
#   step5        = ④→⑤ 検証→PR（verification-gate.sh）
#   step6        = ⑤→⑥ PR→完了（plan-gate.sh review）
#   adr          = ADR 起票内容の機械検査（gate-adr.py）
#   archive      = ⑥ 完了チェック6項目検査（archive-gate.sh）
# exit: 0 = PASS / 1 = FAIL（要対応）/ 2 = 致命的エラー
# 設計: tech stack 由来のコマンドは manifest.yaml > project.quality_gate から
#        テンプレート展開時に焼き込まれる。tech stack 差し替え時は再生成で対応する。
set -u

STEP="${1:-}"
shift || true
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# --format=json が残余引数に含まれる場合はヘッダを stderr へ出力
if printf '%s\n' "$@" | grep -q -- '--format=json' 2>/dev/null; then
  echo "=== workflow gate === (step=$STEP)" >&2
else
  echo "=== workflow gate === (step=$STEP)"
fi

if [[ -z "$STEP" ]]; then
  echo "FATAL: ステップ引数が必要です。"
  echo "用法: workflow-gate.sh <step2|step2-report|step4|step5|step6|adr|archive> [args...]"
  echo ""
  echo "利用可能なステップ:"
{{#each agent_workflow.step_gates}}
  echo "  {{this.id}}  — {{this.desc}}"
{{/each}}
  exit 2
fi

case "$STEP" in
  step2)
    # ②→③ 計画→実装境界: 追跡ドキュメントの必須セクション充足を検査
    exec "$SCRIPT_DIR/plan-gate.sh" report
    ;;
  step2-report)
    # ② レポート構造検査: 必須10セクション / プレースホルダ / 完了チェック初期状態
    exec python3 "$SCRIPT_DIR/gate-report.py" "$@"
    ;;
  step4)
    # ④ コードゲート（決定 10: G-GEN パス限定 porcelain チェック）
    # 順序: gen 対象変更検出 → 必要時だけ gen → 対象パスだけ porcelain 検査 → build/lint/test
    echo "--- code gate (tech stack: manifest.yaml > project.quality_gate) ---"

    {{#if project.quality_gate.gen_artifact_paths}}
    # --- G-GEN: 生成対象パス限定 porcelain チェック ---
    GEN_PATHS=({{#each project.quality_gate.gen_artifact_paths}} "{{this}}"{{/each}} )

    # gen 対象に変更があるか検出（staged + unstaged）
    GEN_DIRTY=$(git diff --name-only -- "${GEN_PATHS[@]}" 2>/dev/null || true)
    GEN_DIRTY_CACHED=$(git diff --cached --name-only -- "${GEN_PATHS[@]}" 2>/dev/null || true)

    if [[ -n "$GEN_DIRTY" || -n "$GEN_DIRTY_CACHED" ]]; then
      echo "--- G-GEN: gen 対象に変更あり → gen 実行 ---"
      bash -lc "{{project.quality_gate.gen_cmd}}"
      GEN_EXIT=$?
      if [[ $GEN_EXIT -ne 0 ]]; then
        echo "FAIL: {{project.quality_gate.gen_cmd}} が exit $GEN_EXIT で失敗"
        exit 1
      fi
      # gen 後の porcelain 検査（対象パスのみ）
      GEN_STATUS=$(git status --porcelain -- "${GEN_PATHS[@]}" 2>/dev/null || true)
      if [[ -n "$GEN_STATUS" ]]; then
        echo "FAIL: G-GEN — gen 実行後に未コミットの生成物差分あり:"
        echo "$GEN_STATUS"
        echo "生成物をコミットしてから再実行してください。"
        exit 1
      fi
      echo "PASS: G-GEN — 生成物は最新（差分なし）"
    else
      echo "SKIP: G-GEN — gen 対象に変更なし（build/lint/test のみ実行）"
    fi
    {{else}}
    # gen_artifact_paths 未定義: 安全側 exit 2（全体差分フォールバック禁止）
    echo "FATAL: project.quality_gate.gen_artifact_paths が manifest.yaml に未定義です。"
    echo "gen 対象パスを定義するか、空リストで gen スキップを明示してください。"
    exit 2
    {{/if}}

    # --- build / lint / test ---
    echo "--- build / lint / test ---"
    bash -lc "{{project.quality_gate.build_cmd}} && {{project.quality_gate.lint_cmd}} && {{project.quality_gate.test_cmd}}"
    ;;
  step5)
    # ④→⑤ 検証→PR: verification-gate.sh（session.verification.gate_command）
    exec "$SCRIPT_DIR/verification-gate.sh"
    ;;
  step6)
    # ⑤→⑥ PR→完了: レビュー完了承認 + 未対応0件を検査
    exec "$SCRIPT_DIR/plan-gate.sh" review
    ;;
  adr)
    # ADR 起票内容の機械検査（docs/DECISIONS.md）
    exec python3 "$SCRIPT_DIR/gate-adr.py" "$@"
    ;;
  artifact)
    # Worker artifact envelope 検査（gate-artifact.py）
    exec python3 "$SCRIPT_DIR/gate-artifact.py" "$@"
    ;;
  redispatch)
    # re-dispatch 前の復元差分照合（gate-redispatch.py）
    exec python3 "$SCRIPT_DIR/gate-redispatch.py" "$@"
    ;;
  archive)
    # ⑥ 完了チェック6項目 + 残存 partial artifact 検査
    if [[ -n "${1:-}" ]]; then
      exec "$SCRIPT_DIR/archive-gate.sh" "$1"
    else
      exec "$SCRIPT_DIR/archive-gate.sh"
    fi
    ;;
  *)
    echo "FATAL: 不明なステップ '$STEP'。"
    echo "利用可能: step2 | step2-report | step4 | step5 | step6 | adr | archive"
    exit 2
    ;;
esac
