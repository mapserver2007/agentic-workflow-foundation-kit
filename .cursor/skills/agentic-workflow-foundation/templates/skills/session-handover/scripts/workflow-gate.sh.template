#!/usr/bin/env bash
# workflow-gate.sh  [generated by agentic-workflow-foundation skill]
# workflow-orchestrator フェーズ境界ゲートの統一ディスパッチャー。
# 仕様: docs/QUALITY_GATE.md §1.7（ワークフローゲートディスパッチャー）/ §3（フェーズ境界）
# 用法: workflow-gate.sh <step1|step2|step2-report|step4|step5|step6|adr|artifact|redispatch|maintenance-docs|archive> [args...]
#   step1        = ①→② 調査→レポート境界（gate-artifact.py 拡張済み Step① schema）
#   step2        = ② 機械退出（追跡必須セクション充足。実装開始承認は扱わない）
#   step2-report = ② レポート構造・envelope検査（必須10セクション充足）
#   step4        = ④ 実装→検証（profile selector: foundation=self / application=G-*）
#   step5        = ④→⑤ 検証→PR（verification-gate.sh）
#   step6        = ⑤→⑥ PR→完了（plan-gate.sh review）
#   adr          = ADR 起票内容の機械検査（gate-adr.py）
#   archive      = ⑥ 完了チェック6項目検査（archive-gate.sh）
# exit: 0 = PASS / 1 = FAIL（要対応）/ 2 = 致命的エラー
# 設計: tech stack 由来のコマンドは manifest.yaml > project.quality_gate から
#        テンプレート展開時に焼き込まれる。tech stack 差し替え時は再生成で対応する。
set -u

STEP="${1:-}"
shift || true
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

JSON_MODE=0
EXPECT_FORMAT_VALUE=0
for arg in "$@"; do
  if [[ "$arg" == "--format=json" ]]; then
    JSON_MODE=1
  elif [[ "$EXPECT_FORMAT_VALUE" -eq 1 && "$arg" == "json" ]]; then
    JSON_MODE=1
    EXPECT_FORMAT_VALUE=0
  elif [[ "$arg" == "--format" ]]; then
    EXPECT_FORMAT_VALUE=1
  else
    EXPECT_FORMAT_VALUE=0
  fi
done

if [[ "$JSON_MODE" -eq 1 ]]; then
  echo "=== workflow gate === (step=$STEP)" >&2
else
  echo "=== workflow gate === (step=$STEP)"
fi

log() {
  if [[ "$JSON_MODE" -eq 1 ]]; then
    echo "$@" >&2
  else
    echo "$@"
  fi
}

run_logged() {
  if [[ "$JSON_MODE" -eq 1 ]]; then
    "$@" >&2
  else
    "$@"
  fi
}

if [[ -z "$STEP" ]]; then
  log "FATAL: ステップ引数が必要です。"
  log "用法: workflow-gate.sh <step1|step2|step2-report|step4|step5|step6|adr|artifact|redispatch|maintenance-docs|archive> [args...]"
  log ""
  log "利用可能なステップ:"
{{#each agent_workflow.step_gates}}
  log "  {{this.id}}  — {{this.desc}}"
{{/each}}
  exit 2
fi

case "$STEP" in
  step1)
    # ①→② 調査→レポート境界: gate-artifact.py（拡張済み Step① schema）
    exec python3 "$SCRIPT_DIR/gate-artifact.py" "$@"
    ;;
  step2)
    # ② 機械退出: 追跡ドキュメントの必須セクション充足を検査。PO承認は親 pre-dispatch の責務
    exec "$SCRIPT_DIR/plan-gate.sh" report
    ;;
  step2-report)
    # ② レポート構造検査: envelope 必須検査 → gate-report.py
    ROOT_DIR="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
    ARTIFACT_DIR="$ROOT_DIR/{{agent_workflow.artifact.dir}}"
    REPORTS_DIR="$ROOT_DIR/docs/agent-tasks/reports"

    # 対象レポートの決定
    if [[ -n "${1:-}" && "${1:-}" != --* ]]; then
      REPORT_FILES=("$1")
    else
      REPORT_FILES=()
      if [[ -d "$REPORTS_DIR" ]]; then
        for f in "$REPORTS_DIR"/*.md; do
          [[ -f "$f" ]] && REPORT_FILES+=("$f")
        done
      fi
    fi

    # レポートが 0 件なら envelope 検査をスキップして gate-report.py へ
    if [[ ${#REPORT_FILES[@]} -eq 0 ]]; then
      exec python3 "$SCRIPT_DIR/gate-report.py" --artifact-dir "$ARTIFACT_DIR" "$@"
    fi

    # レポートごとに step1/step2 envelope を検査
    ENVELOPE_FAIL=0
    for report_file in "${REPORT_FILES[@]}"; do
      slug="$(basename "$report_file" .md)"

      step1_env="$ARTIFACT_DIR/${slug}--step1.md"
      step2_env="$ARTIFACT_DIR/${slug}--step2.md"

      # step1 envelope 存在チェック
      if [[ ! -f "$step1_env" ]]; then
        echo "FAIL: step1 envelope が見つかりません: $step1_env"
        ENVELOPE_FAIL=1
        continue
      fi
      # step2 envelope 存在チェック
      if [[ ! -f "$step2_env" ]]; then
        echo "FAIL: step2 envelope が見つかりません: $step2_env"
        ENVELOPE_FAIL=1
        continue
      fi

      # step1 envelope 内容検査（step1 / complete）
      python3 "$SCRIPT_DIR/gate-artifact.py" "$step1_env" --expect-step step1 --expect-status complete
      rc=$?
      if [[ $rc -ne 0 ]]; then
        echo "FAIL: step1 envelope 検査失敗 (exit $rc): $step1_env"
        ENVELOPE_FAIL=1
        continue
      fi

      # step2 envelope 内容検査（step2 / complete）
      python3 "$SCRIPT_DIR/gate-artifact.py" "$step2_env" --expect-step step2 --expect-status complete
      rc=$?
      if [[ $rc -ne 0 ]]; then
        echo "FAIL: step2 envelope 検査失敗 (exit $rc): $step2_env"
        ENVELOPE_FAIL=1
        continue
      fi

      # step2 envelope の report_path がレポートと一致するか検査
      # front matter (先頭 --- 〜 ---) に限定して report_path を抽出する
      rp="$(python3 -c '
import re, sys
text = open(sys.argv[1], encoding="utf-8").read()
fm = re.match(r"^---\s*\n(.*?)\n---\s*\n", text, re.DOTALL)
block = fm.group(1) if fm else ""
m = re.search(r"^report_path:\s*(.+)", block, re.MULTILINE)
print(m.group(1).strip().strip("\"").strip("'"'"'") if m else "")
' "$step2_env")"
      # report_path を正規化して比較
      abs_report="$(cd "$(dirname "$report_file")" && pwd)/$(basename "$report_file")"
      if [[ -n "$rp" ]]; then
        if [[ "$rp" == /* ]]; then
          abs_rp="$rp"
        else
          abs_rp="$ROOT_DIR/$rp"
        fi
        # resolve symlinks for comparison
        real_report="$(python3 -c 'import sys; from pathlib import Path; print(Path(sys.argv[1]).resolve())' "$abs_report")"
        real_rp="$(python3 -c 'import sys; from pathlib import Path; print(Path(sys.argv[1]).resolve())' "$abs_rp")"
        if [[ "$real_report" != "$real_rp" ]]; then
          echo "FAIL: step2 envelope の report_path ($rp) がレポート ($report_file) と不一致"
          ENVELOPE_FAIL=1
        fi
      else
        echo "FAIL: step2 envelope に report_path フィールドが見つかりません: $step2_env"
        ENVELOPE_FAIL=1
      fi
    done

    if [[ $ENVELOPE_FAIL -ne 0 ]]; then
      echo "=== workflow gate step2-report: FAIL (envelope 検査失敗) ==="
      exit 1
    fi

    echo "PASS: step1/step2 envelope 検査通過"
    exec python3 "$SCRIPT_DIR/gate-report.py" --artifact-dir "$ARTIFACT_DIR" "$@"
    ;;
  step4)
    # ④ コードゲート + 完了チェック3項目 — profile selector が唯一の分岐入力
    # foundation: bin/foundation-gate self（kit 自己検証）
    # application: G-GEN パス限定 porcelain + bin/quality-gate verify
    ROOT_DIR="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
    ARTIFACT_DIR="$ROOT_DIR/{{agent_workflow.artifact.dir}}"
    REPORTS_DIR="$ROOT_DIR/docs/agent-tasks/reports"

    # --- report-file と gate-test の出力形式を解決 ---
    REPORT_ARG=""
    FORMAT_ARGS=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --format=json)
          JSON_MODE=1
          FORMAT_ARGS+=("$1")
          shift
          ;;
        --format)
          FORMAT_ARGS+=("$1")
          shift
          if [[ $# -eq 0 ]]; then
            log "FATAL: --format に値が必要です。"
            exit 2
          fi
          FORMAT_ARGS+=("$1")
          [[ "$1" == "json" ]] && JSON_MODE=1
          shift
          ;;
        --*)
          log "FATAL: step4 の未対応オプションです: $1"
          exit 2
          ;;
        *)
          if [[ -n "$REPORT_ARG" ]]; then
            log "FATAL: report-file は1件だけ指定できます。"
            exit 2
          fi
          REPORT_ARG="$1"
          shift
          ;;
      esac
    done

    # --- report-file の解決と Path.resolve 相当の正規化 ---
    if [[ -n "$REPORT_ARG" ]]; then
      REPORT_FILE="$(python3 -c '
import sys
from pathlib import Path

path = Path(sys.argv[1]).resolve()
if not path.is_file():
    raise SystemExit(1)
print(path)
' "$REPORT_ARG" 2>/dev/null)" || {
        log "FATAL: 実在するレポートファイルを指定してください: $REPORT_ARG"
        exit 2
      }
    else
      # reports 直下の進行中レポートから自動解決
      REPORT_FILES=()
      if [[ -d "$REPORTS_DIR" ]]; then
        for f in "$REPORTS_DIR"/*.md; do
          [[ -f "$f" ]] && REPORT_FILES+=("$f")
        done
      fi
      if [[ ${#REPORT_FILES[@]} -eq 0 ]]; then
        log "FATAL: 進行中レポートが 0 件です。report-file を明示的に指定してください。"
        log "用法: workflow-gate.sh step4 [report-file]"
        exit 2
      elif [[ ${#REPORT_FILES[@]} -gt 1 ]]; then
        log "FATAL: 進行中レポートが ${#REPORT_FILES[@]} 件あります。report-file を明示的に指定してください。"
        log "用法: workflow-gate.sh step4 [report-file]"
        for f in "${REPORT_FILES[@]}"; do log "  - $f"; done
        exit 2
      fi
      REPORT_FILE="$(python3 -c '
from pathlib import Path
print(Path(__import__("sys").argv[1]).resolve())
' "${REPORT_FILES[0]}")"
    fi
    REPORT_SLUG="$(basename "$REPORT_FILE" .md)"

    # --- step3/step4 envelope 必須検査 ---
    step3_env="$ARTIFACT_DIR/${REPORT_SLUG}--step3.md"
    step4_env="$ARTIFACT_DIR/${REPORT_SLUG}--step4.md"

    ENVELOPE_FAIL=0

    if [[ ! -f "$step3_env" ]]; then
      log "FAIL: step3 envelope が見つかりません: $step3_env"
      ENVELOPE_FAIL=1
    else
      run_logged python3 "$SCRIPT_DIR/gate-artifact.py" "$step3_env" --expect-step step3 --expect-status complete
      rc=$?
      if [[ $rc -ne 0 ]]; then
        log "FAIL: step3 envelope 検査失敗 (exit $rc): $step3_env"
        ENVELOPE_FAIL=1
      fi
    fi

    if [[ ! -f "$step4_env" ]]; then
      log "FAIL: step4 envelope が見つかりません: $step4_env"
      ENVELOPE_FAIL=1
    else
      run_logged python3 "$SCRIPT_DIR/gate-artifact.py" "$step4_env" --expect-step step4 --expect-status complete
      rc=$?
      if [[ $rc -ne 0 ]]; then
        log "FAIL: step4 envelope 検査失敗 (exit $rc): $step4_env"
        ENVELOPE_FAIL=1
      fi
    fi

    if [[ $ENVELOPE_FAIL -ne 0 ]]; then
      log "=== workflow gate step4: FAIL (envelope 検査失敗 — code gate 未実行) ==="
      exit 1
    fi

    log "PASS: step3/step4 envelope 検査通過"

    PROFILE="{{project.quality_gate.profile}}"
    log "quality gate profile: $PROFILE"

    case "$PROFILE" in
      foundation)
        log "--- code gate (foundation profile: bin/foundation-gate self) ---"
        run_logged "$ROOT_DIR/bin/foundation-gate" self
        rc=$?
        if [[ $rc -ne 0 ]]; then
          log "FAIL: bin/foundation-gate self が exit $rc で失敗"
          exit "$rc"
        fi
        ;;
      application)
        log "--- code gate (application profile: G-GEN + build/lint/test) ---"
        {{#if project.quality_gate.gen_artifact_paths}}
        GEN_PATHS=({{#each project.quality_gate.gen_artifact_paths}} "{{this}}"{{/each}} )

        log "--- G-GEN: gen_artifact_paths 非空 → gen 必須実行 ---"
        run_logged "$ROOT_DIR/bin/quality-gate" gen
        GEN_EXIT=$?
        if [[ $GEN_EXIT -ne 0 ]]; then
          log "FAIL: bin/quality-gate gen が exit $GEN_EXIT で失敗"
          exit "$GEN_EXIT"
        fi
        GEN_STATUS=$(git status --porcelain -- "${GEN_PATHS[@]}" 2>/dev/null || true)
        if [[ -n "$GEN_STATUS" ]]; then
          log "FAIL: G-GEN — gen 実行後に未コミットの生成物差分あり:"
          log "$GEN_STATUS"
          log "生成物をコミットしてから再実行してください。"
          exit 1
        fi
        log "PASS: G-GEN — 生成物は最新（差分なし）"
        {{else}}
        log "SKIP: gen_artifact_paths が空 — gen 対象なし（verify のみ実行）"
        {{/if}}

        log "--- verify ---"
        run_logged "$ROOT_DIR/bin/quality-gate" verify
        rc=$?
        if [[ $rc -ne 0 ]]; then
          log "FAIL: bin/quality-gate verify が exit $rc で失敗"
          exit "$rc"
        fi
        ;;
      *)
        echo "ERROR: unknown project.quality_gate.profile: $PROFILE" >&2
        exit 2
        ;;
    esac

    # コードゲートが成功した場合だけ完了チェックゲートを実行する。
    if [[ ${#FORMAT_ARGS[@]} -gt 0 ]]; then
      python3 "$SCRIPT_DIR/gate-test.py" "$REPORT_FILE" "${FORMAT_ARGS[@]}"
    else
      python3 "$SCRIPT_DIR/gate-test.py" "$REPORT_FILE"
    fi
    exit $?
    ;;
  step5)
    # ④→⑤ 検証→PR: verification-gate.sh（session.verification.gate_command）
    exec "$SCRIPT_DIR/verification-gate.sh"
    ;;
  step6)
    # ⑤→⑥ PR→完了: レビュー完了承認 + 未対応0件を検査
    {{#if agent_workflow.step6.project_gate_command}}
    # プロジェクト固有ゲート → 汎用ゲートの順序で実行
    PROJECT_GATE_CMD=({{#each agent_workflow.step6.project_gate_command}} "{{this}}"{{/each}} )
    ROOT_DIR="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
    (cd "$ROOT_DIR" && "${PROJECT_GATE_CMD[@]}" "$@")
    pg_exit=$?
    if [[ $pg_exit -ne 0 ]]; then
      echo "FAIL: プロジェクトゲートが exit $pg_exit で失敗（汎用ゲートは未実行）"
      exit $pg_exit
    fi
    exec "$SCRIPT_DIR/plan-gate.sh" review
    {{else}}
    exec "$SCRIPT_DIR/plan-gate.sh" review
    {{/if}}
    ;;
  adr)
    # ADR 起票内容の機械検査（docs/DECISIONS.md）
    ROOT_DIR="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
    export CURSOR_PROJECT_DIR="$ROOT_DIR"
    exec python3 "$SCRIPT_DIR/gate-adr.py" "$@"
    ;;
  artifact)
    # Worker artifact envelope 検査（gate-artifact.py）
    exec python3 "$SCRIPT_DIR/gate-artifact.py" "$@"
    ;;
  redispatch)
    # re-dispatch 前の復元差分照合（gate-redispatch.py）
    exec python3 "$SCRIPT_DIR/gate-redispatch.py" "$@"
    ;;
  maintenance-docs)
    # maintenance-docs 起票判定と queue 整合性の機械検査
    exec python3 "$SCRIPT_DIR/gate-maintenance-docs.py" "$@"
    ;;
  archive)
    # ⑥ 完了チェック6項目 + 残存 partial artifact 検査 + maintenance-docs 整合性検査
    if [[ -n "${1:-}" ]]; then
      exec "$SCRIPT_DIR/archive-gate.sh" "$1"
    else
      exec "$SCRIPT_DIR/archive-gate.sh"
    fi
    ;;
  *)
    echo "FATAL: 不明なステップ '$STEP'。"
    echo "利用可能: step1 | step2 | step2-report | step4 | step5 | step6 | adr | artifact | redispatch | maintenance-docs | archive"
    exit 2
    ;;
esac
