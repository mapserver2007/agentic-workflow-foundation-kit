#!/usr/bin/env python3
from __future__ import annotations

# gate-maintenance-docs.py  [generated by agentic-workflow-foundation skill]
# タスクレポートの maintenance-docs 起票判定と queue ファイルの整合性を機械検査する。
# 仕様: docs/QUALITY_GATE.md §1.2.1（G-ARCHIVE）/ §3（フェーズ境界: 完了報告→アーカイブ）
# 用法: gate-maintenance-docs.py <report-file>
# exit: 0 = PASS / 1 = FAIL（判定不整合）/ 2 = 致命的エラー（YAML解析不能/依存欠落）

import os
import re
import sys
from pathlib import Path

JUDGMENT_VALUES = {"pending", "required", "not_required"}
QUEUE_DIR_REL = "docs/agent-tasks/maintenance-docs"


def _out(level: str, msg: str, code: str = ""):
    tag = f" ({code})" if code else ""
    print(f"[{level}] {msg}{tag}")


def parse_judgment_section(report_path: Path):
    """レポートの §10 完了チェック配下から maintenance-docs-judgment key-value を抽出する。"""
    text = report_path.read_text(encoding="utf-8")
    result = {}
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("- maintenance-docs-judgment:"):
            result["judgment"] = stripped.split(":", 1)[1].strip()
        elif stripped.startswith("- queue_file:"):
            result["queue_file"] = stripped.split(":", 1)[1].strip()
        elif stripped.startswith("- judgment_reason:"):
            result["judgment_reason"] = stripped.split(":", 1)[1].strip()
    return result


def find_queues_for_report(project_dir: Path, report_filename: str):
    """source_report が report_filename に一致する active (非 archives) pending queue を返す。"""
    queue_dir = project_dir / QUEUE_DIR_REL
    if not queue_dir.is_dir():
        return []
    matches = []
    for f in sorted(queue_dir.glob("*.md")):
        if f.name.startswith("."):
            continue
        front_matter = _parse_queue_front_matter(f)
        if front_matter is None:
            continue
        # source_type: manual は突合対象外
        if front_matter.get("source_type") == "manual":
            continue
        if front_matter.get("status") != "pending":
            continue
        if front_matter.get("source_report") == report_filename:
            matches.append((f, front_matter))
    return matches


def _parse_queue_front_matter(path: Path):
    """YAML front matter を簡易パースする (--- 区切り)。"""
    try:
        import yaml
    except ImportError:
        print("FATAL: PyYAML が未導入です。pip install pyyaml を実行してください。")
        sys.exit(2)

    text = path.read_text(encoding="utf-8")
    if not text.startswith("---"):
        return None
    parts = text.split("---", 2)
    if len(parts) < 3:
        return None
    try:
        parsed = yaml.safe_load(parts[1])
        return parsed if isinstance(parsed, dict) else None
    except Exception:
        return None


def check_report(report_path: Path, project_dir: Path):
    """単一レポートの maintenance-docs 判定を検査する。"""
    print(f"--- {report_path} ---")

    if not report_path.is_file():
        _out("FATAL", f"ファイルが存在しません: {report_path}")
        return 2

    judgment_data = parse_judgment_section(report_path)

    # --- G-MDOCS-JUDGMENT-001: 判定セクションの存在と値域 ---
    judgment = judgment_data.get("judgment", "")
    if not judgment:
        _out("FAIL", "maintenance-docs-judgment 行が見つかりません", "G-MDOCS-JUDGMENT-001")
        return 1
    if judgment not in JUDGMENT_VALUES:
        _out("FAIL", f"maintenance-docs-judgment '{judgment}' は不正です。許可値: {JUDGMENT_VALUES}", "G-MDOCS-JUDGMENT-001")
        return 1
    if judgment == "pending":
        _out("FAIL", "maintenance-docs-judgment が pending のまま（Step ⑥ で確定が必要）", "G-MDOCS-JUDGMENT-001")
        return 1

    queue_file_val = judgment_data.get("queue_file", "").strip()
    judgment_reason = judgment_data.get("judgment_reason", "").strip()
    report_filename = report_path.name

    if judgment == "required":
        # --- G-MDOCS-QUEUE-001: required 時の queue 整合性 ---
        if not queue_file_val or queue_file_val == "なし":
            _out("FAIL", "judgment=required だが queue_file が未設定", "G-MDOCS-QUEUE-001")
            return 1

        queue_dir = (project_dir / QUEUE_DIR_REL).resolve()
        queue_path = (project_dir / queue_file_val).resolve()
        if not str(queue_path).startswith(str(queue_dir)):
            _out("FAIL", "queue_file は maintenance-docs/ 配下を指す必要があります", "G-MDOCS-QUEUE-001")
            return 1
        if not queue_path.is_file():
            _out("FAIL", f"queue_file が存在しません: {queue_file_val}", "G-MDOCS-QUEUE-001")
            return 1

        # queue の front matter 検査
        fm = _parse_queue_front_matter(queue_path)
        if fm is None:
            _out("FAIL", f"queue ファイルの YAML front matter を解析できません: {queue_file_val}", "G-MDOCS-QUEUE-001")
            return 1

        # status: pending 必須
        if fm.get("status") != "pending":
            _out("FAIL", f"queue の status が 'pending' ではありません: {fm.get('status')}", "G-MDOCS-QUEUE-001")
            return 1

        # source_report 一致（source_type: manual は除外済みだがここでも確認）
        if fm.get("source_type") != "manual":
            q_source_report = fm.get("source_report", "")
            if q_source_report != report_filename:
                _out("FAIL", f"queue の source_report '{q_source_report}' がレポート '{report_filename}' と不一致", "G-MDOCS-QUEUE-001")
                return 1

        # target_docs 非空
        target_docs = fm.get("target_docs")
        if not target_docs or (isinstance(target_docs, list) and len(target_docs) == 0):
            _out("FAIL", "queue の target_docs が空です", "G-MDOCS-QUEUE-001")
            return 1

        _out("PASS", f"judgment=required, queue 整合 OK: {queue_file_val}", "G-MDOCS-QUEUE-001")

    elif judgment == "not_required":
        # --- G-MDOCS-REASON-001: not_required 時の理由必須 ---
        if not judgment_reason:
            _out("FAIL", "judgment=not_required だが judgment_reason が空", "G-MDOCS-REASON-001")
            return 1

        # queue_file は「なし」であるべき
        if queue_file_val and queue_file_val != "なし":
            _out("FAIL", f"judgment=not_required だが queue_file が設定されています: {queue_file_val}", "G-MDOCS-REASON-001")
            return 1

        # 同じ source_report の pending queue が存在しないこと
        conflicting = find_queues_for_report(project_dir, report_filename)
        if conflicting:
            names = [str(p.relative_to(project_dir)) for p, _ in conflicting]
            _out("FAIL", f"judgment=not_required だが source_report 一致の pending queue が存在: {names}", "G-MDOCS-REASON-001")
            return 1

        _out("PASS", f"judgment=not_required, 理由あり, 矛盾 queue なし", "G-MDOCS-REASON-001")

    _out("PASS", f"maintenance-docs 起票判定 OK (judgment={judgment})", "G-MDOCS-JUDGMENT-001")
    return 0


def main():
    print("=== maintenance-docs gate ===")

    if len(sys.argv) < 2:
        _out("FATAL", "引数が必要です: gate-maintenance-docs.py <report-file>")
        sys.exit(2)

    report_file = sys.argv[1]
    project_dir = Path(os.environ.get("CURSOR_PROJECT_DIR", os.getcwd()))

    if os.path.isabs(report_file):
        report_path = Path(report_file)
    else:
        report_path = project_dir / report_file

    rc = check_report(report_path, project_dir)
    if rc == 0:
        print("=== maintenance-docs gate: PASS ===")
    elif rc == 1:
        print("=== maintenance-docs gate: FAIL ===")
    else:
        print("=== maintenance-docs gate: FATAL ===")
    sys.exit(rc)


if __name__ == "__main__":
    main()
