#!/usr/bin/env bash
# archive-gate.sh  [generated by agentic-workflow-foundation skill]
# タスクレポートの完了チェック6項目を機械検査し、archives 移動可否を判定する。
# 仕様: docs/QUALITY_GATE.md §1.2.1（G-ARCHIVE）/ §3（フェーズ境界: 完了報告→アーカイブ）
# 用法: archive-gate.sh [report-file]
#   report-file を指定しない場合は docs/agent-tasks/reports/ 直下の全 .md を検査
# 出力: 人間可読の [PASS|FAIL] 名称 (CODE)
# exit: 0 = PASS（全6項目 [x]）/ 1 = FAIL（未完了項目あり）/ 2 = 致命的エラー
# 設計: session-start-gate.sh / plan-gate.sh と同クラスの軽量シェルゲート
set -u

PROJECT_DIR="${CURSOR_PROJECT_DIR:-$(pwd)}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPORTS_DIR="$PROJECT_DIR/docs/agent-tasks/reports"
REPORT_FILE="${1:-}"

echo "=== archive gate ==="

# 完了チェック6項目のラベル（タスクレポートに記載されるチェックボックスのテキスト）
COMPLETION_ITEMS=(
  "実装完了"
  "テスト完了"
  "コードゲート通過"
  "PRレビュー検証完了"
  "maintenance-docs/ 起票判定"
  "ADR 起票判定"
)

{{#if agent_workflow.artifact}}
ARTIFACTS_DIR="$PROJECT_DIR/{{agent_workflow.artifact.dir}}"
{{/if}}

check_report() {
  local file="$1"
  local fail=0
  local missing=()

  echo "--- $file ---"

  if [[ ! -f "$file" ]]; then
    echo "[FATAL] ファイルが存在しません: $file"
    return 2
  fi

{{#if agent_workflow.gate_scripts}}
  # --- G-WRITE-SCOPE-DOMAIN-001: archive 前の実差分最終検査 ---
  python3 "$SCRIPT_DIR/gate-domain-write-scope.py" --report "$file" --repo "$PROJECT_DIR"
  local scope_rc=$?
  if (( scope_rc == 2 )); then
    echo "[FATAL] 実差分 Domain scope 検査が致命的エラー (G-WRITE-SCOPE-DOMAIN-001)"
    return 2
  elif (( scope_rc == 1 )); then
    echo "[FAIL] 実差分 Domain scope 検査失敗 (G-WRITE-SCOPE-DOMAIN-001)"
    fail=1
  fi
{{/if}}

  # 完了チェックセクションを抽出（"完了チェック" 見出し以降の行を対象）
  local in_section=0
  local checked=0
  local total=${#COMPLETION_ITEMS[@]}

  for item in "${COMPLETION_ITEMS[@]}"; do
    # [x] + アイテム名を含む行を検索（大文字小文字/空白の揺れに対応）
    if grep -qE '^\s*-\s*\[x\].*'"$item" "$file" 2>/dev/null; then
      checked=$((checked + 1))
    else
      missing+=("$item")
    fi
  done

  # --- G-ARCHIVE-CHECK-001: 完了チェック6項目すべて [x] ---
  if (( checked == total )); then
    echo "[PASS] 完了チェック全${total}項目 [x] 確認済み (G-ARCHIVE-CHECK-001)"
  else
    echo "[FAIL] 完了チェック未完了: ${checked}/${total} 項目のみ [x] (G-ARCHIVE-CHECK-001)"
    for m in "${missing[@]}"; do
      echo "  - 未完了: $m"
    done
    fail=1
  fi

{{#if agent_workflow.artifact}}
  # --- G-ARCHIVE-ARTIFACT-001: slug に紐づく残存 step envelope の検査 ---
  # 全ステップが完了し archive 可能な状態では step envelope は全て削除済みであるべき。
  # 残存 envelope がある場合は、いずれかのステップの成果物検証が未完了の可能性がある。
  local basename
  basename="$(basename "$file" .md)"
  if [[ -d "$ARTIFACTS_DIR" ]]; then
    local residual=()
    while IFS= read -r af; do
      [[ -n "$af" ]] && residual+=("$af")
    done < <(find "$ARTIFACTS_DIR" -maxdepth 1 -name "${basename}--*" -type f 2>/dev/null | sort)

    if (( ${#residual[@]} > 0 )); then
      echo "[FAIL] slug '${basename}' に紐づく残存 step envelope あり (G-ARCHIVE-ARTIFACT-001)"
      for rf in "${residual[@]}"; do
        echo "  - 残存: $rf"
      done
      echo "  次ステップの envelope + 正式成果物の検証完了を確認後、削除してください。"
      fail=1
    else
      echo "[PASS] 残存 step envelope なし (G-ARCHIVE-ARTIFACT-001)"
    fi
  fi
{{/if}}

{{#if agent_workflow.maintenance_docs.enabled}}
  # --- G-ARCHIVE-MDOCS-001: maintenance-docs 起票判定の整合性検査 ---
  python3 "$SCRIPT_DIR/gate-maintenance-docs.py" "$file"
  local mdocs_rc=$?
  if (( mdocs_rc == 2 )); then
    echo "[FATAL] gate-maintenance-docs.py が致命的エラー (G-ARCHIVE-MDOCS-001)"
    return 2
  elif (( mdocs_rc == 1 )); then
    echo "[FAIL] maintenance-docs 起票判定の整合性検査失敗 (G-ARCHIVE-MDOCS-001)"
    fail=1
  elif (( mdocs_rc == 0 )); then
    echo "[PASS] maintenance-docs 起票判定の整合性 OK (G-ARCHIVE-MDOCS-001)"
  else
    echo "[FATAL] gate-maintenance-docs.py が想定外の終了コード: $mdocs_rc (G-ARCHIVE-MDOCS-001)"
    return 2
  fi
{{/if}}

  return $fail
}

# 対象ファイルの決定
targets=()
if [[ -n "$REPORT_FILE" ]]; then
  # 引数指定: 単一ファイル
  if [[ "$REPORT_FILE" == /* ]]; then
    targets+=("$REPORT_FILE")
  else
    targets+=("$PROJECT_DIR/$REPORT_FILE")
  fi
else
  # 引数なし: reports/ 直下の全 .md（archives/ 除外）
  if [[ ! -d "$REPORTS_DIR" ]]; then
    echo "FATAL: reports ディレクトリが存在しません: $REPORTS_DIR"
    exit 2
  fi
  while IFS= read -r f; do
    [[ -n "$f" ]] && targets+=("$f")
  done < <(find "$REPORTS_DIR" -maxdepth 1 -name "*.md" ! -name "*-review.md" -type f 2>/dev/null | sort)
fi

if (( ${#targets[@]} == 0 )); then
  echo "[PASS] archives 対象のレポートなし（reports/ 直下に .md ファイルなし）"
  exit 0
fi

overall_fail=0
fatal=0

for t in "${targets[@]}"; do
  check_report "$t"
  rc=$?
  if (( rc == 2 )); then
    fatal=1
  elif (( rc == 1 )); then
    overall_fail=1
  fi
done

if (( fatal != 0 )); then
  echo "=== archive gate: FATAL ==="
  exit 2
fi

if (( overall_fail != 0 )); then
  echo "=== archive gate: FAIL ==="
  exit 1
fi

echo "=== archive gate: PASS ==="
exit 0
