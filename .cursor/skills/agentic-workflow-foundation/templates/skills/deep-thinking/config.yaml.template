# deep-thinking 実行設定
#
# このファイルを直接編集して A/B のモデルや実行パラメータを変更できます。
# mode: seed のため、再生成時に既存の編集内容は上書きされません。

models:
  # A（推進視点）: readonly subagent
  analyst_a: "{{#if deep_thinking.models.analyst_a}}{{deep_thinking.models.analyst_a}}{{else}}composer-2.5-fast{{/if}}"
  # B（反証視点）: readonly subagent
  analyst_b: "{{#if deep_thinking.models.analyst_b}}{{deep_thinking.models.analyst_b}}{{else}}grok-4.7-high{{/if}}"

execution:
  # true の場合、A/B を別プロセスとして起動する
  require_distinct_agents: {{#if deep_thinking.execution.require_distinct_agents}}{{deep_thinking.execution.require_distinct_agents}}{{else}}true{{/if}}
  # true の場合、A/B に異なるモデルを要求する（静的 audit で検査）
  require_distinct_models: {{#if deep_thinking.execution.require_distinct_models}}{{deep_thinking.execution.require_distinct_models}}{{else}}true{{/if}}
  # モデル利用不可時の方針: ABORT（即終了）
  model_unavailable: "{{#if deep_thinking.execution.model_unavailable}}{{deep_thinking.execution.model_unavailable}}{{else}}ABORT{{/if}}"
  # 最大ラウンド数（round 0 含む）
  max_rounds: {{#if deep_thinking.execution.max_rounds}}{{deep_thinking.execution.max_rounds}}{{else}}3{{/if}}
  # 争点ごとの反駁上限
  max_rebuttal_turns_per_issue: {{#if deep_thinking.execution.max_rebuttal_turns_per_issue}}{{deep_thinking.execution.max_rebuttal_turns_per_issue}}{{else}}1{{/if}}
  # 再審1ラウンドあたりの争点カード配布上限
  max_issues_per_round: {{#if deep_thinking.execution.max_issues_per_round}}{{deep_thinking.execution.max_issues_per_round}}{{else}}1{{/if}}
  # 停止条件
  stop_when: "{{#if deep_thinking.execution.stop_when}}{{deep_thinking.execution.stop_when}}{{else}}NO_MATERIAL_ISSUES{{/if}}"

# 高影響領域: この領域に該当する判断は不確実性を明示しユーザー判断を促す
# SoT: manifest.yaml > requirement_analysis.high_impact_categories
high_impact_categories:
{{#each requirement_analysis.high_impact_categories}}  - "{{this}}"
{{/each}}

