# multi-agent-evaluation 実行設定
#
# このファイルを直接編集して A/B のモデルや実行パラメータを変更できます。
# mode: seed のため、再生成時に既存の編集内容は上書きされません。

models:
  # A（推進視点）: readonly subagent
  analyst_a: "{{#if multi_agent_evaluation.models.analyst_a}}{{multi_agent_evaluation.models.analyst_a}}{{else}}composer-2.5-fast{{/if}}"
  # B（反証視点）: readonly subagent
  analyst_b: "{{#if multi_agent_evaluation.models.analyst_b}}{{multi_agent_evaluation.models.analyst_b}}{{else}}composer-2.5-fast{{/if}}"

execution:
  # true の場合、A/B を別プロセスとして起動する
  require_distinct_agents: {{#if multi_agent_evaluation.execution.require_distinct_agents}}{{multi_agent_evaluation.execution.require_distinct_agents}}{{else}}true{{/if}}
  # モデル利用不可時の方針: ABORT（即終了）
  model_unavailable: "{{#if multi_agent_evaluation.execution.model_unavailable}}{{multi_agent_evaluation.execution.model_unavailable}}{{else}}ABORT{{/if}}"
  # 最大ラウンド数（round 0 含む）
  max_rounds: {{#if multi_agent_evaluation.execution.max_rounds}}{{multi_agent_evaluation.execution.max_rounds}}{{else}}3{{/if}}
  # 争点ごとの反駁上限
  max_rebuttal_turns_per_issue: {{#if multi_agent_evaluation.execution.max_rebuttal_turns_per_issue}}{{multi_agent_evaluation.execution.max_rebuttal_turns_per_issue}}{{else}}1{{/if}}
  # 再審1ラウンドあたりの争点カード配布上限
  max_issues_per_round: {{#if multi_agent_evaluation.execution.max_issues_per_round}}{{multi_agent_evaluation.execution.max_issues_per_round}}{{else}}1{{/if}}
  # 停止条件
  stop_when: "{{#if multi_agent_evaluation.execution.stop_when}}{{multi_agent_evaluation.execution.stop_when}}{{else}}NO_MATERIAL_ISSUES{{/if}}"

# 高影響領域: この領域に該当する判断は不確実性を明示しユーザー判断を促す
high_impact_categories:
{{#if multi_agent_evaluation.high_impact_categories}}
{{#each multi_agent_evaluation.high_impact_categories}}  - "{{this}}"
{{/each}}
{{else}}
  - "security_or_authorization"
  - "secret_or_sensitive_data"
  - "data_deletion_or_migration"
  - "breaking_external_api"
  - "irreversible_architecture"
  - "unapproved_cost_or_schedule"
  - "must_requirement_conflict"
{{/if}}
