#!/usr/bin/env bash
# campaign-cleanup.sh [generated by agentic-workflow-foundation skill]
# 現在の campaign を保護し、それ以外の runtime を承認なしで削除する。
# 対象: .cursor/.tracking / .cursor/.artifacts / .cursor/.session の直下 regular file
# exit: 0 = PASS / 1 = current state 不備 / 2 = 引数・allowlist・tracked・symlink 不備
set -u
shopt -s nullglob dotglob

PROJECT_DIR="${CURSOR_PROJECT_DIR:-$(pwd)}"
SESSION_DIR="$PROJECT_DIR/.cursor/.session"
TRACKING_DIR="$PROJECT_DIR/.cursor/.tracking"
ARTIFACTS_DIR="$PROJECT_DIR/.cursor/.artifacts"

COMMAND=""
CURRENT_SESSION_ID=""
CURRENT_CAMPAIGN_ID=""
CURRENT_TRACKER_REL=""
CURRENT_TRACKER_PATH=""
GIT_REPO=0

declare -a CANDIDATE_PATHS=()
declare -a CANDIDATE_KINDS=()
declare -a PROTECTED_PATHS=()
declare -a DELETE_PATHS=()
declare -a PROTECTED_SESSIONS=()
declare -a CURRENT_ARTIFACT_KEYS=()

usage() {
  cat >&2 <<'EOF'
usage:
  campaign-cleanup.sh inventory --current-session-id SID
  campaign-cleanup.sh apply --current-session-id SID
EOF
}

fatal() {
  echo "[FATAL] $*" >&2
  exit 2
}

fail_current() {
  echo "[FAIL] $*" >&2
  exit 1
}

display_path() {
  local path="$1"
  printf '%s' "${path#"$PROJECT_DIR"/}"
}

valid_id() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]
}

if (( $# < 1 )); then
  usage
  exit 2
fi

COMMAND="$1"
shift
case "$COMMAND" in
  inventory|apply) ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    usage
    fatal "不明なサブコマンドです: $COMMAND"
    ;;
esac

while (( $# > 0 )); do
  case "$1" in
    --current-session-id)
      (( $# >= 2 )) || fatal "--current-session-id の値がありません"
      CURRENT_SESSION_ID="$2"
      shift 2
      ;;
    *)
      usage
      fatal "不明な引数です: $1"
      ;;
  esac
done

[[ -n "$CURRENT_SESSION_ID" ]] || fatal "--current-session-id は必須です"
valid_id "$CURRENT_SESSION_ID" || fatal "current session id が不正です"

if [[ "$PROJECT_DIR" != /* ]]; then
  PROJECT_DIR="$(cd "$PROJECT_DIR" 2>/dev/null && pwd)" || fatal "project directory を解決できません"
  SESSION_DIR="$PROJECT_DIR/.cursor/.session"
  TRACKING_DIR="$PROJECT_DIR/.cursor/.tracking"
  ARTIFACTS_DIR="$PROJECT_DIR/.cursor/.artifacts"
fi

if command -v git >/dev/null 2>&1 && git -C "$PROJECT_DIR" rev-parse --show-toplevel >/dev/null 2>&1; then
  GIT_REPO=1
fi

check_directory() {
  local directory="$1"
  if [[ -L "$directory" ]]; then
    fatal "allowlist directory が symlink です: $(display_path "$directory")"
  fi
  if [[ -e "$directory" && ! -d "$directory" ]]; then
    fatal "allowlist directory が directory ではありません: $(display_path "$directory")"
  fi
}

check_tracked() {
  local path="$1"
  local relative
  [[ "$GIT_REPO" == "1" ]] || return 0
  relative="${path#"$PROJECT_DIR"/}"
  # git ls-files で tracked file を検査し、tracked は全体を abort する。
  if git -C "$PROJECT_DIR" ls-files --error-unmatch -- "$relative" >/dev/null 2>&1; then
    fatal "tracked file は削除できません: $relative"
  fi
}

add_candidate() {
  CANDIDATE_PATHS+=("$1")
  CANDIDATE_KINDS+=("$2")
}

scan_directory() {
  local directory="$1"
  local kind="$2"
  local path
  local base
  local -a entries=()

  [[ -d "$directory" ]] || return 0
  entries=("$directory"/*)
  (( ${#entries[@]} > 0 )) || return 0
  for path in "${entries[@]}"; do
    [[ -e "$path" || -L "$path" ]] || continue
    if [[ -L "$path" ]]; then
      fatal "symlink は削除対象にできません: $(display_path "$path")"
    fi
    [[ -f "$path" ]] || fatal "allowlist directory の直下以外は扱えません: $(display_path "$path")"
    check_tracked "$path"
    base="$(basename "$path")"
    case "$kind" in
      tracking)
        [[ "$base" =~ ^tracker-[A-Za-z0-9._-]+\.md$ ]] ||
          fatal "追跡ドキュメントの allowlist 外ファイルです: $(display_path "$path")"
        ;;
      artifacts)
        [[ "$base" =~ ^[A-Za-z0-9._-]+--[A-Za-z0-9._-]+\.md$ ]] ||
          fatal "artifact の allowlist 外ファイルです: $(display_path "$path")"
        ;;
      session)
        if [[ "$base" == "compact-events.jsonl" ]]; then
          :
        elif [[ "$base" =~ ^handoff-consumed-[A-Za-z0-9._-]+\.md$ ]]; then
          :
        elif [[ "$base" =~ ^handoff-[A-Za-z0-9._-]+\.md$ ]]; then
          :
        elif [[ "$base" =~ ^pre-compact-[A-Za-z0-9._-]+\.md$ ]]; then
          :
        elif [[ "$base" =~ ^[A-Za-z0-9._-]+\.json$ ]]; then
          :
        elif [[ "$base" =~ ^[A-Za-z0-9._-]+\.(turns|progress)\.jsonl$ ]]; then
          :
        elif [[ "$base" =~ ^[A-Za-z0-9._-]+\.(lock|checkpoint|pending-handoff)$ ]]; then
          :
        else
          fatal "session runtime の allowlist 外ファイルです: $(display_path "$path")"
        fi
        ;;
      *) fatal "内部エラー: 不明な scan kind です: $kind" ;;
    esac
    add_candidate "$path" "$kind"
  done
}

json_campaign_id() {
  local state_path="$1"
  local expected_session_id="$2"
  python3 - "$state_path" "$expected_session_id" <<'PY'
import json
import re
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        value = json.load(handle)
except (OSError, UnicodeError, ValueError):
    raise SystemExit(1)

if not isinstance(value, dict) or value.get("session_id") != sys.argv[2]:
    raise SystemExit(1)
campaign_id = value.get("campaign_id")
if not isinstance(campaign_id, str) or re.fullmatch(r"[A-Za-z0-9._-]+", campaign_id) is None:
    raise SystemExit(1)
print(campaign_id)
PY
}

resolve_current_campaign() {
  local state_path="$SESSION_DIR/$CURRENT_SESSION_ID.json"
  local parsed_campaign

  if [[ -L "$state_path" ]]; then
    fatal "current session state が symlink です: $(display_path "$state_path")"
  fi
  [[ -f "$state_path" ]] || fail_current "current session state がありません: $(display_path "$state_path")"
  command -v python3 >/dev/null 2>&1 || fatal "current state 検証に python3 が必要です"

  parsed_campaign="$(
    python3 - "$state_path" "$CURRENT_SESSION_ID" <<'PY'
import json
import re
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        value = json.load(handle)
except (OSError, UnicodeError, ValueError):
    raise SystemExit(1)

if not isinstance(value, dict):
    raise SystemExit(1)
if value.get("session_id") != sys.argv[2]:
    raise SystemExit(1)
campaign_id = value.get("campaign_id")
if not isinstance(campaign_id, str) or re.fullmatch(r"[A-Za-z0-9._-]+", campaign_id) is None:
    raise SystemExit(1)
print(campaign_id)
PY
  )" || fail_current "current session state が不正です: $(display_path "$state_path")"

  [[ -n "$parsed_campaign" ]] || fail_current "current campaign を解決できません"
  CURRENT_CAMPAIGN_ID="$parsed_campaign"
  CURRENT_TRACKER_REL=".cursor/.tracking/tracker-${CURRENT_CAMPAIGN_ID}.md"
  CURRENT_TRACKER_PATH="$PROJECT_DIR/$CURRENT_TRACKER_REL"
}

add_protected_session() {
  local session_id="$1"
  local existing
  if (( ${#PROTECTED_SESSIONS[@]} > 0 )); then
    for existing in "${PROTECTED_SESSIONS[@]}"; do
      [[ "$existing" == "$session_id" ]] && return 0
    done
  fi
  PROTECTED_SESSIONS+=("$session_id")
}

collect_campaign_sessions() {
  local i
  local path
  local kind
  local base
  local session_id
  local campaign_id

  add_protected_session "$CURRENT_SESSION_ID"
  (( ${#CANDIDATE_PATHS[@]} > 0 )) || return 0
  for i in "${!CANDIDATE_PATHS[@]}"; do
    path="${CANDIDATE_PATHS[$i]}"
    kind="${CANDIDATE_KINDS[$i]}"
    [[ "$kind" == "session" ]] || continue
    base="$(basename "$path")"
    [[ "$base" =~ ^([A-Za-z0-9._-]+)\.json$ ]] || continue
    session_id="${BASH_REMATCH[1]}"
    campaign_id="$(json_campaign_id "$path" "$session_id" 2>/dev/null)" ||
      fatal "session state を読み取れないため中止します: $(display_path "$path")"
    if [[ "$campaign_id" == "$CURRENT_CAMPAIGN_ID" ]]; then
      add_protected_session "$session_id"
    fi
  done
}

collect_artifact_keys() {
  local key
  local tracker="$CURRENT_TRACKER_PATH"
  local key_output
  local has_artifacts=0
  local i

  for i in "${!CANDIDATE_KINDS[@]}"; do
    if [[ "${CANDIDATE_KINDS[$i]}" == "artifacts" ]]; then
      has_artifacts=1
      break
    fi
  done

  if [[ -L "$tracker" ]]; then
    fatal "current tracker が symlink です: $(display_path "$tracker")"
  fi
  if [[ -e "$tracker" && ! -f "$tracker" ]]; then
    fatal "current tracker が regular file ではありません: $(display_path "$tracker")"
  fi
  if [[ ! -e "$tracker" ]]; then
    (( has_artifacts == 0 )) ||
      fatal "artifact が存在するのに current tracker がありません: $(display_path "$tracker")"
    return 0
  fi

  command -v python3 >/dev/null 2>&1 || fatal "tracker の所有キー判定に python3 が必要です"
  key_output="$(
    python3 - "$tracker" <<'PY'
import re
import sys
from pathlib import Path

identifier = r"[A-Za-z0-9._-]+"
tracker_path = Path(sys.argv[1])
keys = set()

def add(value):
    if re.fullmatch(identifier, value):
        keys.add(value)

try:
    tracker_text = tracker_path.read_text(encoding="utf-8")
except (OSError, UnicodeError):
    raise SystemExit(1)

for field in ("campaign_slug",):
    for match in re.finditer(rf"(?m)^\s*{field}:\s*[\"'`]?({identifier})[\"'`]?\s*$", tracker_text):
        add(match.group(1))
for match in re.finditer(rf"\.cursor/\.artifacts/({identifier})--", tracker_text):
    add(match.group(1))

for value in sorted(keys):
    print(value)
PY
  )" || fatal "current tracker を読み取れないため中止します: $(display_path "$tracker")"

  while IFS= read -r key; do
    [[ -n "$key" ]] || continue
    local existing
    if (( ${#CURRENT_ARTIFACT_KEYS[@]} > 0 )); then
      for existing in "${CURRENT_ARTIFACT_KEYS[@]}"; do
        [[ "$existing" == "$key" ]] && key=""
      done
    fi
    [[ -n "$key" ]] && CURRENT_ARTIFACT_KEYS+=("$key")
  done <<< "$key_output"

  (( ${#CURRENT_ARTIFACT_KEYS[@]} > 0 || has_artifacts == 0 )) ||
    fatal "artifact が存在するのに current tracker に所有キーがありません: $(display_path "$tracker")"
}

artifact_belongs_to_current() {
  local artifact_path="$1"
  local prefix
  local key
  prefix="$(basename "$artifact_path")"
  prefix="${prefix%%--*}"
  for key in "${CURRENT_ARTIFACT_KEYS[@]}"; do
    [[ "$prefix" == "$key" ]] && return 0
  done
  return 1
}

session_file_belongs_to_current() {
  local base="$1"
  local session_id
  if (( ${#PROTECTED_SESSIONS[@]} > 0 )); then
    for session_id in "${PROTECTED_SESSIONS[@]}"; do
      case "$base" in
        "$session_id".json|"$session_id".turns.jsonl|"$session_id".progress.jsonl|"$session_id".lock|"$session_id".checkpoint|"$session_id".pending-handoff)
          return 0
          ;;
        "pre-compact-$session_id.md"|"handoff-$session_id.md")
          return 0
          ;;
      esac
      [[ "$base" == handoff-consumed-"$session_id"-*.md ]] && return 0
    done
  fi
  return 1
}

build_plan() {
  local i
  local path
  local kind
  local base

  check_directory "$SESSION_DIR"
  check_directory "$TRACKING_DIR"
  check_directory "$ARTIFACTS_DIR"
  resolve_current_campaign
  scan_directory "$TRACKING_DIR" tracking
  scan_directory "$ARTIFACTS_DIR" artifacts
  scan_directory "$SESSION_DIR" session
  collect_campaign_sessions
  collect_artifact_keys

  (( ${#CANDIDATE_PATHS[@]} > 0 )) || return 0
  for i in "${!CANDIDATE_PATHS[@]}"; do
    path="${CANDIDATE_PATHS[$i]}"
    kind="${CANDIDATE_KINDS[$i]}"
    base="$(basename "$path")"
    case "$kind" in
      tracking)
        if [[ "$base" == "tracker-${CURRENT_CAMPAIGN_ID}.md" ]]; then
          PROTECTED_PATHS+=("$path")
        else
          DELETE_PATHS+=("$path")
        fi
        ;;
      artifacts)
        if artifact_belongs_to_current "$path"; then
          PROTECTED_PATHS+=("$path")
        else
          DELETE_PATHS+=("$path")
        fi
        ;;
      session)
        if [[ "$base" == "compact-events.jsonl" ]]; then
          DELETE_PATHS+=("$path")
        elif session_file_belongs_to_current "$base"; then
          PROTECTED_PATHS+=("$path")
        else
          DELETE_PATHS+=("$path")
        fi
        ;;
    esac
  done
}

print_plan() {
  local heading="$1"
  echo "=== campaign cleanup ${heading} ==="
  echo "current-session-id: $CURRENT_SESSION_ID"
  echo "current-campaign-id: $CURRENT_CAMPAIGN_ID"
  echo "--- protected ---"
  if (( ${#PROTECTED_PATHS[@]} == 0 )); then
    echo "  (none)"
  else
    for path in "${PROTECTED_PATHS[@]}"; do
      printf '  - %s\n' "$(display_path "$path")"
    done
  fi
  echo "--- delete candidates ---"
  if (( ${#DELETE_PATHS[@]} == 0 )); then
    echo "  (none)"
  else
    for path in "${DELETE_PATHS[@]}"; do
      printf '  - %s\n' "$(display_path "$path")"
    done
  fi
}

build_plan
print_plan "$COMMAND"

if [[ "$COMMAND" == "inventory" ]]; then
  echo "=== campaign cleanup inventory: PASS ==="
  exit 0
fi

# apply は preflight 完了後にだけ unlink する。rm -rf は使わず regular file だけを削除する。
deleted=0
if (( ${#DELETE_PATHS[@]} > 0 )); then
  for path in "${DELETE_PATHS[@]}"; do
    if [[ -L "$path" ]]; then
      fatal "apply 直前に symlink 化されたため中止します: $(display_path "$path")"
    fi
    [[ -f "$path" ]] || fatal "apply 直前に regular file でなくなったため中止します: $(display_path "$path")"
  done

  for path in "${DELETE_PATHS[@]}"; do
    printf '[DELETE] %s\n' "$(display_path "$path")" >&2
    rm -f -- "$path" || fatal "削除に失敗しました: $(display_path "$path")"
    deleted=$((deleted + 1))
  done
fi

printf 'deleted: %d\n' "$deleted"
exit 0
