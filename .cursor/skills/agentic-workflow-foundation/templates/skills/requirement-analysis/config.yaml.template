# requirement-analysis 実行設定
#
# このファイルを直接編集してモデルや実行パラメータを変更できます。
# mode: seed のため、再生成時に既存の編集内容は上書きされません。

models:
  # 要求正規化 Subagent
  normalize: "{{#if requirement_analysis.models.normalize}}{{requirement_analysis.models.normalize}}{{else}}composer-2.5-fast{{/if}}"
  # 分析深度判定 Subagent
  depth_triage: "{{#if requirement_analysis.models.depth_triage}}{{requirement_analysis.models.depth_triage}}{{else}}composer-2.5-fast{{/if}}"
  # standard 調査 Subagent
  standard_investigation: "{{#if requirement_analysis.models.standard_investigation}}{{requirement_analysis.models.standard_investigation}}{{else}}claude-4.6-opus-high-thinking{{/if}}"

execution:
  # スコア起動の閾値（信号がこの件数以上で deep）
  score_threshold: {{#if requirement_analysis.execution.score_threshold}}{{requirement_analysis.execution.score_threshold}}{{else}}2{{/if}}
  # ゲートあたりの最大再試行回数
  max_gate_retries: {{#if requirement_analysis.execution.max_gate_retries}}{{requirement_analysis.execution.max_gate_retries}}{{else}}3{{/if}}
  # モデル利用不可時の方針: ABORT（即終了）
  model_unavailable: "{{#if requirement_analysis.execution.model_unavailable}}{{requirement_analysis.execution.model_unavailable}}{{else}}ABORT{{/if}}"

# 高影響領域カテゴリ（SoT: manifest.yaml > requirement_analysis.high_impact_categories）
# deep 即時起動条件の判定に使用する
high_impact_categories:
{{#if requirement_analysis.high_impact_categories}}
{{#each requirement_analysis.high_impact_categories}}  - "{{this}}"
{{/each}}
{{else}}
  - "security_or_authorization"
  - "secret_or_sensitive_data"
  - "data_deletion_or_migration"
  - "breaking_external_api"
  - "irreversible_architecture"
  - "unapproved_cost_or_schedule"
  - "must_requirement_conflict"
{{/if}}
