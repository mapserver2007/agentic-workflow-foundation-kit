#!/usr/bin/env bash
set -euo pipefail
set +x

# GitHub App backend。対象 owner/repo の installation を毎回解決し、
# repository-scoped installation token を GITHUB_AUTH_TOKEN に設定する。

readonly GITHUB_APP_CONFIG_ENV="${HOME}/.config/github-apps/config.env"

_base64url() {
  openssl base64 -A | tr '+/' '-_' | tr -d '='
}

_generate_jwt() {
  local private_key_path now header payload header_payload signature
  private_key_path="${GITHUB_APP_PRIVATE_KEY_PATH:-${HOME}/.config/github-apps/private-key.pem}"
  if [[ ! -f "$private_key_path" ]]; then
    echo "ERROR: GitHub App private key が見つかりません" >&2
    return 2
  fi
  now=$(date +%s)

  header=$(printf '{"alg":"RS256","typ":"JWT"}' | _base64url)
  payload=$(printf '{"iss":"%s","iat":%d,"exp":%d}' \
    "$GITHUB_APP_ID" "$((now - 60))" "$((now + 540))" | _base64url)

  header_payload="${header}.${payload}"
  signature=$(printf '%s' "$header_payload" \
    | openssl dgst -sha256 -sign "$private_key_path" -binary \
    | _base64url)

  printf '%s.%s' "$header_payload" "$signature"
}

_github_app_get_token() {
  local owner="$1" repo="$2" operation="$3"
  local jwt installation_id payload parsed permission
  if [[ ! -f "$GITHUB_APP_CONFIG_ENV" ]]; then
    echo "ERROR: GitHub App config が見つかりません。setup.md を参照してください。" >&2
    return 2
  fi
  # shellcheck source=/dev/null
  source "$GITHUB_APP_CONFIG_ENV"
  if [[ -z "${GITHUB_APP_ID:-}" ]]; then
    echo "ERROR: GITHUB_APP_ID が設定されていません" >&2
    return 2
  fi
  jwt=$(_generate_jwt)

  _github_http_request_secret "$jwt" GET \
    "https://api.github.com/repos/${owner}/${repo}/installation" || {
      jwt=""
      echo "ERROR: GitHub App installation lookup transport failed" >&2
      return 2
    }
  jwt=""
  if [[ "$GITHUB_HTTP_CODE" != "200" ]]; then
    _github_api_error "$GITHUB_HTTP_CODE" "$GITHUB_HTTP_BODY"
    GITHUB_HTTP_BODY=""
    return 2
  fi
  installation_id=$(printf '%s' "$GITHUB_HTTP_BODY" | python3 -c '
import json, sys
try:
    value = json.load(sys.stdin)
except Exception:
    value = {}
identifier = value.get("id")
print(identifier if isinstance(identifier, int) else "")
')
  GITHUB_HTTP_BODY=""
  if [[ -z "$installation_id" ]]; then
    echo "ERROR: 対象 repository の installation ID を解決できません" >&2
    return 2
  fi

  payload=$(printf '{"repositories":[%s]}' \
    "$(printf '%s' "$repo" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')")
  jwt=$(_generate_jwt)
  _github_http_request_secret "$jwt" POST \
    "https://api.github.com/app/installations/${installation_id}/access_tokens" \
    "$payload" || {
      jwt=""
      echo "ERROR: GitHub App token transport failed" >&2
      return 2
    }
  jwt=""
  if [[ "$GITHUB_HTTP_CODE" != "201" ]]; then
    _github_api_error "$GITHUB_HTTP_CODE" "$GITHUB_HTTP_BODY"
    GITHUB_HTTP_BODY=""
    return 2
  fi
  parsed=$(printf '%s' "$GITHUB_HTTP_BODY" | python3 -c '
import json, sys
try:
    value = json.load(sys.stdin)
except Exception:
    value = {}
token = value.get("token")
permission = (value.get("permissions") or {}).get("contents", "")
if isinstance(token, str):
    print(token)
    print(permission if isinstance(permission, str) else "")
')
  GITHUB_HTTP_BODY=""
  GITHUB_AUTH_TOKEN="${parsed%%$'\n'*}"
  permission="${parsed#*$'\n'}"
  if [[ -z "$GITHUB_AUTH_TOKEN" || "$parsed" != *$'\n'* ]]; then
    GITHUB_AUTH_TOKEN=""
    echo "ERROR: GitHub App installation token を抽出できません" >&2
    return 2
  fi
  if [[ "$operation" == "git-read" && "$permission" != "read" && "$permission" != "write" ]]; then
    GITHUB_AUTH_TOKEN=""
    echo "ERROR: GitHub App installation に Contents read 権限がありません" >&2
    return 2
  fi
  if [[ "$operation" == "git-write" && "$permission" != "write" ]]; then
    GITHUB_AUTH_TOKEN=""
    echo "ERROR: GitHub App installation に Contents write 権限がありません" >&2
    return 2
  fi
}
