#!/usr/bin/env bash
set -euo pipefail

# Issue 作成（WRITE）
# Usage: github-issue-create-safe <title-file> <body-file> [label1 label2 ...]
# Exit:  0=成功, 1=API エラー, 2=認証エラー

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=_github-auth.sh
source "${SCRIPT_DIR}/_github-auth.sh"

if [[ $# -lt 2 ]]; then
  echo "Usage: github-issue-create-safe <title-file> <body-file> [label1 label2 ...]" >&2
  exit 1
fi

TITLE_FILE="$1"
BODY_FILE="$2"
shift 2
LABELS=("$@")

for f in "$TITLE_FILE" "$BODY_FILE"; do
  if [[ ! -f "$f" ]]; then
    echo "ERROR: ファイルが見つかりません: $f" >&2
    exit 1
  fi
done

_detect_owner_repo
TITLE_JSON=$(python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))' < "$TITLE_FILE")
BODY_JSON=$(python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))' < "$BODY_FILE")

LABELS_JSON="[]"
if [[ ${#LABELS[@]} -gt 0 ]]; then
  LABELS_JSON=$(printf '%s\n' "${LABELS[@]}" | python3 -c 'import sys,json; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))')
fi

PAYLOAD="{\"title\":${TITLE_JSON},\"body\":${BODY_JSON},\"labels\":${LABELS_JSON}}"
_github_api_request "$OWNER" "$REPO" api-write POST \
  "https://api.github.com/repos/${OWNER}/${REPO}/issues" 201 "$PAYLOAD" || exit $?
printf '%s' "$GITHUB_HTTP_BODY" |
  python3 -c 'import json,sys; print(json.load(sys.stdin)["html_url"])'
