#!/usr/bin/env bash
set -euo pipefail

# Issue 作成（WRITE）
# Usage: github-issue-create-safe <title-file> <body-file> [label1 label2 ...]
# Exit:  0=成功, 1=API エラー, 2=認証エラー

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=_github-app-auth.sh
source "${SCRIPT_DIR}/_github-app-auth.sh"

if [[ $# -lt 2 ]]; then
  echo "Usage: github-issue-create-safe <title-file> <body-file> [label1 label2 ...]" >&2
  exit 1
fi

TITLE_FILE="$1"
BODY_FILE="$2"
shift 2
LABELS=("$@")

for f in "$TITLE_FILE" "$BODY_FILE"; do
  if [[ ! -f "$f" ]]; then
    echo "ERROR: ファイルが見つかりません: $f" >&2
    exit 1
  fi
done

_detect_owner_repo
TOKEN=$(_get_installation_token)

TITLE=$(cat "$TITLE_FILE")
BODY_CONTENT=$(cat "$BODY_FILE")

TITLE_JSON=$(printf '%s' "$TITLE" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))')
BODY_JSON=$(python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))' < "$BODY_FILE")

LABELS_JSON="[]"
if [[ ${#LABELS[@]} -gt 0 ]]; then
  LABELS_JSON=$(printf '%s\n' "${LABELS[@]}" | python3 -c 'import sys,json; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))')
fi

RESPONSE=$(curl -s -w "\n%{http_code}" \
  -X POST \
  -H "Authorization: token ${TOKEN}" \
  -H "Accept: application/vnd.github+json" \
  -d "{\"title\":${TITLE_JSON},\"body\":${BODY_JSON},\"labels\":${LABELS_JSON}}" \
  "https://api.github.com/repos/${OWNER}/${REPO}/issues")

HTTP_CODE=$(echo "$RESPONSE" | tail -1)
RESP_BODY=$(echo "$RESPONSE" | sed '$d')

if [[ "$HTTP_CODE" != "201" ]]; then
  echo "ERROR: Issue 作成に失敗しました (HTTP $HTTP_CODE)" >&2
  echo "$RESP_BODY" >&2
  exit 1
fi

echo "$RESP_BODY" | grep -o '"html_url":"[^"]*issues[^"]*"' | head -1 | cut -d'"' -f4
