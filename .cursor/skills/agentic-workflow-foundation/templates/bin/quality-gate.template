#!/usr/bin/env bash
set -u

# quality-gate — アプリ品質ゲートの公開入口 (ADR-0001)
#
# AI・docs・gate scripts は tech stack 固有コマンドを直接実行せず
# 本 wrapper を経由する。backend command は内部実装であり公開しない。
# 基盤保守コマンド（audit/check/scripts/self/generate）は bin/foundation-gate を使う。
#
# Usage:
#   bin/quality-gate <SUBCMD>
#
# Subcommands:
#   gen      — 下流 G-GEN（backend gen_cmd を実行）
#   build    — 下流 G-BUILD（backend build_cmd を実行）
#   lint     — 下流 G-LINT（backend lint_cmd を実行）
#   test     — 下流 G-TEST（backend test_cmd を実行）
#   verify   — 下流 build → lint → test（G-GEN を含めない）
#
# Exit codes:
#   0 = PASS
#   1 = FAIL（修正可能）
#   2 = 致命的エラー（引数不正 / 設定不備）

readonly SCRIPT_NAME="quality-gate"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

SUBCMD="${1:-}"
if [[ -z "$SUBCMD" ]]; then
  echo "ERROR: Usage: bin/${SCRIPT_NAME} <gen|build|lint|test|verify>" >&2
  exit 2
fi

# --- downstream project commands (backend) ---

_run_backend() {
  if [[ "$#" -eq 0 ]]; then
    echo "ERROR: approved argv is not configured. Run tech-contract status." >&2
    return 2
  fi
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "ERROR: backend command not found: $1" >&2
    return 2
  fi
  "$@"
  local code=$?
  case "$code" in
    0) return 0 ;;
    2) return 2 ;;
    127) echo "ERROR: backend command not found: $1" >&2; return 2 ;;
    *) return 1 ;;
  esac
}

_contract_status() {
  local design_doc="$ROOT_DIR/.cursor/docs/{{project.tech_stack_design_filename}}"
  python3 "$ROOT_DIR/.cursor/skills/agentic-workflow-foundation/scripts/tech_contract.py" \
    status \
    --manifest "$ROOT_DIR/manifest.yaml" \
    --design-doc "$design_doc"
}

_preflight() {
  if [[ ! -x "$ROOT_DIR/bin/project-setup" ]]; then
    echo "ERROR: provisioning wrapper がありません。bin/project-setup --plan を確認してください。" >&2
    return 2
  fi
  "$ROOT_DIR/bin/project-setup" --preflight
}

case "$SUBCMD" in
  gen)
    cmd=({{#each tech_contract.quality_gate.gen.argv}} "{{this}}"{{/each}} )
    _contract_status && _preflight && _run_backend "${cmd[@]}"
    ;;
  build)
    cmd=({{#each tech_contract.quality_gate.build.argv}} "{{this}}"{{/each}} )
    _contract_status && _preflight && _run_backend "${cmd[@]}"
    ;;
  lint)
    cmd=({{#each tech_contract.quality_gate.lint.argv}} "{{this}}"{{/each}} )
    _contract_status && _preflight && _run_backend "${cmd[@]}"
    ;;
  test)
    cmd=({{#each tech_contract.quality_gate.test.argv}} "{{this}}"{{/each}} )
    _contract_status && _preflight && _run_backend "${cmd[@]}"
    ;;
  verify)
    echo "=== quality-gate verify ==="
    build_cmd=({{#each tech_contract.quality_gate.build.argv}} "{{this}}"{{/each}} )
    lint_cmd=({{#each tech_contract.quality_gate.lint.argv}} "{{this}}"{{/each}} )
    test_cmd=({{#each tech_contract.quality_gate.test.argv}} "{{this}}"{{/each}} )
    _contract_status && _preflight && \
    _run_backend "${build_cmd[@]}" && \
    _run_backend "${lint_cmd[@]}" && \
    _run_backend "${test_cmd[@]}"
    ;;
  audit|check|scripts|self|adr)
    echo "ERROR: '$SUBCMD' は bin/quality-gate から削除されました（ADR-0001）。" >&2
    if [[ "$SUBCMD" == "adr" ]]; then
      echo "ADR 検査は workflow-gate.sh adr を使用してください。" >&2
    else
      echo "基盤保守コマンドは bin/foundation-gate を使用してください。" >&2
    fi
    exit 2
    ;;
  *)
    echo "ERROR: unknown subcommand '$SUBCMD'." >&2
    echo "Available: gen | build | lint | test | verify" >&2
    exit 2
    ;;
esac
