#!/usr/bin/env bash
set -u

# quality-gate — Quality Gate の単一公開入口 (ADR-0001)
#
# AI・docs・gate scripts は tech stack 固有コマンドを直接実行せず
# 本 wrapper を経由する。backend command は内部実装であり公開しない。
#
# Usage:
#   bin/quality-gate <SUBCMD>
#
# Subcommands:
#   self     — kit 全自己検証（audit + scripts）
#   audit    — run_resolved_engine.py audit（冪等性・必須要件検査）
#   check    — run_resolved_engine.py check（冪等性ドライラン）
#   scripts  — foundation test_*.py を固定順序で実行
#   gen      — 下流 G-GEN（backend gen_cmd を実行）
#   build    — 下流 G-BUILD（backend build_cmd を実行）
#   lint     — 下流 G-LINT（backend lint_cmd を実行）
#   test     — 下流 G-TEST（backend test_cmd を実行）
#   verify   — 下流 build → lint → test（G-GEN を含めない）
#
# Exit codes:
#   0 = PASS
#   1 = FAIL（修正可能）
#   2 = 致命的エラー（引数不正 / 設定不備）

readonly SCRIPT_NAME="quality-gate"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly FOUNDATION_SCRIPTS="$ROOT_DIR/.cursor/skills/agentic-workflow-foundation/scripts"

SUBCMD="${1:-}"
if [[ -z "$SUBCMD" ]]; then
  echo "ERROR: Usage: bin/${SCRIPT_NAME} <audit|check|scripts|self|gen|build|lint|test|verify>" >&2
  exit 2
fi

# --- self-verification commands ---

_run_audit() {
  python3 "$FOUNDATION_SCRIPTS/run_resolved_engine.py" audit
}

_run_check() {
  python3 "$FOUNDATION_SCRIPTS/run_resolved_engine.py" check
}

_run_scripts() {
  local runner="$FOUNDATION_SCRIPTS/run_all_foundation_tests.py"
  if [[ ! -f "$runner" ]]; then
    echo "ERROR: foundation test runner not found: $runner" >&2
    return 2
  fi
  python3 "$runner"
}

# --- downstream project commands (backend) ---

_run_backend() {
  local cmd="$1"
  if [[ -z "$cmd" || "$cmd" == \[* ]]; then
    echo "WARN: backend command is not configured (placeholder). Skipping." >&2
    return 0
  fi
  bash -lc "$cmd"
}

case "$SUBCMD" in
  audit)
    _run_audit
    ;;
  check)
    _run_check
    ;;
  scripts)
    _run_scripts
    ;;
  self)
    echo "=== quality-gate self ==="
    echo "--- audit ---"
    _run_audit
    audit_exit=$?
    if [[ $audit_exit -ne 0 ]]; then
      echo "FAIL: audit exited with $audit_exit" >&2
      exit $audit_exit
    fi
    echo "--- scripts ---"
    _run_scripts
    ;;
  gen)
    _run_backend "{{project.quality_gate.gen_cmd}}"
    ;;
  build)
    _run_backend "{{project.quality_gate.build_cmd}}"
    ;;
  lint)
    _run_backend "{{project.quality_gate.lint_cmd}}"
    ;;
  test)
    _run_backend "{{project.quality_gate.test_cmd}}"
    ;;
  verify)
    echo "=== quality-gate verify ==="
    _run_backend "{{project.quality_gate.build_cmd}}" && \
    _run_backend "{{project.quality_gate.lint_cmd}}" && \
    _run_backend "{{project.quality_gate.test_cmd}}"
    ;;
  *)
    echo "ERROR: unknown subcommand '$SUBCMD'." >&2
    echo "Available: audit | check | scripts | self | gen | build | lint | test | verify" >&2
    exit 2
    ;;
esac
