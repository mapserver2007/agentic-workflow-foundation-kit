#!/usr/bin/env bash
set -u

# quality-gate — アプリ品質ゲートの公開入口 (ADR-0001)
#
# AI・docs・gate scripts は tech stack 固有コマンドを直接実行せず
# 本 wrapper を経由する。backend command は内部実装であり公開しない。
# 基盤保守コマンド（audit/check/scripts/self/generate）は bin/foundation-gate を使う。
#
# Usage:
#   bin/quality-gate <SUBCMD>
#
# Subcommands:
#   gen      — 下流 G-GEN（backend gen_cmd を実行）
#   build    — 下流 G-BUILD（backend build_cmd を実行）
#   lint     — 下流 G-LINT（backend lint_cmd を実行）
#   test     — 下流 G-TEST（backend test_cmd を実行）
#   verify   — 下流 build → lint → test（G-GEN を含めない）
#
# Exit codes:
#   0 = PASS
#   1 = FAIL（修正可能）
#   2 = 致命的エラー（引数不正 / 設定不備）

readonly SCRIPT_NAME="quality-gate"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

SUBCMD="${1:-}"
if [[ -z "$SUBCMD" ]]; then
  echo "ERROR: Usage: bin/${SCRIPT_NAME} <gen|build|lint|test|verify>" >&2
  exit 2
fi

# --- downstream project commands (backend) ---

_run_backend() {
  local cmd="$1"
  if [[ -z "$cmd" || "$cmd" == \[* ]]; then
    echo "WARN: backend command is not configured (placeholder). Skipping." >&2
    return 0
  fi
  bash -lc "$cmd"
}

case "$SUBCMD" in
  gen)
    _run_backend "{{project.quality_gate.gen_cmd}}"
    ;;
  build)
    _run_backend "{{project.quality_gate.build_cmd}}"
    ;;
  lint)
    _run_backend "{{project.quality_gate.lint_cmd}}"
    ;;
  test)
    _run_backend "{{project.quality_gate.test_cmd}}"
    ;;
  verify)
    echo "=== quality-gate verify ==="
    _run_backend "{{project.quality_gate.build_cmd}}" && \
    _run_backend "{{project.quality_gate.lint_cmd}}" && \
    _run_backend "{{project.quality_gate.test_cmd}}"
    ;;
  audit|check|scripts|self|adr)
    echo "ERROR: '$SUBCMD' は bin/quality-gate から削除されました（ADR-0001）。" >&2
    if [[ "$SUBCMD" == "adr" ]]; then
      echo "ADR 検査は workflow-gate.sh adr を使用してください。" >&2
    else
      echo "基盤保守コマンドは bin/foundation-gate を使用してください。" >&2
    fi
    exit 2
    ;;
  *)
    echo "ERROR: unknown subcommand '$SUBCMD'." >&2
    echo "Available: gen | build | lint | test | verify" >&2
    exit 2
    ;;
esac
