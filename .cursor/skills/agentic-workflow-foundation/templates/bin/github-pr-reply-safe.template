#!/usr/bin/env bash
set -euo pipefail

# レビューコメント reply（WRITE）
# Usage: github-pr-reply-safe <pr-number> <comment-id> <body-file>
# Exit:  0=成功, 1=API エラー, 2=認証エラー

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=_github-app-auth.sh
source "${SCRIPT_DIR}/_github-app-auth.sh"

if [[ $# -lt 3 ]]; then
  echo "Usage: github-pr-reply-safe <pr-number> <comment-id> <body-file>" >&2
  exit 1
fi

PR_NUMBER="$1"
COMMENT_ID="$2"
BODY_FILE="$3"

if [[ ! -f "$BODY_FILE" ]]; then
  echo "ERROR: body file が見つかりません: $BODY_FILE" >&2
  exit 1
fi

_detect_owner_repo
TOKEN=$(_get_installation_token)

BODY_JSON=$(python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))' < "$BODY_FILE")

# REST API でレビューコメントに reply
# pull_request_review_comment_id を使い pulls/comments への reply を投稿
RESPONSE=$(curl -s -w "\n%{http_code}" \
  -X POST \
  -H "Authorization: token ${TOKEN}" \
  -H "Accept: application/vnd.github+json" \
  -d "{\"body\":${BODY_JSON}}" \
  "https://api.github.com/repos/${OWNER}/${REPO}/pulls/${PR_NUMBER}/comments/${COMMENT_ID}/replies")

HTTP_CODE=$(echo "$RESPONSE" | tail -1)
BODY=$(echo "$RESPONSE" | sed '$d')

if [[ "$HTTP_CODE" != "201" ]]; then
  echo "ERROR: GitHub API エラー (HTTP $HTTP_CODE)" >&2
  echo "$BODY" >&2
  exit 1
fi

echo "$BODY" | python3 -c 'import json,sys; print(json.load(sys.stdin)["html_url"])'
