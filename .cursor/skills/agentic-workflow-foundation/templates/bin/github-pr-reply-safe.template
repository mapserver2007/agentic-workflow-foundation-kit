#!/usr/bin/env bash
set -euo pipefail

# レビューコメント reply（WRITE）
# Usage: github-pr-reply-safe <pr-number> <comment-id> <body-file>
# Exit:  0=成功, 1=API エラー, 2=認証エラー

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=_github-auth.sh
source "${SCRIPT_DIR}/_github-auth.sh"

if [[ $# -lt 3 ]]; then
  echo "Usage: github-pr-reply-safe <pr-number> <comment-id> <body-file>" >&2
  exit 1
fi

PR_NUMBER="$1"
COMMENT_ID="$2"
BODY_FILE="$3"

_github_validate_positive_id "PR number" "$PR_NUMBER" || exit $?
COMMENT_ID=$(_github_normalize_comment_id "$COMMENT_ID") || exit $?

if [[ ! -f "$BODY_FILE" ]]; then
  echo "ERROR: body file が見つかりません: $BODY_FILE" >&2
  exit 1
fi

_detect_owner_repo
BODY_JSON=$(python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))' < "$BODY_FILE")

# REST API でレビューコメントに reply
# pull_request_review_comment_id を使い pulls/comments への reply を投稿
_github_api_request "$OWNER" "$REPO" api-write POST \
  "https://api.github.com/repos/${OWNER}/${REPO}/pulls/${PR_NUMBER}/comments/${COMMENT_ID}/replies" \
  201 "{\"body\":${BODY_JSON}}" || exit $?
printf '%s' "$GITHUB_HTTP_BODY" |
  python3 -c 'import json,sys; print(json.load(sys.stdin)["html_url"])'
