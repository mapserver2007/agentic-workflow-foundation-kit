#!/usr/bin/env bash
set -euo pipefail

# レビュースレッド取得（READ）
# Usage: github-pr-reviews-safe <owner> <repo> <pr-number>
# Exit:  0=成功, 1=API エラー, 2=認証エラー

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=_github-auth.sh
source "${SCRIPT_DIR}/_github-auth.sh"

if [[ $# -lt 3 ]]; then
  echo "Usage: github-pr-reviews-safe <owner> <repo> <pr-number>" >&2
  exit 1
fi

OWNER="$1"
REPO="$2"
PR_NUMBER="$3"
_github_validate_name owner "$OWNER" || exit 2
_github_validate_name repo "$REPO" || exit 2
if ! [[ "$PR_NUMBER" =~ ^[0-9]+$ ]]; then
  echo "ERROR: PR number must be numeric" >&2
  exit 1
fi

QUERY='query($owner:String!,$repo:String!,$number:Int!){repository(owner:$owner,name:$repo){pullRequest(number:$number){reviewThreads(first:100){nodes{isResolved isOutdated isCollapsed comments(first:50){nodes{body path line url author{login __typename}}}}}}}}'

VARIABLES=$(printf '{"owner":"%s","repo":"%s","number":%s}' "$OWNER" "$REPO" "$PR_NUMBER")

PAYLOAD="{\"query\":$(printf '%s' "$QUERY" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))'),\"variables\":${VARIABLES}}"
_github_api_request "$OWNER" "$REPO" api-read POST \
  "https://api.github.com/graphql" 200 "$PAYLOAD" || exit $?
printf '%s\n' "$GITHUB_HTTP_BODY"
