#!/usr/bin/env bash
set -euo pipefail

# PR 作成（WRITE）
# Usage: github-pr-create-safe <base-branch> <title-file> <body-file>
# Exit:  0=成功, 1=API エラー, 2=認証エラー

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=_github-auth.sh
source "${SCRIPT_DIR}/_github-auth.sh"

if [[ $# -lt 3 ]]; then
  echo "Usage: github-pr-create-safe <base-branch> <title-file> <body-file>" >&2
  exit 1
fi

BASE_BRANCH="$1"
TITLE_FILE="$2"
BODY_FILE="$3"

for f in "$TITLE_FILE" "$BODY_FILE"; do
  if [[ ! -f "$f" ]]; then
    echo "ERROR: ファイルが見つかりません: $f" >&2
    exit 1
  fi
done

HEAD_BRANCH=$(git branch --show-current)
if [[ -z "$HEAD_BRANCH" ]]; then
  echo "ERROR: デタッチド HEAD 状態です。ブランチをチェックアウトしてください。" >&2
  exit 1
fi

_detect_owner_repo

# push（SSH origin でも invocation 単位で HTTPS URL に上書き）
if ! _github_git_with_remote "." origin git-write push -u origin HEAD; then
  echo "ERROR: git push に失敗しました" >&2
  exit 1
fi

TITLE_JSON=$(python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))' < "$TITLE_FILE")
BODY_JSON=$(python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))' < "$BODY_FILE")
HEAD_JSON=$(printf '%s' "$HEAD_BRANCH" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))')
BASE_JSON=$(printf '%s' "$BASE_BRANCH" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))')
PAYLOAD="{\"title\":${TITLE_JSON},\"body\":${BODY_JSON},\"head\":${HEAD_JSON},\"base\":${BASE_JSON}}"
_github_api_request "$OWNER" "$REPO" api-write POST \
  "https://api.github.com/repos/${OWNER}/${REPO}/pulls" 201 "$PAYLOAD" || exit $?
printf '%s' "$GITHUB_HTTP_BODY" |
  python3 -c 'import json,sys; print(json.load(sys.stdin)["html_url"])'
