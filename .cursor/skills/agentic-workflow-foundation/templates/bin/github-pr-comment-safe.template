#!/usr/bin/env bash
set -euo pipefail

# PR コメント投稿（WRITE）
# Usage: github-pr-comment-safe <pr-number> <body-file>
# Exit:  0=成功, 1=API エラー, 2=認証エラー

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=_github-auth.sh
source "${SCRIPT_DIR}/_github-auth.sh"

if [[ $# -lt 2 ]]; then
  echo "Usage: github-pr-comment-safe <pr-number> <body-file>" >&2
  exit 1
fi

PR_NUMBER="$1"
BODY_FILE="$2"

if [[ ! -f "$BODY_FILE" ]]; then
  echo "ERROR: body file が見つかりません: $BODY_FILE" >&2
  exit 1
fi

_detect_owner_repo
BODY_JSON=$(python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))' < "$BODY_FILE")
_github_api_request "$OWNER" "$REPO" api-write POST \
  "https://api.github.com/repos/${OWNER}/${REPO}/issues/${PR_NUMBER}/comments" \
  201 "{\"body\":${BODY_JSON}}" || exit $?
printf '%s' "$GITHUB_HTTP_BODY" |
  python3 -c 'import json,sys; print(json.load(sys.stdin)["html_url"])'
