#!/usr/bin/env bash
# session-bootstrap.sh  [generated by agentic-workflow-foundation skill]
# Cursor sessionStart Hook: コンテキスト予算追跡用 state ファイルを初期化し、
# 既存 handoff manifest があれば additional_context として新セッションに注入する。
# 仕様: AGENTS.md > Context Budget Protocol / docs/CONTEXT_BUDGET.md / .cursor/hooks/README.md
# 設計: フェイルオープン（スクリプト障害時は素通り）

set -uo pipefail

INPUT="$(cat 2>/dev/null)" || { echo '{}'; exit 0; }
if [[ -z "$INPUT" ]]; then
  echo '{}'
  exit 0
fi
if ! command -v jq >/dev/null 2>&1; then
  echo '{}'
  exit 0
fi

SESSION_ID="$(jq -r '.session_id // empty' <<<"$INPUT" 2>/dev/null)" || { echo '{}'; exit 0; }
if [[ -z "$SESSION_ID" ]]; then
  echo '{}'
  exit 0
fi

# パストラバーサル防止: SESSION_ID は許可文字のみ受け付ける。
if ! [[ "$SESSION_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo '{}'
  exit 0
fi

PROJECT_DIR="${CURSOR_PROJECT_DIR:-$(pwd)}"
SESSION_DIR="$PROJECT_DIR/.cursor/.session"
STATE_FILE="$SESSION_DIR/${SESSION_ID}.json"

mkdir -p "$SESSION_DIR" 2>/dev/null || { echo '{}'; exit 0; }

NOW_UNIX="$(date +%s)"
NOW_ISO="$(date -Iseconds 2>/dev/null || date +%Y-%m-%dT%H:%M:%S%z)"

jq -n \
  --arg sid "$SESSION_ID" \
  --arg cid "$SESSION_ID" \
  --argjson started_at_unix "$NOW_UNIX" \
  --arg started_at_iso "$NOW_ISO" \
  '{
    session_id: $sid,
    campaign_id: $cid,
    started_at_unix: $started_at_unix,
    started_at_iso: $started_at_iso,
    prompt_count: 0,
    shell_bytes: 0,
    edit_count: 0,
    last_warning_level: "none",
    last_compact_usage_percent: null,
    last_compact_at: null,
    compact_trigger: null,
    compact_count: 0
  }' > "$STATE_FILE.tmp" 2>/dev/null && mv "$STATE_FILE.tmp" "$STATE_FILE" 2>/dev/null

# ---- handoff manifest スキャン（並行セッション対応） ----
ADDITIONAL_CONTEXT=""
MAX_INJECTION_BYTES={{framework.budget_thresholds.max_injection_bytes}}

# handoff-*.md を収集（handoff-consumed-* を除外）
HANDOFF_FILES=()
for hf in "$SESSION_DIR"/handoff-*.md; do
  [[ -f "$hf" ]] || continue
  case "$(basename "$hf")" in
    handoff-consumed-*) continue ;;
  esac
  HANDOFF_FILES+=("$hf")
done

HANDOFF_COUNT=${#HANDOFF_FILES[@]}

# ---- campaign_id の mint / bind ----
# campaign_id は campaign の親 ID（創設 session_id と同値）であり、
# session_id は現在チャットの runtime ID に限定する。
extract_campaign_id() {
  local HANDOFF_FILE="$1"
  local CANDIDATE
  CANDIDATE="$(grep -E '^[[:space:]]*(-[[:space:]]*)?campaign_id:[[:space:]]*[A-Za-z0-9._-]+[[:space:]]*$' "$HANDOFF_FILE" 2>/dev/null \
    | head -n 1 \
    | sed -E 's/^[[:space:]]*(-[[:space:]]*)?campaign_id:[[:space:]]*//; s/[[:space:]]*$//')" || CANDIDATE=""
  if [[ "$CANDIDATE" =~ ^[A-Za-z0-9._-]+$ ]]; then
    printf '%s' "$CANDIDATE"
  fi
}

CAMPAIGN_ID="$SESSION_ID"
CAMPAIGN_ID_SOURCE="session_start"
if (( HANDOFF_COUNT == 1 )); then
  HANDOFF_CAMPAIGN_ID="$(extract_campaign_id "${HANDOFF_FILES[0]}")"
  if [[ -n "$HANDOFF_CAMPAIGN_ID" ]]; then
    CAMPAIGN_ID="$HANDOFF_CAMPAIGN_ID"
    CAMPAIGN_ID_SOURCE="handoff"
  fi
fi

# state は sessionStart で必ず campaign_id を持つ。2+ handoff はユーザー選択前に
# 自動 bind せず、現在 session の ID を仮の創設 ID として保持する。
jq --arg cid "$CAMPAIGN_ID" --arg source "$CAMPAIGN_ID_SOURCE" \
  '.campaign_id = $cid | .campaign_id_source = $source' \
  "$STATE_FILE" > "$STATE_FILE.tmp" 2>/dev/null && mv "$STATE_FILE.tmp" "$STATE_FILE" 2>/dev/null

# ---- handoff 注入ヘルパー（1 件の handoff を注入 + consumed リネーム） ----
inject_handoff() {
  local TARGET_FILE="$1"
  local TARGET_BASENAME
  TARGET_BASENAME="$(basename "$TARGET_FILE" .md)"
  local HANDOFF_CONTENT
  HANDOFF_CONTENT="$(cat "$TARGET_FILE" 2>/dev/null)" || HANDOFF_CONTENT=""
  [[ -n "$HANDOFF_CONTENT" ]] || return 0

  local HANDOFF_SIZE=${#HANDOFF_CONTENT}
  local SIZE_WARNING=""
  if (( HANDOFF_SIZE > MAX_INJECTION_BYTES )); then
    HANDOFF_CONTENT="$(head -c "$MAX_INJECTION_BYTES" <<<"$HANDOFF_CONTENT" 2>/dev/null)"
    SIZE_WARNING="
警告: manifest が ${HANDOFF_SIZE} bytes あり、注入上限 ${MAX_INJECTION_BYTES} bytes で切り詰めました。manifest 内「ポインタ」に記載された追跡ドキュメントを直接 Read して全体を補完してください。"
  fi

  local MISSING_SECTIONS=""
  for HEADING in "ポインタ" "直近のユーザー依頼" "セッション判断ログ" "採用した判断と根拠" "却下した案と却下理由" "制約・ブロッカー" "次セッションの推奨アクション"; do
    if ! grep -q "$HEADING" <<<"$HANDOFF_CONTENT" 2>/dev/null; then
      MISSING_SECTIONS="${MISSING_SECTIONS}- ${HEADING}\n"
    fi
  done
  local QUALITY_WARNING=""
  if [[ -n "$MISSING_SECTIONS" ]]; then
    QUALITY_WARNING="
警告: manifest に以下の必須見出しが欠落しています。manifest 内「ポインタ」に記載された追跡ドキュメントを直接 Read して補完してください:
$(printf '%b' "$MISSING_SECTIONS")"
  fi
  QUALITY_WARNING="${SIZE_WARNING}${QUALITY_WARNING}"

  ADDITIONAL_CONTEXT="[CONTEXT_BUDGET_HANDOFF] 前セッションから引き継ぎ manifest を読み込みました（${TARGET_BASENAME}）。${QUALITY_WARNING}

復旧手順:
1. まず manifest 内「ポインタ」に記載された追跡ドキュメントを Read し、フェーズと制約を確認せよ
2. manifest の「セッション判断ログ」「制約・ブロッカー」を追跡ドキュメントに反映せよ（未反映の揮発情報がある場合）
3. 追跡ドキュメントの指示に従って作業を再開せよ

行動制約:
{{#each framework.handoff.recovery_constraints}}- {{this}}
{{/each}}

---
$HANDOFF_CONTENT
---

注意: 上記の manifest は \`$(basename "$TARGET_FILE")\` から読み込まれ、消費済みとして自動アーカイブされます。"

  # consumed リネーム（元セッション ID + タイムスタンプでトレーサビリティ確保）
  local ORIG_SID="${TARGET_BASENAME#handoff-}"
  local CONSUMED_FILE="$SESSION_DIR/handoff-consumed-${ORIG_SID}-${NOW_UNIX}.md"
  mv "$TARGET_FILE" "$CONSUMED_FILE" 2>/dev/null || true
}

# ---- 0/1/2+ 分岐 ----
if (( HANDOFF_COUNT == 1 )); then
  # 1 件: auto-inject + consumed リネーム
  inject_handoff "${HANDOFF_FILES[0]}"
elif (( HANDOFF_COUNT >= 2 )); then
  # 2+ 件: AskQuestion マーカー付き additional_context 注入
  HANDOFF_LIST=""
  for hf in "${HANDOFF_FILES[@]}"; do
    HF_BASENAME="$(basename "$hf")"
    HF_MTIME="$(date -r "$hf" -Iseconds 2>/dev/null || stat -c '%y' "$hf" 2>/dev/null || echo "unknown")"
    HANDOFF_LIST="${HANDOFF_LIST}
- ${HF_BASENAME} (最終更新: ${HF_MTIME})"
  done
  ADDITIONAL_CONTEXT="[CONTEXT_BUDGET_HANDOFF_SELECT] 複数の handoff manifest が検出されました（${HANDOFF_COUNT} 件）。ユーザーに AskQuestion でどの handoff を読み込むか選択させてください。

検出された handoff:
${HANDOFF_LIST}

AI への指示:
1. ユーザーに AskQuestion を使ってどの handoff を読み込むか選択させよ（ファイル名と最終更新時刻を選択肢として提示）
2. 選択された handoff ファイルを Read し、manifest 内「ポインタ」に記載された追跡ドキュメントを Read して復旧手順を実行せよ
3. 選択された handoff を consumed にリネームせよ: mv .cursor/.session/handoff-{sid}.md .cursor/.session/handoff-consumed-{sid}-\$(date +%s).md
4. 選択されなかった handoff は後続セッションで消費可能（そのまま残す）"
fi

# ---- スナップショット突合（pre-compact snapshot と handoff manifest の整合チェック） ----
RECONCILIATION_WARNING=""
LATEST_SNAPSHOT=""
for snap in "$SESSION_DIR"/pre-compact-*.md; do
  [[ -f "$snap" ]] || continue
  if [[ -z "$LATEST_SNAPSHOT" ]] || [[ "$snap" -nt "$LATEST_SNAPSHOT" ]]; then
    LATEST_SNAPSHOT="$snap"
  fi
done
if [[ -n "$LATEST_SNAPSHOT" ]] && [[ -n "$ADDITIONAL_CONTEXT" ]]; then
  SNAP_CONTENT="$(cat "$LATEST_SNAPSHOT" 2>/dev/null)" || SNAP_CONTENT=""
  if [[ -n "$SNAP_CONTENT" ]]; then
    SNAP_HAS_INCOMPLETE=false
    if echo "$SNAP_CONTENT" | grep -qE '^\s*- \[ \]' 2>/dev/null; then
      SNAP_HAS_INCOMPLETE=true
    fi
    MANIFEST_MENTIONS_POINTER=false
    if echo "$ADDITIONAL_CONTEXT" | grep -q "ポインタ" 2>/dev/null; then
      MANIFEST_MENTIONS_POINTER=true
    fi
    if [[ "$SNAP_HAS_INCOMPLETE" == "true" ]] && [[ "$MANIFEST_MENTIONS_POINTER" == "false" ]]; then
      RECONCILIATION_WARNING="
警告（スナップショット突合）: pre-compact snapshot に未完了タスクがありますが、manifest にポインタが見つかりません。.cursor/.tracking/ 配下の tracker ファイルを正として読み直してください。"
    fi
  fi
fi
if [[ -n "$RECONCILIATION_WARNING" ]]; then
  ADDITIONAL_CONTEXT="${ADDITIONAL_CONTEXT}${RECONCILIATION_WARNING}"
fi

# ---- pre-compact snapshot からの fallback 注入（handoff manifest なし時） ----
if [[ -z "$ADDITIONAL_CONTEXT" ]] && [[ -n "$LATEST_SNAPSHOT" ]]; then
  SNAP_CONTENT="$(cat "$LATEST_SNAPSHOT" 2>/dev/null)" || SNAP_CONTENT=""
  if [[ -n "$SNAP_CONTENT" ]]; then
    SNAP_SIZE=${#SNAP_CONTENT}
    if (( SNAP_SIZE > MAX_INJECTION_BYTES )); then
      SNAP_CONTENT="$(head -c "$MAX_INJECTION_BYTES" <<<"$SNAP_CONTENT" 2>/dev/null)"
    fi
    RECENT_PROMPTS=""
    if echo "$SNAP_CONTENT" | grep -q "直近のターンログ" 2>/dev/null; then
      RECENT_PROMPTS="$(echo "$SNAP_CONTENT" | sed -n '/## 直近のターンログ/,/## /p' 2>/dev/null | grep '"turn_type":"prompt"' 2>/dev/null | tail -5)" || RECENT_PROMPTS=""
    fi
    PROMPT_SUMMARY=""
    if [[ -n "$RECENT_PROMPTS" ]]; then
      PROMPT_SUMMARY="

直近のユーザー依頼（turns.jsonl から抽出）:
$(echo "$RECENT_PROMPTS" | jq -r '.summary // empty' 2>/dev/null | tail -3)"
    fi
    ADDITIONAL_CONTEXT="[CONTEXT_BUDGET_SNAPSHOT_FALLBACK] handoff manifest が存在しないため、pre-compact snapshot から文脈を復元します。${PROMPT_SUMMARY}

復旧手順:
1. .cursor/.tracking/ 配下の tracker ファイルを Read し、フェーズと制約を確認せよ
2. snapshot 内の tracker セクションと実ファイルを突合し、差分があれば実ファイルを正とせよ
3. 追跡ドキュメントの指示に従って作業を再開せよ

---
${SNAP_CONTENT}
---"
  fi
fi

# ---- 出力 ----
if [[ -n "$ADDITIONAL_CONTEXT" ]]; then
  jq -n \
    --arg sid "$SESSION_ID" \
    --arg ctx "$ADDITIONAL_CONTEXT" \
    '{
      env: { CTX_BUDGET_SESSION_ID: $sid },
      additional_context: $ctx
    }'
else
  jq -n \
    --arg sid "$SESSION_ID" \
    '{
      env: { CTX_BUDGET_SESSION_ID: $sid }
    }'
fi
exit 0
