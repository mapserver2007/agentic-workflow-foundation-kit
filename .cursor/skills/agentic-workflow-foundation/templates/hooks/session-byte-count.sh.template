#!/usr/bin/env bash
# session-byte-count.sh  [generated by agentic-workflow-foundation skill]
# Context Budget の UTF-8 byte-count / 安全な先頭・末尾切詰め helper。
#
# source 専用ライブラリ:
#   - stdin を消費しない
#   - source 時に出力しない
#   - shell option を変更しない
#   - source された側の shell を exit しない
#
# API:
#   session_byte_count TEXT
#     stdout に UTF-8 byte 数を出力する。
#   session_byte_prefix MAX_BYTES TEXT
#     stdout に先頭 MAX_BYTES 以下の UTF-8 妥当な文字列を出力する。
#   session_byte_suffix MAX_BYTES TEXT
#     stdout に末尾 MAX_BYTES 以下の UTF-8 妥当な文字列を出力する。
#
# return contract:
#   0   成功（MAX_BYTES=0 は空文字列）
#   2   引数不正または入力が UTF-8 として不正
#   127 python3 不在など実行時依存の欠落
# 呼出側はこの return を使い、観測 Hook は fail-open、
# session-progress-append.sh は fail-closed を維持する。

session_byte_count() {
  if (( $# != 1 )); then
    return 2
  fi
  local text="$1"
  local validation_status
  LC_ALL=C printf '%s' "$text" | python3 -c '
import sys

try:
    sys.stdin.buffer.read().decode("utf-8")
except UnicodeDecodeError:
    raise SystemExit(2)
' >/dev/null 2>&1
  validation_status=$?
  if (( validation_status != 0 )); then
    return "$validation_status"
  fi
  LC_ALL=C printf '%s' "$text" | wc -c | tr -d '[:space:]'
}

session_byte_prefix() {
  if (( $# != 2 )); then
    return 2
  fi
  local max_bytes="$1"
  local text="$2"
  if ! [[ "$max_bytes" =~ ^[0-9]+$ ]]; then
    return 2
  fi
  printf '%s' "$text" | python3 -c '
import sys

limit = int(sys.argv[1])
data = sys.stdin.buffer.read()
try:
    text = data.decode("utf-8")
except UnicodeDecodeError:
    raise SystemExit(2)
result = data[:limit].decode("utf-8", "ignore")
sys.stdout.buffer.write(result.encode("utf-8"))
' "$max_bytes"
}

session_byte_suffix() {
  if (( $# != 2 )); then
    return 2
  fi
  local max_bytes="$1"
  local text="$2"
  if ! [[ "$max_bytes" =~ ^[0-9]+$ ]]; then
    return 2
  fi
  printf '%s' "$text" | python3 -c '
import sys

limit = int(sys.argv[1])
data = sys.stdin.buffer.read()
try:
    text = data.decode("utf-8")
except UnicodeDecodeError:
    raise SystemExit(2)
if limit == 0:
    result = ""
else:
    result = data[-limit:].decode("utf-8", "ignore")
sys.stdout.buffer.write(result.encode("utf-8"))
' "$max_bytes"
}
