#!/usr/bin/env bash
# session-progress-append.sh  [generated by agentic-workflow-foundation skill]
# progress.jsonl への明示追記 helper（Hook ではない）。
# 設計: fail_open / flock / kind=review_start のみ / session ID fallback なし

set -uo pipefail

emit_ok() {
  echo '{}'
  exit 0
}

if ! command -v jq >/dev/null 2>&1; then
  emit_ok
fi

KIND=""
SUMMARY=""
EXTRA_RAW=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --kind)
      KIND="${2:-}"
      shift 2 || true
      ;;
    --kind=*)
      KIND="${1#--kind=}"
      shift
      ;;
    --summary)
      SUMMARY="${2:-}"
      shift 2 || true
      ;;
    --summary=*)
      SUMMARY="${1#--summary=}"
      shift
      ;;
    --extra)
      EXTRA_RAW="${2:-}"
      shift 2 || true
      ;;
    --extra=*)
      EXTRA_RAW="${1#--extra=}"
      shift
      ;;
    *)
      shift
      ;;
  esac
done

if [[ "$KIND" != "review_start" ]]; then
  emit_ok
fi

if [[ -z "$SUMMARY" ]]; then
  SUMMARY="PRレビュー検証開始"
fi

if [[ -z "$EXTRA_RAW" ]] || ! jq -e '
  type == "object"
  and .gate_id == "review"
  and (has("mode") | not)
  and (has("skill") | not)
' >/dev/null 2>&1 <<<"$EXTRA_RAW"; then
  emit_ok
fi

# session ID は CTX_BUDGET_SESSION_ID のみ。CLI / payload / session ファイル fallback はしない。
SESSION_ID="${CTX_BUDGET_SESSION_ID:-}"
if [[ -z "$SESSION_ID" ]] || ! [[ "$SESSION_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
  emit_ok
fi

PROJECT_DIR="${CURSOR_PROJECT_DIR:-$(pwd)}"
SESSION_DIR="$PROJECT_DIR/.cursor/.session"
PROGRESS_LOG="$SESSION_DIR/${SESSION_ID}.progress.jsonl"
if [[ ! -d "$SESSION_DIR" ]]; then
  emit_ok
fi

EXTRA="$(jq -c '
  {gate_id: .gate_id}
  + (if (.campaign != null and .campaign != "") then {campaign: .campaign} else {} end)
  + (if (.pr != null and .pr != "") then {pr: .pr} else {} end)
' <<<"$EXTRA_RAW" 2>/dev/null)" || emit_ok

BYTES="$(LC_ALL=C printf '%s' "$SUMMARY" | wc -c | tr -d '[:space:]')" || BYTES=0
[[ "$BYTES" =~ ^[0-9]+$ ]] || BYTES=0
NOW_ISO="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date +%Y-%m-%dT%H:%M:%S%z)"

EVENT="$(jq -c -n \
  --arg at "$NOW_ISO" \
  --arg session_id "$SESSION_ID" \
  --arg kind "$KIND" \
  --argjson bytes "$BYTES" \
  --arg summary "$SUMMARY" \
  --argjson extra "$EXTRA" \
  '{at: $at, session_id: $session_id, kind: $kind, bytes: $bytes, summary: $summary, extra: $extra}' \
  2>/dev/null)" || EVENT=""

if [[ -n "$EVENT" ]]; then
  LOCK_FILE="$SESSION_DIR/${SESSION_ID}.lock"
  if command -v flock >/dev/null 2>&1; then
    (
      flock -x -w 1 9 || exit 0
      printf '%s\n' "$EVENT" >> "$PROGRESS_LOG" 2>/dev/null || true
    ) 9>"$LOCK_FILE" 2>/dev/null || true
  else
    printf '%s\n' "$EVENT" >> "$PROGRESS_LOG" 2>/dev/null || true
  fi
fi

echo '{}'
exit 0
