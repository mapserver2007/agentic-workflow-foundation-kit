#!/usr/bin/env bash
# session-budget-tracker.sh  [generated by agentic-workflow-foundation skill]
# Cursor beforeSubmitPrompt Hook: state ファイルの prompt_count をインクリメントし、
# チェックポイント間隔（{{framework.budget_thresholds.checkpoint_interval_prompts}} prompts）
# の倍数に達した場合は checkpoint marker を書く。
# 設計: フェイルオープン / 観測のみ（ブロックしない）

set -uo pipefail

INPUT="$(cat 2>/dev/null)" || { echo '{}'; exit 0; }
if ! command -v jq >/dev/null 2>&1; then
  echo '{}'
  exit 0
fi

SESSION_ID="${CTX_BUDGET_SESSION_ID:-}"
if [[ -z "$SESSION_ID" ]]; then
  echo '{}'
  exit 0
fi

if ! [[ "$SESSION_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo '{}'
  exit 0
fi

PROJECT_DIR="${CURSOR_PROJECT_DIR:-$(pwd)}"
STATE_FILE="$PROJECT_DIR/.cursor/.session/${SESSION_ID}.json"

if [[ ! -f "$STATE_FILE" ]]; then
  echo '{}'
  exit 0
fi

CHECKPOINT_INTERVAL={{framework.budget_thresholds.checkpoint_interval_prompts}}

# プロンプト文字数から重み付きスコアを算出（データ収集用 — 閾値判定には未使用）
PROMPT_TEXT="$(jq -r '.user_message // ""' <<<"$INPUT" 2>/dev/null)" || PROMPT_TEXT=""
PROMPT_BYTES=${#PROMPT_TEXT}
if (( PROMPT_BYTES < 100 )); then
  WEIGHT=1
else
  WEIGHT=$(( PROMPT_BYTES / 500 + 1 ))
fi

LOCK_FILE="$PROJECT_DIR/.cursor/.session/${SESSION_ID}.lock"
(
  if command -v flock >/dev/null 2>&1; then
    flock -x 9 || exit 0
  fi
  UPDATED="$(jq --argjson w "$WEIGHT" '.prompt_count = (.prompt_count // 0) + 1 | .weighted_prompt_score = (.weighted_prompt_score // 0) + $w' "$STATE_FILE" 2>/dev/null)" || exit 0
  [[ -n "$UPDATED" ]] || exit 0
  TMP_FILE="$(mktemp "${STATE_FILE}.tmp.XXXXXX" 2>/dev/null)" || exit 0
  printf '%s' "$UPDATED" > "$TMP_FILE" 2>/dev/null && mv "$TMP_FILE" "$STATE_FILE" 2>/dev/null
) 9>"$LOCK_FILE" 2>/dev/null || true

NEW_COUNT="$(jq -r '.prompt_count // 0' "$STATE_FILE" 2>/dev/null)" || NEW_COUNT=0
if [[ "$NEW_COUNT" =~ ^[0-9]+$ ]] && (( NEW_COUNT > 0 && CHECKPOINT_INTERVAL > 0 && NEW_COUNT % CHECKPOINT_INTERVAL == 0 )); then
  MARKER_DIR="$PROJECT_DIR/.cursor/.session"
  printf '%s\n' "$NEW_COUNT" > "$MARKER_DIR/${SESSION_ID}.checkpoint" 2>/dev/null || true
fi

echo '{}'
exit 0
