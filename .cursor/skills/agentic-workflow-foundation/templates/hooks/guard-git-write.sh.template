#!/usr/bin/env bash
# guard-git-write.sh  [generated by agentic-workflow-foundation skill]
# Cursor beforeShellExecution Hook: Git/gh の不可逆操作をブロック / 確認する。
# 仕様: docs/QUALITY_GATE.md §2.1 / .cursor/hooks/README.md
# 設計: deny 対象はフェイルクローズ寄り（判定不能時 ask）/ それ以外はフェイルオープン

set -uo pipefail

# JSON 出力ヘルパ。jq があれば安全にエスケープし、無ければ固定文言で最小 JSON を組む
# （フォールバック用 reason/msg は固定文字列でエスケープ不要）。
emit() { # $1=permission $2=reason $3=agent_message
  if command -v jq >/dev/null 2>&1; then
    jq -n --arg p "$1" --arg reason "$2" --arg msg "$3" \
      '{permission:$p, reason:$reason, agent_message:$msg}'
  else
    printf '{"permission":"%s","reason":"%s","agent_message":"%s"}\n' "$1" "$2" "$3"
  fi
}

# deny クラス（不可逆操作）のフェイルクローズ判定。
# 入力を正常解析できない場合（jq 不在 / JSON 破損 / command 抽出失敗）に生入力へ適用し、
# deny クラスにマッチしたら allow（素通り）ではなく ask を返す（二段階フェイル戦略の deny 側）。
deny_class_failclose() {
  local n
  n="$(printf '%s' "$1" | tr -s '[:space:]' ' ')"
  if [[ "$n" =~ (--force|--force-with-lease) ]] \
     || [[ "$n" =~ git[[:space:]]+push[[:space:]].*--delete ]] \
     || [[ "$n" =~ git[[:space:]]+push[[:space:]].*(main|master|develop|release/) ]] \
     || [[ "$n" =~ git[[:space:]]+reset[[:space:]]+--hard[[:space:]]+(origin|upstream)/ ]] \
     || [[ "$n" =~ gh[[:space:]]+pr[[:space:]]+merge ]] \
     || [[ "$n" =~ gh[[:space:]]+repo[[:space:]]+(delete|archive) ]]; then
    emit "ask" "deny クラスのコマンドが疑われるが入力を正常解析できないためフェイルクローズで承認要求" \
         "Hook が入力を解析できませんでした（jq 不在 / JSON 破損の可能性）。不可逆操作でないことを確認のうえ、ユーザー承認を得てください。"
    exit 0
  fi
}

INPUT="$(cat 2>/dev/null)" || INPUT=""
if [[ -z "$INPUT" ]]; then
  echo '{}'
  exit 0
fi

if ! command -v jq >/dev/null 2>&1; then
  deny_class_failclose "$INPUT"
  echo '{}'
  exit 0
fi

CMD="$(jq -r '.command // empty' <<<"$INPUT" 2>/dev/null)" || CMD=""
if [[ -z "$CMD" ]]; then
  deny_class_failclose "$INPUT"
  echo '{}'
  exit 0
fi

CMD_N="$(echo "$CMD" | tr -s '[:space:]' ' ')"

deny() {
  jq -n --arg reason "$1" --arg msg "$2" \
    '{permission:"deny", reason:$reason, agent_message:$msg}'
  exit 0
}
ask() {
  jq -n --arg reason "$1" --arg msg "$2" \
    '{permission:"ask", reason:$reason, agent_message:$msg}'
  exit 0
}

# ============================================================
# DENY パターン（実行ブロック）
# ============================================================

if [[ "$CMD_N" =~ git[[:space:]]+push.*(--force|--force-with-lease)([[:space:]]|=|$) ]] \
   || [[ "$CMD_N" =~ git[[:space:]]+push.*[[:space:]]-[a-zA-Z]*f([[:space:]]|$) ]]; then
  deny "git push --force 系は履歴破壊リスクのためブロック (AGENTS.md > Boundaries > Never)" \
       "強制プッシュが必要な場合は、ユーザーに直接実行を依頼してください。"
fi

if [[ "$CMD_N" =~ git[[:space:]]+push.*--delete([[:space:]]|$) ]]; then
  deny "git push --delete はリモート参照削除のためブロック" \
       "リモートブランチ/タグ削除はユーザーが直接実行してください。"
fi

if [[ "$CMD_N" =~ git[[:space:]]+push[[:space:]]+((-[a-zA-Z]+|--[a-zA-Z0-9-]+)[[:space:]]+)*[A-Za-z0-9._/-]+[[:space:]]+[+]?(main|master|develop|release/[A-Za-z0-9._/-]+)([[:space:]]|$) ]] \
   || [[ "$CMD_N" =~ git[[:space:]]+push[[:space:]]+((-[a-zA-Z]+|--[a-zA-Z0-9-]+)[[:space:]]+)*[A-Za-z0-9._/-]+[[:space:]]+[+]?[A-Za-z0-9._/-]+:(refs/heads/)?(main|master|develop|release/[A-Za-z0-9._/-]+)([[:space:]]|$) ]]; then
  deny "保護ブランチ (main/master/develop/release/*) への直接 push はブロック (refspec HEAD:main 形式含む)" \
       "PR 経由でマージしてください (gh pr create --base <branch>)。"
fi

if [[ "$CMD_N" =~ git[[:space:]]+push[[:space:]]+((-[a-zA-Z]+|--[a-zA-Z0-9-]+)[[:space:]]+)*[A-Za-z0-9._/-]+[[:space:]]+:(refs/heads/)?(main|master|develop|release/[A-Za-z0-9._/-]+)([[:space:]]|$) ]] \
   || [[ "$CMD_N" =~ git[[:space:]]+push[[:space:]]+((-[a-zA-Z]+|--[a-zA-Z0-9-]+)[[:space:]]+)*[A-Za-z0-9._/-]+[[:space:]]+[+]?refs/heads/(main|master|develop|release/[A-Za-z0-9._/-]+)([[:space:]]|$) ]]; then
  deny "保護ブランチへの refspec 削除 / 素の refs/heads/<protected> 形式はブロック" \
       "保護ブランチの削除・更新が必要な場合は、ユーザーに直接実行を依頼してください。"
fi

if [[ "$CMD_N" =~ git[[:space:]]+reset[[:space:]]+--hard[[:space:]]+(origin|upstream)/ ]]; then
  deny "git reset --hard origin/* はローカル変更の不可逆消失リスクのためブロック" \
       "リモート同期前に git fetch + git diff で内容確認後、ユーザーに依頼してください。"
fi

if [[ "$CMD_N" =~ gh[[:space:]]+pr[[:space:]]+merge([[:space:]]|$) ]]; then
  deny "PR マージは AGENTS.md > Boundaries > Never の対象 (明示指示なし禁止)" \
       "PR マージはユーザーが GitHub UI または手動で実行してください。"
fi

if [[ "$CMD_N" =~ gh[[:space:]]+repo[[:space:]]+(delete|archive)([[:space:]]|$) ]]; then
  deny "gh repo delete/archive は不可逆操作のためブロック" \
       "リポジトリ操作はユーザーが直接実行してください。"
fi

# ============================================================
# ASK パターン（ユーザー承認を強制）
# ============================================================

if [[ "$CMD_N" =~ git[[:space:]]+commit.*--amend([[:space:]]|$) ]]; then
  ask "git commit --amend は既存コミットの改ざん。ユーザー承認を要求" \
      "amend が本当に必要かを確認の上、ユーザー承認を得てください。"
fi

if [[ "$CMD_N" =~ git[[:space:]]+rebase([[:space:]]|$) ]] \
   && [[ ! "$CMD_N" =~ git[[:space:]]+rebase[[:space:]]+--(abort|continue|skip|quit) ]]; then
  ask "git rebase は履歴書き換えのためユーザー承認を要求" \
      "rebase 後に push --force が必要になる場合があります。ユーザー承認を得てください。"
fi

# gh pr / issue のコメント・レビュー投稿（無断投稿防止）
if [[ "$CMD_N" =~ gh[[:space:]]+pr[[:space:]]+(comment|review)([[:space:]]|$) ]] \
   || [[ "$CMD_N" =~ gh[[:space:]]+issue[[:space:]]+comment([[:space:]]|$) ]]; then
  ask "gh pr/issue のコメント・レビュー投稿は無断投稿防止のため承認を要求" \
      "レビュー返信・コメントは agent-code-review 等の承認ループ経由で投稿してください。"
fi

# gh api の書き込み系（--method POST|PATCH|PUT|DELETE / field 系 / --input / replies / graphql mutation）
# 読み取り（--method GET 明示 / mutation を含まない graphql）は除外する。
if [[ "$CMD_N" =~ gh[[:space:]]+api([[:space:]]|$) ]]; then
  if [[ "$CMD_N" =~ (--method|-X)[[:space:]=]+GET ]]; then
    : # 明示 GET は読み取り。素通り
  elif [[ "$CMD_N" =~ graphql ]] && [[ ! "$CMD_N" =~ mutation ]]; then
    : # mutation を含まない graphql は読み取り。素通り
  elif [[ "$CMD_N" =~ (--method|-X)[[:space:]=]+(POST|PATCH|PUT|DELETE) ]] \
       || [[ "$CMD_N" =~ (^|[[:space:]])(-f|-F|--field|--raw-field|--input)([[:space:]]|=) ]] \
       || [[ "$CMD_N" =~ /replies ]] \
       || [[ "$CMD_N" =~ graphql.*mutation ]]; then
    ask "gh api の書き込み系（POST/PATCH/PUT/DELETE / field / --input / replies / graphql mutation）は無断投稿防止のため承認を要求" \
        "コメント・レビュー返信などの書き込みは agent-code-review 等の承認ループ経由で実行してください。"
  fi
fi

# ============================================================
# どれにも該当しない -> 素通り
# ============================================================
echo '{}'
exit 0
