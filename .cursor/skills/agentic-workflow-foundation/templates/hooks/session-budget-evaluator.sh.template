#!/usr/bin/env bash
# session-budget-evaluator.sh  [generated by agentic-workflow-foundation skill]
# Cursor stop Hook: 判定優先順位に従い Yellow / Red を判定し followup_message を返す。
#
# 判定優先順位:
#   1. pending-handoff マーカーあり → token% で Yellow/Red → should_emit bypass で即発火
#   2. state に last_compact_usage_percent あり + 鮮度 OK → token% 優先判定
#   3. token% なし or 鮮度切れ → 従来の proxy OR 判定（elapsed_min / prompt_count / shell_bytes）
#   4. いずれの閾値にも未到達 → checkpoint marker があれば CHECKPOINT followup
#
# チェックポイント marker（{{framework.budget_thresholds.checkpoint_interval_prompts}} prompts 間隔）
# を検出した場合は判断構造の外部化を促す followup_message を返す。
# 仕様: AGENTS.md > Context Budget Protocol / docs/QUALITY_GATE.md / .cursor/hooks/README.md
# 設計: フェイルオープン / 重複通知防止（last_warning_level）/ Yellow/Red が checkpoint に優先
#
# しきい値の SoT: agentic-workflow-foundation manifest.yaml > framework.budget_thresholds。
# 本ファイルは生成物のため直接編集しない。閾値変更は manifest を編集し再生成する。

set -uo pipefail

INPUT="$(cat 2>/dev/null)" || { echo '{}'; exit 0; }
if ! command -v jq >/dev/null 2>&1; then
  echo '{}'
  exit 0
fi

SESSION_ID="${CTX_BUDGET_SESSION_ID:-}"
if [[ -z "$SESSION_ID" ]]; then
  echo '{}'
  exit 0
fi

if ! [[ "$SESSION_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo '{}'
  exit 0
fi

PROJECT_DIR="${CURSOR_PROJECT_DIR:-$(pwd)}"
SESSION_DIR="$PROJECT_DIR/.cursor/.session"
STATE_FILE="$SESSION_DIR/${SESSION_ID}.json"

if [[ ! -f "$STATE_FILE" ]]; then
  echo '{}'
  exit 0
fi

# ---- しきい値（SoT: manifest.yaml > framework.budget_thresholds） ----
THRESHOLDS='{
  "yellow": { "elapsed_min": {{framework.budget_thresholds.yellow.elapsed_min}}, "prompt_count": {{framework.budget_thresholds.yellow.prompt_count}}, "shell_bytes": {{framework.budget_thresholds.yellow.shell_bytes}} },
  "red":    { "elapsed_min": {{framework.budget_thresholds.red.elapsed_min}}, "prompt_count": {{framework.budget_thresholds.red.prompt_count}}, "shell_bytes": {{framework.budget_thresholds.red.shell_bytes}} }
}'
COMPACT_YELLOW_PCT={{framework.budget_thresholds.compact_yellow_percent}}
COMPACT_RED_PCT={{framework.budget_thresholds.compact_red_percent}}
COMPACT_FRESHNESS_SEC={{framework.budget_thresholds.compact_freshness_sec}}
COMPACT_THRASHING_COUNT={{framework.budget_thresholds.compact_thrashing_count}}

NOW_UNIX="$(date +%s)"
STATE="$(cat "$STATE_FILE" 2>/dev/null)" || { echo '{}'; exit 0; }
[[ -z "$STATE" ]] && { echo '{}'; exit 0; }

STARTED="$(jq -r '.started_at_unix // 0' <<<"$STATE" 2>/dev/null)" || STARTED=0
PROMPTS="$(jq -r '.prompt_count // 0' <<<"$STATE" 2>/dev/null)" || PROMPTS=0
SHELL_BYTES="$(jq -r '.shell_bytes // 0' <<<"$STATE" 2>/dev/null)" || SHELL_BYTES=0
LAST_LEVEL="$(jq -r '.last_warning_level // "none"' <<<"$STATE" 2>/dev/null)" || LAST_LEVEL="none"

if ! [[ "$STARTED" =~ ^[0-9]+$ ]] || (( STARTED <= 0 || STARTED > NOW_UNIX )); then
  echo '{}'
  exit 0
fi

if ! [[ "$PROMPTS" =~ ^[0-9]+$ ]] || ! [[ "$SHELL_BYTES" =~ ^[0-9]+$ ]]; then
  echo '{}'
  exit 0
fi

ELAPSED_SEC=$((NOW_UNIX - STARTED))
ELAPSED_MIN=$((ELAPSED_SEC / 60))

# ---- token% 関連の state 読み取り ----
LAST_COMPACT_PCT="$(jq -r '.last_compact_usage_percent // empty' <<<"$STATE" 2>/dev/null)" || LAST_COMPACT_PCT=""
LAST_COMPACT_AT="$(jq -r '.last_compact_at // empty' <<<"$STATE" 2>/dev/null)" || LAST_COMPACT_AT=""
COMPACT_TRIGGER="$(jq -r '.compact_trigger // "unknown"' <<<"$STATE" 2>/dev/null)" || COMPACT_TRIGGER="unknown"

# ---- 判定優先順位 1: pending-handoff マーカー検出 ----
PENDING_FILE="$SESSION_DIR/${SESSION_ID}.pending-handoff"
PENDING_HANDOFF=false
PENDING_PCT=""
if [[ -f "$PENDING_FILE" ]]; then
  PENDING_HANDOFF=true
  PENDING_PCT="$(cat "$PENDING_FILE" 2>/dev/null)" || PENDING_PCT=""
  rm -f "$PENDING_FILE" 2>/dev/null || true
fi

# ---- token% から Yellow/Red レベルを判定する関数 ----
token_level() {
  local pct="$1"
  if [[ -z "$pct" ]] || ! [[ "$pct" =~ ^[0-9]+\.?[0-9]*$ ]]; then
    echo "none"
    return
  fi
  local int_pct="${pct%%.*}"
  if (( int_pct >= COMPACT_RED_PCT )); then
    echo "red"
  elif (( int_pct >= COMPACT_YELLOW_PCT )); then
    echo "yellow"
  else
    echo "none"
  fi
}

# ---- 判定ロジック ----
LEVEL="none"
LEVEL_SOURCE="proxy"

if [[ "$PENDING_HANDOFF" == "true" ]]; then
  # 判定優先順位 1: pending-handoff（compact 直後）→ token% で判定
  LEVEL="$(token_level "${PENDING_PCT:-${LAST_COMPACT_PCT:-}}")"
  LEVEL_SOURCE="compact"
  # compact 直後は最低でも yellow を発火（compact が起きた = コンテキスト限界の証拠）
  if [[ "$LEVEL" == "none" ]]; then
    LEVEL="yellow"
  fi
  # Thrashing 検出: compact 回数が閾値以上なら強制 Red
  COMPACT_COUNT="$(jq -r '.compact_count // 0' <<<"$STATE" 2>/dev/null)" || COMPACT_COUNT=0
  if [[ "$COMPACT_COUNT" =~ ^[0-9]+$ ]] && (( COMPACT_COUNT >= COMPACT_THRASHING_COUNT )); then
    LEVEL="red"
  fi
elif [[ -n "$LAST_COMPACT_PCT" ]] && [[ -n "$LAST_COMPACT_AT" ]] && [[ "$LAST_COMPACT_AT" =~ ^[0-9]+$ ]]; then
  # 判定優先順位 2: state に token% あり + 鮮度チェック
  COMPACT_AGE=$((NOW_UNIX - LAST_COMPACT_AT))
  if (( COMPACT_AGE <= COMPACT_FRESHNESS_SEC )); then
    TOKEN_LEVEL="$(token_level "$LAST_COMPACT_PCT")"
    if [[ "$TOKEN_LEVEL" != "none" ]]; then
      LEVEL="$TOKEN_LEVEL"
      LEVEL_SOURCE="compact"
    fi
  fi
fi

# 判定優先順位 3: token% で判定されなかった場合は proxy OR 判定にフォールバック
if [[ "$LEVEL_SOURCE" == "proxy" ]]; then
  Y_MIN="$(jq -r '.yellow.elapsed_min // 45' <<<"$THRESHOLDS")"
  Y_PROMPT="$(jq -r '.yellow.prompt_count // 45' <<<"$THRESHOLDS")"
  Y_BYTES="$(jq -r '.yellow.shell_bytes // 1048576' <<<"$THRESHOLDS")"
  R_MIN="$(jq -r '.red.elapsed_min // 90' <<<"$THRESHOLDS")"
  R_PROMPT="$(jq -r '.red.prompt_count // 90' <<<"$THRESHOLDS")"
  R_BYTES="$(jq -r '.red.shell_bytes // 5242880' <<<"$THRESHOLDS")"

  if (( ELAPSED_MIN >= R_MIN )) || (( PROMPTS >= R_PROMPT )) || (( SHELL_BYTES >= R_BYTES )); then
    LEVEL="red"
  elif (( ELAPSED_MIN >= Y_MIN )) || (( PROMPTS >= Y_PROMPT )) || (( SHELL_BYTES >= Y_BYTES )); then
    LEVEL="yellow"
  fi
fi

should_emit() {
  local transition="${LAST_LEVEL}_to_${LEVEL}"
  case "$transition" in
    none_to_yellow|none_to_red|yellow_to_red) return 0 ;;
    *) return 1 ;;
  esac
}

# ---- pending-handoff の場合は should_emit を bypass して即発火 ----
if [[ "$PENDING_HANDOFF" == "true" ]] && [[ "$LEVEL" != "none" ]]; then
  # チェックポイント marker を消す
  rm -f "$SESSION_DIR/${SESSION_ID}.checkpoint" 2>/dev/null || true

  # state に last_warning_level を書き込む
  LOCK_FILE="$SESSION_DIR/${SESSION_ID}.lock"
  (
    if command -v flock >/dev/null 2>&1; then
      flock -x 9 || exit 0
    fi
    UPDATED="$(jq --arg lvl "$LEVEL" '.last_warning_level = $lvl' "$STATE_FILE" 2>/dev/null)" || exit 0
    [[ -n "$UPDATED" ]] || exit 0
    TMP_FILE="$(mktemp "${STATE_FILE}.tmp.XXXXXX" 2>/dev/null)" || exit 0
    printf '%s' "$UPDATED" > "$TMP_FILE" 2>/dev/null && mv "$TMP_FILE" "$STATE_FILE" 2>/dev/null
  ) 9>"$LOCK_FILE" 2>/dev/null || true

  COMPACT_PCT="${PENDING_PCT:-${LAST_COMPACT_PCT:-?}}"
  if [[ "$LEVEL" == "red" ]]; then
    MSG="[CONTEXT_BUDGET=RED] コンパクション検出（${COMPACT_TRIGGER}、使用率 ${COMPACT_PCT}%）— 強制ハンドオフ発火。

AI への指示:
1. コンパクションにより会話コンテキストが要約されました。
   序盤の制約・判断が失われている可能性があります。
2. 追跡ドキュメント（.tracking/tracker.md）を Read し、現在のフェーズ・制約を再確認せよ。
3. 追跡ドキュメントの「セッション判断ログ」が最新であることを確認し、
   未反映の判断があれば追記せよ。
4. .cursor/.session/handoff-active.md に以下の見出し順で manifest を書き出す:
   ## ポインタ（追跡ドキュメントの現在位置）
   ## 直近のユーザー依頼
   ## セッション判断ログ
   ### 採用した判断と根拠
   ### 却下した案と却下理由
   ## 制約・ブロッカー・未完了の検証
   ## 次セッションの推奨アクション
   ## 復旧メモ
5. 書き出し後、Read で manifest を読み返し上記見出しが全て存在することを確認せよ。
6. ユーザーに「コンパクションが発生しました（使用率 ${COMPACT_PCT}%）。Red しきい値に到達したため、新規チャット (Cmd+N) を開いて会話を継続してください。」と短く伝える。
7. 新規実装の受理は停止し、次セッションに委譲する。"
  else
    MSG="[CONTEXT_BUDGET=YELLOW] コンパクション検出（${COMPACT_TRIGGER}、使用率 ${COMPACT_PCT}%）。

AI への指示:
1. コンパクションにより会話コンテキストが要約されました。
   序盤の制約・判断が失われている可能性があります。
2. 追跡ドキュメント（.tracking/tracker.md）を Read し、現在のフェーズ・制約を再確認せよ。
3. 追跡ドキュメントの「セッション判断ログ」が最新であることを確認し、
   未反映の判断があれば追記せよ。
4. .cursor/.session/handoff-active.md に manifest を書き出す準備をする。
5. ユーザーに「コンパクションが発生しました（使用率 ${COMPACT_PCT}%）。区切りの良いタイミングで
   新規チャット (Cmd+N) を開くことをお勧めします。」と短く伝える。"
  fi

  jq -n --arg m "$MSG" '{ followup_message: $m }'
  exit 0
fi

# ---- 判定優先順位 4: 通常の should_emit 遷移制御 ----
CHECKPOINT_MARKER="$SESSION_DIR/${SESSION_ID}.checkpoint"

if [[ "$LEVEL" == "none" ]] || ! should_emit; then
  if [[ -f "$CHECKPOINT_MARKER" ]]; then
    CP_COUNT="$(cat "$CHECKPOINT_MARKER" 2>/dev/null)" || CP_COUNT="?"
    rm -f "$CHECKPOINT_MARKER" 2>/dev/null || true
    CP_MSG="[CONTEXT_CHECKPOINT] ${CP_COUNT} prompts 経過（定期チェックポイント）。

AI への指示:
追跡ドキュメント（.tracking/tracker.md）の「セッション判断ログ」を最新化せよ:
1. 現在のフェーズと直近で完了した作業
2. このセッションで採用した判断と根拠（なぜその案を選んだか）
3. 却下した案と却下理由（なぜ採用しなかったか）
4. 現在のブロッカー・制約・未完了の検証

この書き出しは「まだ注意力が高いうちの高品質な記録」として扱う。Yellow/Red 到達時の manifest 作成はこの記録を転記するだけで済む。
この指示は定期チェックポイントであり、セッション切り替えの推奨ではない。作業は継続してよい。ユーザーへの言及は不要（裏作業）。"
    jq -n --arg m "$CP_MSG" '{ followup_message: $m }'
    exit 0
  fi
  echo '{}'
  exit 0
fi

# Yellow/Red 発火時はチェックポイント marker を消す（Yellow/Red が優先）
rm -f "$CHECKPOINT_MARKER" 2>/dev/null || true

LOCK_FILE="$SESSION_DIR/${SESSION_ID}.lock"
(
  if command -v flock >/dev/null 2>&1; then
    flock -x 9 || exit 0
  fi
  UPDATED="$(jq --arg lvl "$LEVEL" '.last_warning_level = $lvl' "$STATE_FILE" 2>/dev/null)" || exit 0
  [[ -n "$UPDATED" ]] || exit 0
  TMP_FILE="$(mktemp "${STATE_FILE}.tmp.XXXXXX" 2>/dev/null)" || exit 0
  printf '%s' "$UPDATED" > "$TMP_FILE" 2>/dev/null && mv "$TMP_FILE" "$STATE_FILE" 2>/dev/null
) 9>"$LOCK_FILE" 2>/dev/null || true

# ---- followup メッセージの判定根拠テキスト ----
if [[ "$LEVEL_SOURCE" == "compact" ]]; then
  TRIGGER_TEXT="コンパクション（${COMPACT_TRIGGER}、使用率 ${LAST_COMPACT_PCT:-?}%）"
else
  TRIGGER_TEXT="経過 ${ELAPSED_MIN}min / ${PROMPTS} prompts"
fi

if [[ "$LEVEL" == "red" ]]; then
  MSG="[CONTEXT_BUDGET=RED] 強制ハンドオフ発火（${TRIGGER_TEXT}）。

AI への指示:
1. 追跡ドキュメント（.tracking/tracker.md）の「次セッションTODO」「セッション判断ログ」を最新化する（tracker.md が SoT）。
2. .cursor/.session/handoff-active.md に以下の見出し順で manifest を書き出す:
   ## ポインタ（追跡ドキュメントの現在位置）
   ## 直近のユーザー依頼
   ## セッション判断ログ
   ### 採用した判断と根拠
   ### 却下した案と却下理由
   ## 制約・ブロッカー・未完了の検証
   ## 次セッションの推奨アクション
   ## 復旧メモ
3. 書き出し後、Read で manifest を読み返し上記見出しが全て存在することを確認せよ。欠落があれば追記してから完了とする。
4. manifest には tracker.md と重複する詳細を書かない。ポインタ（ファイルパス + フェーズ名）で参照し、揮発情報（tracker.md 未反映の判断・直近の依頼）のみ記載する。
5. ユーザーへの応答は次の趣旨だけ短く伝える: 「Red しきい値に到達しました。新規チャット (Cmd+N) を開いて会話を継続してください。前回の作業状態は自動的に引き継がれます。」
6. 新規実装の受理は停止し、次セッションに委譲する。"
else
  MSG="[CONTEXT_BUDGET=YELLOW] ハンドオフ準備推奨（${TRIGGER_TEXT}）。

AI への指示:
1. 追跡ドキュメント（.tracking/tracker.md）の「セッション判断ログ」を最新化する（tracker.md が SoT）。CHECKPOINT で既に書き出した判断ログがあればそれを確認・補完するだけでよい。
2. 追跡ドキュメントの「次セッションTODO」を最新化する。
3. 1-2 ターン以内に作業を区切り、.cursor/.session/handoff-active.md に manifest を書き出す。manifest には tracker.md の判断ログをそのまま転記し、tracker.md 未反映の揮発情報のみ追記する。
4. ユーザーへの応答は次の趣旨だけ短く伝える: 「セッションが長くなってきました。区切りの良いタイミングで新規チャット (Cmd+N) を開いて作業を継続することをお勧めします。」
5. Red 到達時は強制ハンドオフが発火する。"
fi

jq -n --arg m "$MSG" '{ followup_message: $m }'
exit 0
