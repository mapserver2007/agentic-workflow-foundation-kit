#!/usr/bin/env bash
# session-progress-emitter.sh  [generated by agentic-workflow-foundation skill]
# session-* 観測 Hook: 構造化イベントを {session_id}.progress.jsonl に追記する。
# 設計: fail_open / 観測のみ（ブロックしない）

set -uo pipefail

INPUT="$(cat 2>/dev/null)" || { echo '{}'; exit 0; }
if [[ -z "$INPUT" ]] || ! command -v jq >/dev/null 2>&1; then
  echo '{}'
  exit 0
fi
if ! jq -e . >/dev/null 2>&1 <<<"$INPUT"; then
  echo '{}'
  exit 0
fi

# Hook 実行環境から引き継がれた ID を優先する。存在しない場合のみ payload を参照する。
SESSION_ID="${CTX_BUDGET_SESSION_ID:-}"
if [[ -z "$SESSION_ID" ]]; then
  SESSION_ID="$(jq -r '.session_id // .conversation_id // empty' <<<"$INPUT" 2>/dev/null)" || SESSION_ID=""
fi
if [[ -z "$SESSION_ID" ]] || ! [[ "$SESSION_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo '{}'
  exit 0
fi

PROJECT_DIR="${CURSOR_PROJECT_DIR:-$(pwd)}"
SESSION_DIR="$PROJECT_DIR/.cursor/.session"
PROGRESS_LOG="$SESSION_DIR/${SESSION_ID}.progress.jsonl"
if [[ ! -d "$SESSION_DIR" ]]; then
  echo '{}'
  exit 0
fi

HOOK_EVENT="$(jq -r '.hook_event_name // empty' <<<"$INPUT" 2>/dev/null)" || HOOK_EVENT=""
case "$HOOK_EVENT" in
  subagentStart) KIND="subagent_start" ;;
  subagentStop) KIND="subagent_stop" ;;
  afterAgentThought) KIND="thought" ;;
  afterAgentResponse) KIND="response" ;;
  afterShellExecution) KIND="shell" ;;
  beforeSubmitPrompt) KIND="prompt" ;;
  *)
    if [[ "$(jq -r '.prompt // empty' <<<"$INPUT" 2>/dev/null)" != "" ]]; then
      KIND="prompt"
    else
      echo '{}'
      exit 0
    fi
    ;;
esac

SUMMARY="$(jq -r --arg kind "$KIND" '
  if $kind == "prompt" then .prompt // ""
  elif $kind == "shell" then .command // .input // .output // ""
  elif $kind == "subagent_start" or $kind == "subagent_stop" then .task // .text // ""
  else .text // .response // ""
  end
  | if type == "string" then . else tostring end
' <<<"$INPUT" 2>/dev/null)" || SUMMARY=""
SUMMARY="$(printf '%.1000s' "$SUMMARY")"
BYTES="$(LC_ALL=C printf '%s' "$SUMMARY" | wc -c | tr -d '[:space:]')" || BYTES=0
[[ "$BYTES" =~ ^[0-9]+$ ]] || BYTES=0
NOW_ISO="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date +%Y-%m-%dT%H:%M:%S%z)"

EXTRA="$(jq -c --arg kind "$KIND" '
  def present($key): if .[$key] == null then {} else {($key): .[$key]} end;
  (present("model") + present("model_id") + present("model_params") + present("hook_event_name"))
  + if $kind == "subagent_start" then
      present("subagent_id") + present("subagent_type") + present("subagent_model")
      + present("task") + present("description")
    elif $kind == "subagent_stop" then
      present("subagent_id") + present("subagent_type") + present("status")
      + present("duration_ms") + present("task") + present("description")
    else {}
    end
' <<<"$INPUT" 2>/dev/null)" || { echo '{}'; exit 0; }

jq -c -n \
  --arg at "$NOW_ISO" \
  --arg session_id "$SESSION_ID" \
  --arg kind "$KIND" \
  --argjson bytes "$BYTES" \
  --arg summary "$SUMMARY" \
  --argjson extra "$EXTRA" \
  '{at: $at, session_id: $session_id, kind: $kind, bytes: $bytes, summary: $summary, extra: $extra}' \
  >> "$PROGRESS_LOG" 2>/dev/null || true

echo '{}'
exit 0
