#!/usr/bin/env bash
# session-shell-tracker.sh  [generated by agentic-workflow-foundation skill]
# Cursor afterShellExecution Hook: state ファイルの shell_bytes に
# 直近のシェル実行 stdout 長を加算する（proxy 指標強化）。
# 設計: フェイルオープン / 観測のみ

set -uo pipefail

HOOK_DIR="${BASH_SOURCE[0]%/*}"
[[ "$HOOK_DIR" == "${BASH_SOURCE[0]}" ]] && HOOK_DIR="."
BYTE_HELPER="$HOOK_DIR/session-byte-count.sh"
if [[ ! -r "$BYTE_HELPER" ]] || ! source "$BYTE_HELPER"; then
  echo '{}'
  exit 0
fi

INPUT="$(cat 2>/dev/null)" || { echo '{}'; exit 0; }
if [[ -z "$INPUT" ]]; then
  echo '{}'
  exit 0
fi
if ! command -v jq >/dev/null 2>&1; then
  echo '{}'
  exit 0
fi

SESSION_ID="${CTX_BUDGET_SESSION_ID:-}"
if [[ -z "$SESSION_ID" ]]; then
  echo '{}'
  exit 0
fi

if ! [[ "$SESSION_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo '{}'
  exit 0
fi

PROJECT_DIR="${CURSOR_PROJECT_DIR:-$(pwd)}"
STATE_FILE="$PROJECT_DIR/.cursor/.session/${SESSION_ID}.json"

if [[ ! -f "$STATE_FILE" ]]; then
  echo '{}'
  exit 0
fi

BYTE_SENTINEL="__SESSION_BYTE_COUNT_END__"
json_field() {
  local field="$1"
  jq -j --arg field "$field" --arg sentinel "$BYTE_SENTINEL" '
    (if .[$field] == null then ""
     elif (.[$field] | type) == "string" then .[$field]
     else (.[$field] | tostring)
     end), $sentinel
  ' <<<"$INPUT" 2>/dev/null
}

STDOUT_VALUE="$(json_field stdout)" || {
  echo '{}'
  exit 0
}
STDOUT_VALUE="${STDOUT_VALUE%$BYTE_SENTINEL}"
OUTPUT_VALUE="$(json_field output)" || {
  echo '{}'
  exit 0
}
OUTPUT_VALUE="${OUTPUT_VALUE%$BYTE_SENTINEL}"
RESULT_VALUE="$(json_field result)" || {
  echo '{}'
  exit 0
}
RESULT_VALUE="${RESULT_VALUE%$BYTE_SENTINEL}"

BYTES=0
for VALUE in "$STDOUT_VALUE" "$OUTPUT_VALUE" "$RESULT_VALUE"; do
  VALUE_BYTES="$(session_byte_count "$VALUE")" || {
    echo '{}'
    exit 0
  }
  if ! [[ "$VALUE_BYTES" =~ ^[0-9]+$ ]]; then
    echo '{}'
    exit 0
  fi
  BYTES=$((BYTES + VALUE_BYTES))
done

LOCK_FILE="$PROJECT_DIR/.cursor/.session/${SESSION_ID}.lock"
(
  if command -v flock >/dev/null 2>&1; then
    flock -x 9 || exit 0
  fi
  UPDATED="$(jq --argjson b "$BYTES" '.shell_bytes = (.shell_bytes // 0) + $b' "$STATE_FILE" 2>/dev/null)" || exit 0
  [[ -n "$UPDATED" ]] || exit 0
  TMP_FILE="$(mktemp "${STATE_FILE}.tmp.XXXXXX" 2>/dev/null)" || exit 0
  printf '%s' "$UPDATED" > "$TMP_FILE" 2>/dev/null && mv "$TMP_FILE" "$STATE_FILE" 2>/dev/null
) 9>"$LOCK_FILE" 2>/dev/null || true

echo '{}'
exit 0
