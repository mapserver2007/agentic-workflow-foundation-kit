#!/usr/bin/env bash
# session-response-tracker.sh  [generated by agentic-workflow-foundation skill]
# Cursor afterAgentResponse / afterAgentThought Hook:
# AI 応答テキスト / thinking テキストの先頭 1000 bytes を turns.jsonl に追記する。
# ゼロコスト会話ログ — AI のコンテキスト消費なし、Hook のファイル操作のみ。
# 設計: フェイルオープン / 観測のみ（ブロックしない）

set -uo pipefail

INPUT="$(cat 2>/dev/null)" || { echo '{}'; exit 0; }
if ! command -v jq >/dev/null 2>&1; then
  echo '{}'
  exit 0
fi

SESSION_ID="${CTX_BUDGET_SESSION_ID:-}"
if [[ -z "$SESSION_ID" ]]; then
  echo '{}'
  exit 0
fi

if ! [[ "$SESSION_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo '{}'
  exit 0
fi

PROJECT_DIR="${CURSOR_PROJECT_DIR:-$(pwd)}"
SESSION_DIR="$PROJECT_DIR/.cursor/.session"
TURNS_LOG="$SESSION_DIR/${SESSION_ID}.turns.jsonl"

if [[ ! -d "$SESSION_DIR" ]]; then
  echo '{}'
  exit 0
fi

TEXT="$(jq -r '.text // ""' <<<"$INPUT" 2>/dev/null)" || TEXT=""
if [[ -z "$TEXT" ]]; then
  echo '{}'
  exit 0
fi

# afterAgentThought は duration_ms を含む。その有無で turn_type を区別する。
DURATION_MS="$(jq -r '.duration_ms // empty' <<<"$INPUT" 2>/dev/null)" || DURATION_MS=""
if [[ -n "$DURATION_MS" ]]; then
  TURN_TYPE="thought"
else
  TURN_TYPE="response"
fi

NOW_ISO="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date +%Y-%m-%dT%H:%M:%S%z)"
TEXT_BYTES=${#TEXT}

# 先頭 1000 bytes に切り詰め
SUMMARY="$(printf '%.1000s' "$TEXT")"

jq -c -n \
  --arg type "$TURN_TYPE" \
  --argjson bytes "$TEXT_BYTES" \
  --arg summary "$SUMMARY" \
  --arg at "$NOW_ISO" \
  '{turn_type: $type, bytes: $bytes, summary: $summary, at: $at}' \
  >> "$TURNS_LOG" 2>/dev/null || true

echo '{}'
exit 0
