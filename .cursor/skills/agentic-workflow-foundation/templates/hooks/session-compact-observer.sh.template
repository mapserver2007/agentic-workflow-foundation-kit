#!/usr/bin/env bash
# session-compact-observer.sh  [generated by agentic-workflow-foundation skill]
# Cursor preCompact Hook: コンパクション直前に実トークン使用率を記録し、
# pending-handoff マーカーを書いて次の stop Hook で handoff を発火させる。
# compact-events.jsonl に校正データを追記する。
# 仕様: AGENTS.md > Context Budget Protocol / docs/session-handoff-guide.md / .cursor/hooks/README.md
# 設計: フェイルオープン / 観測専用（preCompact は followup_message を返せない）
#
# しきい値の SoT: agentic-workflow-foundation manifest.yaml > framework.budget_thresholds。
# 本ファイルは生成物のため直接編集しない。変更は manifest を編集し再生成する。

set -uo pipefail

INPUT="$(cat 2>/dev/null)" || { echo '{}'; exit 0; }
if ! command -v jq >/dev/null 2>&1; then
  echo '{}'
  exit 0
fi

SESSION_ID="${CTX_BUDGET_SESSION_ID:-}"
if [[ -z "$SESSION_ID" ]]; then
  echo '{}'
  exit 0
fi

if ! [[ "$SESSION_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo '{}'
  exit 0
fi

PROJECT_DIR="${CURSOR_PROJECT_DIR:-$(pwd)}"
SESSION_DIR="$PROJECT_DIR/.cursor/.session"
STATE_FILE="$SESSION_DIR/${SESSION_ID}.json"

if [[ ! -f "$STATE_FILE" ]]; then
  echo '{}'
  exit 0
fi

# ---- stdin から preCompact イベントデータを取得 ----
USAGE_PCT="$(jq -r '.context_usage_percent // empty' <<<"$INPUT" 2>/dev/null)" || USAGE_PCT=""
CONTEXT_TOKENS="$(jq -r '.context_tokens // empty' <<<"$INPUT" 2>/dev/null)" || CONTEXT_TOKENS=""
CONTEXT_WINDOW="$(jq -r '.context_window_size // empty' <<<"$INPUT" 2>/dev/null)" || CONTEXT_WINDOW=""
TRIGGER="$(jq -r '.trigger // "unknown"' <<<"$INPUT" 2>/dev/null)" || TRIGGER="unknown"
MSG_COUNT="$(jq -r '.message_count // empty' <<<"$INPUT" 2>/dev/null)" || MSG_COUNT=""
IS_FIRST="$(jq -r '.is_first_compaction // false' <<<"$INPUT" 2>/dev/null)" || IS_FIRST="false"

if [[ -z "$USAGE_PCT" ]]; then
  echo '{}'
  exit 0
fi

NOW_UNIX="$(date +%s)"
NOW_ISO="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date +%Y-%m-%dT%H:%M:%S%z)"

# ---- 1. state ファイルに compact 情報を書き込む ----
LOCK_FILE="$SESSION_DIR/${SESSION_ID}.lock"
(
  if command -v flock >/dev/null 2>&1; then
    flock -x 9 || exit 0
  fi
  UPDATED="$(jq \
    --argjson pct "$USAGE_PCT" \
    --argjson at "$NOW_UNIX" \
    --arg trig "$TRIGGER" \
    '.last_compact_usage_percent = $pct
     | .last_compact_at = $at
     | .compact_trigger = $trig
     | .compact_count = ((.compact_count // 0) + 1)' \
    "$STATE_FILE" 2>/dev/null)" || exit 0
  [[ -n "$UPDATED" ]] || exit 0
  TMP_FILE="$(mktemp "${STATE_FILE}.tmp.XXXXXX" 2>/dev/null)" || exit 0
  printf '%s' "$UPDATED" > "$TMP_FILE" 2>/dev/null && mv "$TMP_FILE" "$STATE_FILE" 2>/dev/null
) 9>"$LOCK_FILE" 2>/dev/null || true

# ---- 2. compact-events.jsonl に校正データを追記 ----
EVENTS_FILE="$SESSION_DIR/compact-events.jsonl"
PROMPT_COUNT="$(jq -r '.prompt_count // 0' "$STATE_FILE" 2>/dev/null)" || PROMPT_COUNT=0
SHELL_BYTES="$(jq -r '.shell_bytes // 0' "$STATE_FILE" 2>/dev/null)" || SHELL_BYTES=0
jq -c -n \
  --arg sid "$SESSION_ID" \
  --arg trig "$TRIGGER" \
  --argjson pct "$USAGE_PCT" \
  --argjson tokens "${CONTEXT_TOKENS:-null}" \
  --argjson window "${CONTEXT_WINDOW:-null}" \
  --argjson msg_count "${MSG_COUNT:-null}" \
  --argjson is_first "$IS_FIRST" \
  --argjson prompt_count "$PROMPT_COUNT" \
  --argjson shell_bytes "$SHELL_BYTES" \
  --arg at "$NOW_ISO" \
  '{
    session_id: $sid,
    trigger: $trig,
    context_usage_percent: $pct,
    context_tokens: $tokens,
    context_window_size: $window,
    message_count: $msg_count,
    is_first_compaction: $is_first,
    prompt_count: $prompt_count,
    shell_bytes: $shell_bytes,
    observed_at: $at
  }' >> "$EVENTS_FILE" 2>/dev/null || true

# ---- 3. pending-handoff マーカーを書く ----
PENDING_FILE="$SESSION_DIR/${SESSION_ID}.pending-handoff"
printf '%s\n' "$USAGE_PCT" > "$PENDING_FILE" 2>/dev/null || true

# ---- 3.5. tracker.md が存在しなければ最小骨格を生成 ----
TRACKER="$PROJECT_DIR/{{project.tracking_artifact}}"
if [[ ! -f "$TRACKER" ]]; then
  mkdir -p "$(dirname "$TRACKER")" 2>/dev/null || true
  cat > "$TRACKER" 2>/dev/null <<'TRACKER_SKEL'
# 追跡ドキュメント（自動生成骨格）

## 現在のフェーズ
<!-- TODO: AI が記入 -->

## セッション判断ログ
### 採用した判断と根拠
### 却下した案と却下理由

## ブロッカー・制約
<!-- なし -->

## 次セッションTODO
<!-- TODO: AI が記入 -->

## 完了チェック
- [ ] <!-- TODO: AI が記入 -->
TRACKER_SKEL
fi

# ---- 4. tracker.md のスナップショットを自動退避 ----
MAX_SNAPSHOT_BYTES={{framework.budget_thresholds.max_snapshot_bytes}}
SNAPSHOT="$SESSION_DIR/pre-compact-${SESSION_ID}.md"
if [[ -f "$TRACKER" ]]; then
  head -c "${MAX_SNAPSHOT_BYTES}" "$TRACKER" > "$SNAPSHOT" 2>/dev/null || true
fi

# ---- 5. user_message でユーザーに compact 発生を通知 ----
USER_MSG="コンパクションが発生しました（${TRIGGER}、使用率 ${USAGE_PCT}%）。次の応答完了時に handoff 準備が自動的に行われます。"

jq -n --arg m "$USER_MSG" '{ user_message: $m }'
exit 0

# ---- Phase 2: preCompact で followup_message が使える場合 ----
# Cursor API が preCompact の返り値に followup_message / additional_context を
# サポートした場合、以下のコメントを解除して有効化する。
# これにより compact 直前に AI へ handoff 作業を指示でき、
# pending-handoff パターン（事後復旧）から事前退避に移行できる。
#
# FOLLOWUP_MSG="[CONTEXT_BUDGET=COMPACT_PREP] compact 直前。tracker を更新せよ。"
# jq -n --arg m "$FOLLOWUP_MSG" --arg u "$USER_MSG" \
#   '{ followup_message: $m, user_message: $u }'
# exit 0
